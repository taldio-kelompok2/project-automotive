@inject IRentalCartService Cart
@inject NavigationManager Nav
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject UserContextService UserContext
@inject ICourseBookingService CourseBookingService

@page "/checkout"
@using AutomotiveApp.BlazorUI.Helper

@rendermode InteractiveServer
@layout MainLayout

<section class="checkout-container">
    @if (Cart.RentalCartItems != null && Cart.RentalCartItems.Any())
    {
        <!-- large screen header -->
        <div class="checkout-header fluid d-none d-md-flex">
            <MudStack Row=true Spacing="1" AlignItems="AlignItems.Center">
                <MudCheckBox @bind-Value="Cart.SelectedAll" T="bool" Disabled="@Cart.IsCartEmpty" />
                <MudText Typo="Typo.h6">Pilih Semua</MudText>
            </MudStack>
            <AppBaseButton Variant="Variant.Outlined" Color="Color.Primary" Width="ButtonWidth.Short" @onclick="DeleteAll">
                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-1" /> Delete All
            </AppBaseButton>
        </div>
        <!-- small-medium screen header -->
        <div class="checkout-header fluid d-flex d-md-none">
            <MudStack Row=true Spacing="1" AlignItems="AlignItems.Center">
                <MudCheckBox @bind-Value="Cart.SelectedAll" T="bool" Disabled="@Cart.IsCartEmpty" />
                <MudText Typo="Typo.body2">Pilih Semua</MudText>
            </MudStack>
            <AppBaseButton Variant="Variant.Outlined" Color="Color.Primary" Width="ButtonWidth.Short" @onclick="DeleteAll">
                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-1" /> Delete All
            </AppBaseButton>
        </div>
        <div class="checkout-seperator" />
        <MudStack Spacing="4" Class="fluid" AlignItems="AlignItems.Baseline" Justify="Justify.FlexStart">
            @foreach (var cart in Cart.RentalCartItems)
            {
                <div class="rental-cart-group fluid " @key="cart.Item.Id">
                    <MudStack Spacing="4" Row=true AlignItems="AlignItems.Center">
                        <MudCheckBox @bind-Value="cart.Selected" T="bool" Disabled="@Cart.IsCartEmpty" />
                        <!-- large Image -->
                        <MudImage Src="@cart.Item.Course.ImageUrl" Class="d-none d-md-block" Width="200" Height="200"
                            ObjectFit="ObjectFit.Contain" />
                        <!-- small-medium Image -->
                        <MudImage Src="@cart.Item.Course.ImageUrl" Class="d-block d-md-none" Width="100" Height="100"
                            ObjectFit="ObjectFit.Contain" />
                        <!-- large content screen -->
                        <div class="rental-cart-content d-none d-md-block">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@cart.Item.Course.Category</MudText>
                            <MudText Typo="Typo.h5">@cart.Item.Course.Name</MudText>
                            <MudText Typo="Typo.body2">Schedule: @cart.Item.Schedule.ToString("dddd, dd MMMM yyyy", new
                                                        System.Globalization.CultureInfo("en-US"))</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary" style="font-weight:600">
                        IDR @cart.Item.Course.Price.ToString("N0")
                    </MudText>
                </div>
                <!-- small-medium content screen -->
                <div class="d-flex flex-column flex-grow-1 d-md-none text-truncate">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@cart.Item.Course.Category</MudText>
                    <div class="row">
                        <div class="text-truncate">
                            @cart.Item.Course.Name
                        </div>
                    </div>
                    <MudText Typo="Typo.caption">@cart.Item.Schedule.ToString("ddd, dd-MM-yy", new
                                                System.Globalization.CultureInfo("en-US"))</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary" style="font-weight:600">
                        IDR @cart.Item.Course.Price.ToString("N0")
                    </MudText>
                </div>
                <!-- large screen Icon -->
                <MudIconButton Class="d-none d-md-block" Icon="@Icons.Material.Rounded.DeleteForever"
                    Variant="Variant.Text" Color="Color.Error" Size="Size.Large" @onclick="() => RemoveItem(cart)" />
                <!-- small-medium screen Icon -->
                <MudIconButton Class="d-block d-md-none" Icon="@Icons.Material.Rounded.DeleteForever"
                    Variant="Variant.Text" Color="Color.Error" Size="Size.Medium" @onclick="() => RemoveItem(cart)" />
            </MudStack>
            <div class="checkout-seperator" />
        </div>
                }
        </MudStack>
    }
    else
    {
        <div class="empty-cart-container d-none d-md-flex">
            @if (_isLoading)
            {
                <div class="loading-overlay">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Loading your cart...</MudText>
                </div>
            }
            else if (Cart.RentalCartItems?.Count == 0 && !_isLoading)
            {
                <MudImage Src="Images/Cart/emptyCart.svg" Width="250" Height="250"></MudImage>
                <MudText Typo="Typo.h4" Color="Color.Primary">Cart is empty..</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Start browsing to find your perfect rental
                </MudText>
                <AppBaseButton Width="ButtonWidth.Short" Variant="Variant.Outlined" Color="Color.Primary"
                    @onclick="() => Nav.NavigateTo(HOME_PAGE)">Browse
                </AppBaseButton>
            }
        </div>

        <div class="empty-cart-container d-flex d-md-none">
            @if (_isLoading)
            {
                <div class="loading-overlay">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">Loading your cart...</MudText>
                </div>
            }
            else if (Cart.RentalCartItems?.Count == 0 && !_isLoading)
            {
                <MudImage Src="Images/Cart/emptyCart.svg" Width="150" Height="150"></MudImage>
                <MudText Typo="Typo.h5" Color="Color.Primary">Cart is empty..</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Start browsing to find your perfect rental
                </MudText>
                <AppBaseButton Width="ButtonWidth.Short" Variant="Variant.Outlined" Color="Color.Primary"
                    @onclick="() => Nav.NavigateTo(HOME_PAGE)">Browse
                </AppBaseButton>
            }
        </div>
    }
</section>


<section class="checkout-actions fluid">
    <MudStack Spacing="4" Row=true AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="3" Row=true AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Total Price</MudText>
            <!-- large screen price -->
            <div class="d-none d-md-block">
                <MudText Typo="Typo.h5" style="font-weight:600" Color="Color.Primary">IDR
                    @Cart.TotalPrice.ToString("N0")
                </MudText>
            </div>
            <!-- small screen price -->
            <div class="d-md-none d-block">
                <MudText Typo="Typo.body1" style="font-weight:600" Color="Color.Primary">IDR
                    @Cart.TotalPrice.ToString("N0")
                </MudText>
            </div>
        </MudStack>
        <!-- large screen button -->
        <div class="d-none d-md-block">
            <AppBaseButton ButtonType="@ButtonType.Submit" Color="@Color.Primary" Variant="@Variant.Filled"
                Width="@ButtonWidth.Long" @onclick="PaymentHandler" Disabled="@(Cart.TotalPrice == 0)">Pay Now
            </AppBaseButton>
        </div>
        <!-- small screen button -->
        <div class="d-md-none d-flex">
            <AppBaseButton ButtonType="@ButtonType.Submit" Color="@Color.Primary" Variant="@Variant.Filled"
                Width="@ButtonWidth.Medium" @onclick="PaymentHandler" Disabled="@(Cart.TotalPrice == 0)">
                <MudText Typo="Typo.caption">Pay Now</MudText>
            </AppBaseButton>
        </div>
    </MudStack>
</section>

@code {
    private List<CourseBookingQueryDto> _userSessions = new();
    private const string HOME_PAGE = "/";
    private bool _isLoading { get; set; } = true;
    private async void RemoveItem(RentalCartItemViewModel item)
    {
        if (!await Cart.RemoveItemAsync(item.Item.SessionId))
        {
            Snackbar.Add("Failed to delete item on the cart", Severity.Error);
            StateHasChanged();
        }
        else
            Snackbar.Add($"items succesfully removed", Severity.Info);
    }

    private async void DeleteAll()
    {
        await Cart.ClearAllAsync();
        Snackbar.Add($"Cart is Cleared", Severity.Info);
    }

    private async Task<bool?> OpenDuplicateDialogAsync(Dictionary<string, DateTime> bookings, Dictionary<string, DateTime>
    carts)
    {
        var parameters = new DialogParameters
{
{ "ExistingBookings", bookings },
{ "ExistingCartBookings", carts }
};

        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await Dialog.ShowAsync<DuplicateScheduleDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result!.Canceled) return false;
        if (!result.Canceled && result.Data is bool continueWithTransaction && continueWithTransaction)
            return await OpenTransactionDialogAsync();

        return false;
    }

    private async Task PaymentHandler()
    {
        try
        {
            var cartDuplicates = Cart.RentalCartItems
            .Where(c => c.Selected)
            .GroupBy(cart => cart.Item.Schedule.Date)
            .Where(group => group.Count() >= 2)
            .SelectMany(group => group)
            .GroupBy(x => x.Item.Course.Name)
            .Select(g => g.First())
            .ToDictionary(
            x => x.Item.Course.Name,
            x => x.Item.Schedule.Date
            );

            var SessionDuplicates = Cart.RentalCartItems
            .Where(cart =>
            cart.Selected &&
            _userSessions.Any(user => user.Session.Date.Date == cart.Item.Schedule.Date.Date))
            .ToDictionary(x => x.Item.Course.Name, x => x.Item.Schedule.Date);
            bool success;

            if (cartDuplicates.Any() || SessionDuplicates.Any())
            {
                success = await OpenDuplicateDialogAsync(SessionDuplicates, cartDuplicates) ?? false;
            }
            else
                success = await OpenTransactionDialogAsync();

            if (success)
            {
                Snackbar.Add("Payment successful, Redirecting now..", Severity.Success,
                config =>
                {
                    config.VisibleStateDuration = 1000;
                });
                await Task.Delay(500);
                Nav.NavigateTo("/success-purchase");
            }
            else
            {
                @* Snackbar.Add("Payment Not Successful", Severity.Warning); *@
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<bool> OpenTransactionDialogAsync()
    {
        var parameters = new DialogParameters
        {
            ["OnSubmit"] = EventCallback.Factory.Create<TransactionViewModel>(this, HandleDialogSubmit)
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialogRef = await Dialog.ShowAsync<TransactionDialog>("Select Payment Method", parameters, options);
        var transactionResult = await dialogRef.Result;

        return !transactionResult?.Canceled! ?? false;
    }

    private async Task HandleDialogSubmit(TransactionViewModel transaction)
    {
        await Cart.FinalizePaymentAsync(transaction.Id);

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCartDataAsync();

            if (UserContext.Current.IsAuthenticated)
            {
                await LoadBookingDataAsync();
            }
            StateHasChanged();
        }
    }

    private async Task LoadCartDataAsync()
    {
        await RetryHelper.ExecuteWithRetryAsync(
        action: () => Cart.GetUserCartData(),
        onLoadingChanged: (loading) => _isLoading = loading,
        maxAttempts: 5,
        delayMs: 100
        );
    }

    private async Task LoadBookingDataAsync()
    {
        var bookingResponse = await CourseBookingService.GetUserBooking();
        if (bookingResponse.Success)
        {
            _userSessions = bookingResponse.Data?.ToList() ?? [];
        }
    }




    protected override void OnInitialized()
    {
        Cart.OnCartChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Cart.OnCartChanged -= StateHasChanged;
    }
}