<Footer />

@code {
    [Parameter]
    public string? Category { get; set; }

    private List<CarViewModel> allCars = new List<CarViewModel>();
    private List<CarViewModel> cars = new List<CarViewModel>();


    private readonly Random _random = new();

    private string HeroImage => Category?.ToLower() switch
    {
        "electric" => "images/CourseMenu/Hero-Electric.svg",
        "hatchback" => "images/CourseMenu/Hero-Hatchback.svg",
        "lcgc" => "images/CourseMenu/Hero-LCGC.svg",
        "offroad" => "images/CourseMenu/Hero-Offroad.svg",
        "truck" => "images/CourseMenu/Hero-Truck.svg",
        "suv" => "images/CourseMenu/Hero-SUV.svg",
        "mpv" => "images/CourseMenu/Hero-MPV.svg",
        "sedan" => "images/CourseMenu/Hero-Sedan.svg",
        _ => "images/CourseMenu/Hero-SUV.svg"
    };
    private string CategoryTitle => Category?.ToLower() switch
    {
        "electric" => "Electric",
        "hatchback" => "Hatchback",
        "lcgc" => "LCGC",
        "offroad" => "Offroad",
        "truck" => "Truck",
        "suv" => "SUV",
        "mpv" => "MPV",
        "sedan" => "Sedan",
        _ => "SUV"
    };


    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(200);
        CarViewModel.InitDummyData(allCars);

        if (!string.IsNullOrEmpty(Category))
            cars = allCars
                .Where(c => string.IsNullOrEmpty(Category) ||
                            c.Category.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase))
                .OrderBy(_ => _random.Next())
                .Take(6)
                .ToList();
        else
            cars = allCars;
    }

    protected override Task OnParametersSetAsync()
    {
        if (allCars is null)
            return Task.CompletedTask;

        cars = string.IsNullOrEmpty(Category)
            ? allCars
            : allCars
                .Where(c => string.IsNullOrEmpty(Category) ||
                            c.Category.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase))
                .OrderBy(_ => _random.Next())
                .Take(6)
                .ToList();

        return Task.CompletedTask;
    }

    private void NavigateToCourseDetail(string courseTitle)
    {
        string normalizedTitle = courseTitle.Replace(" ", "-").ToLowerInvariant();
        Navigation.NavigateTo($"/{Category}/{normalizedTitle}");
    }
}
