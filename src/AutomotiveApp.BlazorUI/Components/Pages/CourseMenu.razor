<MudStack Class="p-4 p-sm-5 my-2" Style="border-bottom: 1px solid #E0E0E0;">
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudText Typo="Typo.h4" Class="text-black mx-4 px-4 mt-1" Align="Align.Left" Style="font-weight: 600;">
            @CategoryTitle
        </MudText>
        <MudText Typo="Typo.subtitle1" Class="text-black mx-4 px-4 mb-5 pt-2 pb-3"
                 Style="text-align: justify; line-height: 1.5;">
            @CategoryDescription
        </MudText>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudText Typo="Typo.h4" Class="text-black mt-1" Align="Align.Left" Style="font-weight: 600;">
            @CategoryTitle
        </MudText>
        <MudText Typo="Typo.subtitle1" Class="text-black pt-2 pb-3"
                 Style="text-align: justify; line-height: 1.5;">
            @CategoryDescription
        </MudText>
    </MudHidden>
</MudStack>


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4" Style="background-color: white">
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary"
            Class="mt-6 mb-16 pb-4 pt-3 align-content-center" Style="font-weight: 600;">Another favorite course
        </MudText>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary"
            Class="mt-6 mb-10 pb-4 pt-3 align-content-center" Style="font-weight: 600;">Another favorite course
        </MudText>
    </MudHidden>
    <!-- Courses card -->
    <MudGrid Spacing="6" Class="px-2 pb-8 mb-16">
        @if (cars.Data?.Items.Any() ?? false)
        {
            @foreach (var car in cars.Data.Items)
            {
                <MudItem xs="12" sm="6" md="4">
                    <CarCard Car="car" />
                </MudItem>
            }
        }
    </MudGrid>

</MudContainer>

<Footer />

@code {
    [Parameter] public Guid id { get; set; }

    private ApiResponse<PaginatedResult<CourseQueryDto>> cars = new();

    private Guid? _categoryId;
    private string CategoryTitle = "";        
    private string HeroImage = "images/CourseMenu/Hero-SUV.svg"; 
    private string CategoryDescription = "";  

    // --- Another Course ---
    private const int PageSize = 6;
    private int page = 1;
    private int totalPages;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        page = 1;
        await LoadCategoryAsync();
        await LoadCoursesAsync(page);
    }

    protected override async Task OnParametersSetAsync()
    {
        page = 1;
        await LoadCategoryAsync();
        await LoadCoursesAsync(page);
    }

    private async Task LoadCoursesAsync(int p)
    {
        isLoading = true;
        try
        {
            var res = await CourseService.GetPaged(p, PageSize);

            cars = res ?? new ApiResponse<PaginatedResult<CourseQueryDto>>
            {
                Success = true,
                Data = new PaginatedResult<CourseQueryDto>(Enumerable.Empty<CourseQueryDto>(), 0)
            };

            totalPages = cars.Data is null
                ? 0
                : (int)Math.Ceiling((double)cars.Data.TotalCount / PageSize);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPageChanged(int newPage)
    {
        page = newPage;
        await LoadCoursesAsync(page);
    }

    private async Task LoadCategoryAsync()
    {
        var all = await CategorySvc.GetAllAsync();
        var cat = all.FirstOrDefault(c => c.Id == id);
        if (cat is null)
        {
            CategoryTitle = "Course";
            HeroImage = "images/CourseMenu/Hero-SUV.svg";
            return;
        }

        CategoryTitle = cat.Name ?? "";
        CategoryDescription = cat.Description ?? "";

        HeroImage = !string.IsNullOrWhiteSpace(cat.HeroImageUrl)
            ? cat.HeroImageUrl
            : (!string.IsNullOrWhiteSpace(cat.ImageUrl) ? cat.ImageUrl : "images/CourseMenu/Hero-SUV.svg");
    }
    
}

    