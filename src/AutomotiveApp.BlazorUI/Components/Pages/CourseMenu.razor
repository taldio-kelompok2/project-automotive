@page "/{category}"
@using MudBlazor
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Course Menu</PageTitle>

<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudImage Src="@HeroImage" Class="p-0 m-0"
              ObjectFit="ObjectFit.Cover"
              Style="display:flex;
                         width:100%;
                         height:300px;
                         object-fit:cover;
                         border-bottom: 1px solid #BDBDBD" />
</MudHidden>
<MudHidden Breakpoint="Breakpoint.MdAndUp">
    <MudImage Src="@HeroImage" Class="p-0 m-0"
              ObjectFit="ObjectFit.Cover"
              Style="display:flex;
                         width:100%;
                         height:200px;
                         object-fit:cover;
                         border-bottom: 1px solid #BDBDBD" />
</MudHidden>

<MudStack Class="p-4 p-sm-5 my-2" Style="border-bottom: 1px solid #E0E0E0;">
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudText Typo="Typo.h4"
                 Class="text-black mx-4 px-4 mt-1"
                 Align="Align.Left"
                 Style="font-weight: 600;">@CategoryTitle</MudText>
        <MudText Typo="Typo.subtitle1"
                 Class="text-black mx-4 px-4 mb-5 pt-2 pb-3"
                 Style="text-align: justify;
                        line-height: 1.5; ">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</MudText>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudText Typo="Typo.h4"
                 Class="text-black mt-1"
                 Align="Align.Left"
                 Style="font-weight: 600;">@CategoryTitle</MudText>
        <MudText Typo="Typo.subtitle1"
                 Class="text-black pt-2 pb-3"
                 Style="text-align: justify;
                        line-height: 1.5; ">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</MudText>
    </MudHidden>
</MudStack>

<MudContainer MaxWidth="MaxWidth.Large"
              Class="mt-4"
              Style="background-color: white">
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudText Typo="Typo.h4"
                 Align="Align.Center"
                 Color="Color.Primary"
                 Class="mt-6 mb-16 pb-4 pt-3 align-content-center"
                 Style="font-weight: 600;">Another favorite course</MudText>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudText Typo="Typo.h4"
                 Align="Align.Center"
                 Color="Color.Primary"
                 Class="mt-6 mb-10 pb-4 pt-3 align-content-center"
                 Style="font-weight: 600;">Another favorite course</MudText>
    </MudHidden>
    <!-- Courses card -->
        <MudGrid Spacing="6" Class="px-2 pb-8 mb-16">
            @foreach (var car in cars)
            {
                <MudItem xs="12" sm="6" md="4">
                    <CarCard Car="car" />
                </MudItem>
            }
        </MudGrid>
</MudContainer>

<Footer />

@code {
    [Parameter]
    public string? Category { get; set; }

    private List<CarViewModel> allCars = new List<CarViewModel>();
    private List<CarViewModel> cars = new List<CarViewModel>();

    private readonly Random _random = new();

    private string HeroImage => Category?.ToLower() switch
    {
        "electric" => "images/CourseMenu/Hero-Electric.svg",
        "hatchback" => "images/CourseMenu/Hero-Hatchback.svg",
        "lcgc" => "images/CourseMenu/Hero-LCGC.svg",
        "offroad" => "images/CourseMenu/Hero-Offroad.svg",
        "truck" => "images/CourseMenu/Hero-Truck.svg",
        "suv" => "images/CourseMenu/Hero-SUV.svg",
        "mpv" => "images/CourseMenu/Hero-MPV.svg",
        "sedan" => "images/CourseMenu/Hero-Sedan.svg",
        _ => "images/CourseMenu/Hero-SUV.svg"
    };
    private CarCategory CategoryTitle => Category?.ToLowerInvariant() switch
    {
        "electric" => CarCategory.Electric,
        "hatchback" => CarCategory.Hatchback,
        "lcgc" => CarCategory.LCGC,
        "offroad" => CarCategory.Offroad,
        "truck" => CarCategory.Truck,
        "suv" => CarCategory.SUV,
        "mpv" => CarCategory.MPV,
        "sedan" => CarCategory.Sedan,
        _ => CarCategory.SUV
    };


    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(200);
        CarViewModel.InitDummyData(allCars);
        LoadData();
    }

    protected override Task OnParametersSetAsync()
    {
        if (allCars is not null)
            LoadData();

        return Task.CompletedTask;
    }

    private void LoadData()
    {
        cars = string.IsNullOrEmpty(Category)
            ? allCars
            : allCars
                .Where(c => string.IsNullOrEmpty(Category) ||
                            c.Category.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase))
                .OrderBy(_ => _random.Next())
                .Take(6)
                .ToList();
    }

    private void NavigateToCourseDetail(string courseTitle)
    {
        string normalizedTitle = courseTitle.Replace(" ", "-").ToLowerInvariant();
        Navigation.NavigateTo($"/{Category}/{normalizedTitle}");
    }
}
