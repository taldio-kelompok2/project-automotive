@page "/"

@rendermode InteractiveServer
@inject NavigationManager Nav

<section class="main-banner container-fluid">
    <div class="banner-content-top">
        <MudText Typo="Typo.h3">We provide driving lessons for various types of cars</MudText>
        <MudText Class="fw-light" Typo="Typo.h5">Professional staff who are ready to help you to become a
            much-needed reliable driver
        </MudText>
    </div>
    <div class="banner-content-bottom">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h1" Color="Color.Inherit">50+</MudText>
            <span class="banner-caption"> A class ready to make you a reliable driver</span>
        </MudStack>
        <MudStack Spacing="4">
            <MudText Typo="Typo.h1" Color="Color.Inherit">20+</MudText>
            <span class="banner-caption">Professional workforce with great experience</span>
        </MudStack>
        <MudStack Spacing="4">
            <MudText Typo="Typo.h1" Color="Color.Inherit">10+</MudText>
            <span class="banner-caption">Cooperate with driver service partners</span>
        </MudStack>
    </div>
</section>

<section class="course-list">
    <MudText class="text-center" Typo="Typo.h3" Color="Color.Primary">Join us for the course </MudText>
    <MudGrid>
        @foreach (var car in cars.OrderBy(_ => Guid.NewGuid()).Take(6))
        {
            <MudItem xs="12" sm="6" md="4">
                <CarCard Car="car" />
            </MudItem>
        }
    </MudGrid>
</section>

<section class="course-info">
    <div class="d-flex align-items-end gap-4 position-relative">
        <div class="course-content">
            <MudStack Spacing="3">
                <MudText Typo=" Typo.h3" Color="Color.Primary" style="font-size: 2.5rem;">Gets your best benefit
                </MudText>
                <MudText Typo="Typo.body1">We provide trusted programs that are tailored to help you achieve the highest
                    standards of driving skills. Our training modules are designed to enhance both theory and practice,
                    ensuring you are ready to face real driving situations with confidence. From basic lessons to
                    advanced courses,
                    we cover every need for beginners and experienced drivers.
                </MudText>

                <MudText Typo="Typo.body1">
                    Every session is focused on safety, comfort, and excellence, so you gain the confidence to drive on
                    any road.
                    With supportive guidance and proven techniques, we guarantee your journey to become a skilled driver
                    will be both
                    enjoyable and rewarding.
                </MudText>
            </MudStack>
        </div>
        <div class="course-info-logo">
            <img class="course-info-bg" src="/Images/Course/course_bg.svg" alt="">
            <img class="course-info-img" src="/Images/Course/course_img.svg" alt="">
        </div>
    </div>
</section>

