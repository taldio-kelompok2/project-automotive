<section class="course-category">
    <MudText class="text-center" Typo="Typo.h3" Color="Color.Primary">More car type you can choose</MudText>
    <MudGrid>
        @foreach (var category in Enum.GetValues(typeof(CarCategory)).Cast<CarCategory>())
        {
            <MudItem xs="6" sm="4" md="3">
                <MudLink Href="@($"/{category.ToString().ToLower()}")" Style="text-decoration: none; color: inherit;">
                    <div class="category-card">
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceAround" Spacing="1"
                            Class="hover-pointer">
                            <MudImage Src="@($"Images/Cars/Category/{category.ToString().ToLower()}.svg")"
                                Class="rounded-lg" ObjectFit="ObjectFit.Fill" Width="100" Height="100" />
                            <MudText Typo="Typo.body1">@category.ToString()</MudText>
                        </MudStack>
                    </div>
                </MudLink>
            </MudItem>
        }
    </MudGrid>
</section>

<Footer />


@code {
    private List<CarViewModel> cars = new List<CarViewModel>();

    protected override void OnInitialized()
    {
        cars = CarViewModel.InitDummyData();
    }

    // Navigasi Ke Halaman Kategori
    private void GoToCategory(string category)
    {
        Nav.NavigateTo($"/{category.ToLowerInvariant()}");
    }

}