@page "/"
@using AutomotiveApp.BlazorUI.Services.Implementation
@using AutomotiveApp.Domain.Entities.Courses
@using AutomotiveApp.Shared.Dtos.Courses
@using AutomotiveApp.Shared.Models
@using AutomotiveApp.Shared.Response
@using AutomotiveApp.Shared.Dtos.Analytics


@inject IAnalyticsService AnalyticsSvc
@inject ICourseCategoryService CategorySvc
@inject HttpClient Http


@rendermode InteractiveServer
@inject NavigationManager Nav
@inject ICourseService CourseService

<section class="main-banner container-fluid">
    <div class="banner-content-top">
        <MudText Typo="Typo.h3">We provide driving lessons for various types of cars</MudText>
        <MudText Class="fw-light" Typo="Typo.h5">
            Professional staff who are ready to help you to become a much-needed reliable driver
        </MudText>
    </div>
    <div class="banner-content-bottom">
        <MudStack Spacing="4">
            @if (analyticsLoading)
            {
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText Typo="Typo.h1">@($"{coursesCount}+")</MudText>
            }
            <span class="banner-caption">A class ready to make you a reliable driver</span>
        </MudStack>
        <MudStack Spacing="4">
            @if (analyticsLoading)
            {
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText Typo="Typo.h1">@($"{ordersCount}+")</MudText>
            }
            <span class="banner-caption">Professional workforce with great experience</span>
        </MudStack>
        <MudStack Spacing="4">
            @if (analyticsLoading)
            {
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText Typo="Typo.h1">@($"{partnersCount}+")</MudText>
            }
            <span class="banner-caption">Cooperate with driver service partners</span>
        </MudStack>
    </div>
</section>

<section class="course-list">
    <MudText class="text-center mb-4" Typo="Typo.h3" Color="Color.Primary">Join us for the course</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="d-flex mx-auto my-8" />
    }
    else if (cars.Data?.Items.Any() ?? false)
    {
        <MudGrid>
            @foreach (var car in cars.Data.Items)
            {
                <MudItem xs="12" sm="6" md="4">
                    <CarCard Car="car" />
                </MudItem>
            }
        </MudGrid>

        @if (cars.Data.TotalCount > PageSize)
        {
            <div class="d-flex justify-center mt-6">
                <MudPagination Count="@totalPages" Selected="@coursePage" SelectedChanged="@OnPageChanged" BoundaryCount="3" />
            </div>
        }
    }
    else
    {
        <MudText Typo="Typo.body1" Align="Align.Center" Class="my-8">
            No courses found.
        </MudText>
    }
</section>

<section class="course-info mt-12">
    <div class="d-flex align-items-end gap-4 position-relative">
        <div class="course-content">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h3" Color="Color.Primary" Style="font-size:2.5rem;">Get your best benefit</MudText>
                <MudText Typo="Typo.body1">
                    We provide trusted programs tailored to help you achieve the highest standards of driving skills.
                    Our training modules are designed to enhance both theory and practice, ensuring you are ready to
                    face
                    real driving situations with confidence. From basic lessons to advanced courses, we cover every need
                    for beginners and experienced drivers.
                </MudText>
                <MudText Typo="Typo.body1">
                    Every session focuses on safety, comfort, and excellence, so you gain the confidence to drive on any
                    road.
                    With supportive guidance and proven techniques, we guarantee your journey to become a skilled driver
                    will be both enjoyable and rewarding.
                </MudText>
            </MudStack>
        </div>
        <div class="course-info-logo">
            <img class="course-info-bg" src="/Images/Course/course_bg.svg" alt="">
            <img class="course-info-img" src="/Images/Course/course_img.svg" alt="">
        </div>
    </div>
</section>

<section class="course-category mt-12">
    <MudText class="text-center mb-6" Typo="Typo.h3" Color="Color.Primary">
        More car types you can choose
    </MudText>

    @if (isCategoryLoading)
    {
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="d-flex mx-auto my-8" />
    }
    else if (categories.Data?.Items.Any() ?? false)
    {
        <MudGrid>
            @foreach (var c in categories.Data.Items)
            {
                <MudItem xs="6" sm="4" md="3">
                    @* <MudLink Href="@($"/course/{c.Name.ToLower()}")" Style="text-decoration:none;color:inherit;"> *@
                    <MudLink Href="@($"/course-category/{c.Id}")" Style="text-decoration:none;color:inherit;">
                        <div class="category-card hover-pointer">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceAround" Spacing="1">
                                <MudImage Src="@ResolveCatImage(c.ImageUrl)" Class="rounded-lg" ObjectFit="ObjectFit.Fill"
                                    Width="100" Height="100" />
                                <MudText Typo="Typo.body1">@c.Name</MudText>
                            </MudStack>
                        </div>
                    </MudLink>
                </MudItem>
            }
        </MudGrid>

        @if (categories.Data.TotalCount > CategoryPageSize)
        {
            <div class="d-flex justify-center mt-6">
                <MudPagination Count="@categoryTotalPages" Selected="@categoryPage" SelectedChanged="@OnCategoryPageChanged"
                    BoundaryCount="3" />
            </div>
        }
    }
    else
    {
        <MudText Typo="Typo.body1" Align="Align.Center" Class="my-8">
            Not Available Course Category
        </MudText>
    }
</section>


<Footer />

@code {
    private ApiResponse<PaginatedResult<CourseQueryDto>> cars = new();
    private bool isLoading;
    private int coursePage;
    private int totalPages;
    private const int PageSize = 6;
    protected override async Task OnInitializedAsync()
    {
        coursePage = 1;
        await LoadCoursesAsync(coursePage);

        categoryPage = 1;
        await LoadCategoriesAsync(categoryPage);

        // analytics
        await LoadAnalyticsAsync();
    }

    private async Task OnPageChanged(int page)
    {
        coursePage = page;
        await LoadCoursesAsync(coursePage);
    }

    private async Task LoadCoursesAsync(int page)
    {
        isLoading = true;

        try
        {
            cars = await CourseService.GetPaged(Page: page, PageSize);

            if (cars.Data != null)
            {
                totalPages = (int)Math.Ceiling((double)cars.Data.TotalCount / PageSize);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading courses: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    // --- Course Category ---
    private ApiResponse<PaginatedResult<CourseCategoryQueryDto>> categories = new();
    private bool isCategoryLoading;
    private int categoryPage;
    private int categoryTotalPages;
    private const int CategoryPageSize = 8;

    private async Task OnCategoryPageChanged(int page)
    {
        categoryPage = page;
        await LoadCategoriesAsync(categoryPage);
    }

    private async Task LoadCategoriesAsync(int page)
    {
        isCategoryLoading = true;
        try
        {
            categories = await CategorySvc.GetPagedAsync(page, CategoryPageSize);
            if (categories.Data != null)
                categoryTotalPages = (int)Math.Ceiling((double)categories.Data.TotalCount / CategoryPageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading categories: {ex.Message}");
            categories = new();
        }
        finally { isCategoryLoading = false; }
    }

    private string ResolveCatImage(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "/images/coursecategory/placeholder.svg";
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return url;
        if (url.StartsWith("/images/", StringComparison.OrdinalIgnoreCase)) return url;

        var api = Http.BaseAddress?.ToString()?.TrimEnd('/');
        return $"{api}/images/CourseCategory/{url}";
    }


    // --- Analytics ---
    private int coursesCount;
    private int ordersCount;
    private int partnersCount;
    private bool analyticsLoading;

    private async Task LoadAnalyticsAsync()
    {
        analyticsLoading = true;
        try
        {
            var result = await AnalyticsSvc.GetOverviewAsync();
            if (result.Success && result.Data != null)
            {
                coursesCount = result.Data.CoursesCount;
                ordersCount = result.Data.OrdersCount;
                partnersCount = result.Data.PartnersCount;
            }
        }
        finally { analyticsLoading = false; }
    }




}