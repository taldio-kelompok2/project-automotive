@page "/register"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Register</PageTitle>

<MudPaper Class="mx-auto my-8 p-6 auth-card" Elevation="0" Style="background:transparent; box-shadow:none;" MaxWidth="500px">
    
    <div class="master-title">
        <MudText Class="title">Lets Join our course!</MudText>
        <MudText Class="subtitle">Please register first</MudText>
    </div>

    <MudForm @ref="form" Model="_model">
        <MudTextField Label="Name"
                      For="@(()=> _model.Name)"
                      @bind-Value="_model.Name"
                      Required="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />

        <MudTextField Label="Email"
                      For="@(()=> _model.Email)"
                      @bind-Value="_model.Email"
                      Required="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />

        <MudTextField Label="Password"
                      For="@(()=> _model.Password)"
                      @bind-Value="_model.Password"
                      Required="true"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />

        <MudTextField Label="Confirm Password"
                      For="@(()=> _model.ConfirmPassword)"
                      @bind-Value="_model.ConfirmPassword"
                      Required="true"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />

        <div class="actions">
            <MudButton OnClick="SubmitAsync"
                       Class="signup-btn"
                       ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled">
                Sign Up
            </MudButton>
        </div>
    </MudForm>

    <p class="signin-note">
        Have account? <a href="/login" class="login-link">Login here</a>
    </p>
</MudPaper>

@code {
    private MudForm? form;
    private bool _showPassword;
    private bool _showConfirm;
    private RegisterModel _model = new();

    private async Task SubmitAsync()
    {
        await form!.Validate();

        if (form.IsValid)
        {
            // TODO: ganti dengan call API register asli kamu, mis:
            // await AuthService.RegisterAsync(_model);
            await Task.CompletedTask; // supaya nggak muncul CS1998
            Snackbar.Add("Registration submitted ✔️", Severity.Success);
            // Nav.NavigateTo("/login");
        }
        else
        {
            Snackbar.Add("Perbaiki error validasi dulu, ya.", Severity.Warning);
        }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Email tidak valid")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Minimal 6 karakter")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Confirm password is required")]
        [Compare(nameof(Password), ErrorMessage = "Password tidak sama")]
        public string? ConfirmPassword { get; set; }
    }
}
