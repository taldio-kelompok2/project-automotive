@page "/new-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>New Password</PageTitle>

<MudPaper Class="mx-auto my-8 p-6 auth-card" Elevation="0" Style="background:transparent; box-shadow:none;" MaxWidth="500px">
    
    <MudText Typo="Typo.h5" Class="mb-5">Create Password</MudText>

    <!-- Alert --> 
    @* <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Filled" Style="margin-bottom:1rem;" Visible="@_showSuccess"> Password Sudah Terbaru </MudAlert> <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Filled" Style="margin-bottom:1rem;" Visible="@_showWarning"> Periksa Data Input </MudAlert> *@

    <EditForm EditContext="@_editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="HandleInvalidSubmitAsync">
        <DataAnnotationsValidator />     
        <ValidationSummary />

        <MudTextField Label="Password"
                For="@(()=> _model.Password)"
                Class="mb-4"
                @bind-Value="_model.Password"
                InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                Immediate="true"
                Adornment="Adornment.End"
                AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                OnAdornmentClick="@TogglePasswordVisibility" />
        <ValidationMessage For="()=> _model.Password" />

        <MudTextField Label="Confirm Password"
                For="@(()=> _model.ConfirmPassword)"
                Class="mb-5"
                @bind-Value="_model.ConfirmPassword"
                InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                Immediate="true"
                Adornment="Adornment.End"
                AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                OnAdornmentClick="@ToggleConfirmVisibility" />
        <ValidationMessage For="()=> _model.ConfirmPassword" />

        <div class="actions">
            <MudButton OnClick="CancelAsync"
                    Class="btn-cancel"
                    ButtonType="ButtonType.Button"
                    Variant="Variant.Outlined"
                    Color="Color.Primary">
                    Cancel
            </MudButton>

            <MudButton Class="btn-confirm"
                    ButtonType="ButtonType.Submit"
                    Variant="Variant.Filled"
                    Color="Color.Primary">
                    Submit
            </MudButton>
        </div>
    </EditForm>
</MudPaper>

@code {
    private NewPasswordModel _model = new();
    private EditContext _editContext = default!;

    // Password Visibility Toggle
    private bool _showPassword;
    private bool _showConfirm;

    private bool _showSuccess;
    private bool _showWarning;

    private async Task SubmitAsync()
    {
        _showSuccess = true;
        _showWarning = false;

        await Task.Delay(2000); // kasih waktu alert tampil
        _model = new();
        _editContext = new EditContext(_model);
        StateHasChanged();
        Nav.NavigateTo("/new-password", forceLoad: false);
    }

    private Task OnInvalidAsync()
    {
        _showWarning = true;
        _showSuccess = false;
        return Task.CompletedTask;
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private void ToggleConfirmVisibility()
    {
        _showConfirm = !_showConfirm;
    }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);

        _editContext.OnFieldChanged += (sender, e) =>
        {
            if (e.FieldIdentifier.FieldName == nameof(NewPasswordModel.Password))
            {
                var confirmField = new FieldIdentifier(_model, nameof(NewPasswordModel.ConfirmPassword));
                _editContext.NotifyFieldChanged(confirmField);
            }
        };
    }

    private Task HandleInvalidSubmitAsync()
    {
        Snackbar.Add("Periksa Data Input", Severity.Warning);
        return Task.CompletedTask;
    }

    private Task CancelAsync()
    {
        _model = new();
        _editContext = new EditContext(_model);
        StateHasChanged();
        Nav.NavigateTo("/new-password");
        return Task.CompletedTask;
    }

    public class NewPasswordModel
    {
        [Required(ErrorMessage = "Password Wajib")]
        [MinLength(12, ErrorMessage = "Password Minimal 12 Karakter")]
        [RegularExpression(@"^(?=.*[a-zA-Z])(?=.*\d)(?=.*[^a-zA-Z\d]).{12,}$",
            ErrorMessage = "Password Harus Terdiri Dari Huruf, Angka, dan Simbol")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Confirm Password Wajib")]
        [Compare(nameof(Password), ErrorMessage = "Password Tidak Valid")]
        public string? ConfirmPassword { get; set; }
    }

}