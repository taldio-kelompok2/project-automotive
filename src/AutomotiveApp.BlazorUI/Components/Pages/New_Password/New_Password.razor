@page "/new-password"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>New Password</PageTitle>

<MudPaper Class="mx-auto my-8 p-6 auth-card" Elevation="0" Style="background:transparent; box-shadow:none;" MaxWidth="500px">

    <div class="master-title">
        <div class="title">
            <MudText>Create Password</MudText>
        </div>
    </div>

    <MudForm @ref="form" Model="_model">
        <MudTextField Label="Password"
                      For="@(()=> _model.Password)"
                      @bind-Value="_model.Password"
                      Required="true"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />

        <MudTextField Label="Confirm Password"
                      For="@(()=> _model.ConfirmPassword)"
                      @bind-Value="_model.ConfirmPassword"
                      Required="true"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />

        <div class="actions">
            <MudButton OnClick="CancelAsync"
                       Class="btn-cancel"
                       ButtonType="ButtonType.Button"
                       Variant="Variant.Outlined"
                       Color="Color.Primary">
                Cancel
            </MudButton>

            <MudButton OnClick="SubmitAsync"
                       Class="btn-confirm"
                       ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Submit
            </MudButton>
        </div>
    </MudForm>
</MudPaper>

@code {
    private MudForm? form;
    private NewPasswordModel _model = new();

    private async Task SubmitAsync()
    {
        await form!.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Periksa Data Input", Severity.Warning);
            return;
        }

        Snackbar.Add("Password Sudah Terbaru", Severity.Success);
        Nav.NavigateTo("/login");
    }

    private Task CancelAsync()
    {
        _model = new();
        StateHasChanged();
        Nav.NavigateTo("/login");
        return Task.CompletedTask;
    }

    public class NewPasswordModel
    {
        [Required(ErrorMessage = "Password Wajib")]
        [MinLength(12, ErrorMessage = "Password 12 Karakter")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Confirm Password Wajib")]
        [Compare(nameof(Password), ErrorMessage = "Password Tidak Valid")]
        public string? ConfirmPassword { get; set; }
    }
}