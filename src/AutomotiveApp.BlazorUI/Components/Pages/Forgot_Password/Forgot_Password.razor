@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Forgot Password</PageTitle>

<MudPaper Class="mx-auto my-8 p-6 auth-card" Elevation="0" Style="background:transparent; box-shadow:none;" MaxWidth="500px">
    
    <div class="master-title">
        <MudText Class="title">Reset Password</MudText>
        <MudText Class="subtitle">Send OTP code to your email address</MudText>
    </div>

    <MudForm @ref="form" Model="_model">
        <MudTextField Label="Email"
                      For="@(()=> _model.Email)"
                      @bind-Value="_model.Email"
                      Required="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />

        <div class="actions">
            <MudButton OnClick="CancelAsync"
                       Class="btn-cancel"
                       ButtonType="ButtonType.Button"
                       Variant="Variant.Outlined"
                       Color="Color.Primary">
                Cancel
            </MudButton>

            <MudButton OnClick="SubmitAsync"
                       Class="btn-confirm"
                       ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Confirm
            </MudButton>
        </div>
    </MudForm>
</MudPaper>

@code {
    private MudForm? form;
    private ForgotPasswordModel _model = new();

    private async Task SubmitAsync()
    {
        await form!.Validate();
        if (!form.IsValid)
        {
            Snackbar.Add("Error", Severity.Warning);
            return;
        }
    }

    private Task CancelAsync()
    {
        _model = new();
        StateHasChanged();

        Nav.NavigateTo("/login");
        return Task.CompletedTask;
    }

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email Wajib")]
        [EmailAddress(ErrorMessage = "Email Tidak Valid")]
        public string? Email { get; set; }
    }
}
