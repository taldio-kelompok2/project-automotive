@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Forgot Password</PageTitle>

<MudPaper Class="mx-auto my-8 p-6 auth-card" Elevation="0" Style="background:transparent; box-shadow:none;" MaxWidth="500px">

    <MudText Typo="Typo.h5" Class="mb-3">Reset Password</MudText>
    <MudText Class="subtitle mb-5">Send OTP code to your email address</MudText>

    <EditForm EditContext="@_editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="OnInvalidAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudTextField Label="Email"
                      For="@(()=> _model.Email)"
                      Class="mb-4"
                      @bind-Value="_model.Email"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      ShrinkLabel="true"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Email" />
        <ValidationMessage For="()=> _model.Email" />

        <div class="actions">
            <MudButton OnClick="CancelAsync"
                       Class="btn-cancel"
                       ButtonType="ButtonType.Button"
                       Variant="Variant.Outlined"
                       Color="Color.Primary">
                Cancel
            </MudButton>

            <MudButton Class="btn-confirm"
                       ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                Confirm
            </MudButton>
        </div>
    </EditForm>
</MudPaper>

@code {
    private ForgotPasswordModel _model = new();
    private EditContext _editContext = default!;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);

        _editContext.OnFieldChanged += async (_, __) =>
        {
            _editContext.Validate();
            await InvokeAsync(StateHasChanged);
        };
    }

    private async Task SubmitAsync()
    {
        Snackbar.Add("OTP Terkirim", Severity.Success);
        await Task.CompletedTask;
    }

    private Task OnInvalidAsync()
    {
        Snackbar.Add("Periksa Data Input", Severity.Warning);
        return Task.CompletedTask;
    }

    private Task CancelAsync()
    {
        _model = new();
        _editContext = new EditContext(_model);
        StateHasChanged();
        Nav.NavigateTo("/forgot-password");
        return Task.CompletedTask;
    }

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email Wajib")]
        [RegularExpression(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", ErrorMessage = "Email harus mengandung @ dan .")]
        public string? Email { get; set; }
    }
}
