@page "/invoice"
@using System.Globalization
@using MudBlazor
@using AutomotiveApp.BlazorUI.Components.Shared.Buttons
@using AutomotiveApp.BlazorUI.Enums.Button
@using AutomotiveApp.Application.Invoices
@using System.Net.Http.Json
@inject NavigationManager NavigationManager
@inject HttpClient Http

@rendermode InteractiveServer
<PageTitle>Menu Invoice</PageTitle>

<div style="min-height:calc(100vh - 200px); display:flex; flex-direction:column;">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudBreadcrumbs Class="mb-2" Style="margin-left:-12px;" Items="@Crumbs" Separator=">" />

        <MudText Typo="Typo.h5" Class="mb-4" Style="color:#4F4F4F; font-weight:600;">
            Menu Invoice
        </MudText>

        <!-- View Desktop -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <div class="table-responsive">
                <MudTable Items="Invoices" Dense="true" Hover="true" Elevation="0" Class="w-100 custom-table" Loading="@_loading">
                    <HeaderContent>
                        <MudTh Style="@HeaderStyle" Class="text-white text-center">No</MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white text-center">No. Invoice</MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white text-center">Date</MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white text-center">Total Course</MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white text-center">Total Price</MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white text-center">Action</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd Style="@RowStyle">@context.No</MudTd>
                        <MudTd Style="@RowStyle">@context.InvoiceNo</MudTd>
                        <MudTd Style="@RowStyle">@context.Date.ToString("dd MMMM yyyy", new CultureInfo("en-US"))</MudTd>
                        <MudTd Style="@RowStyle">@context.TotalCourseDisplay</MudTd>
                        <MudTd Style="@RowStyle">@FormatIdr(context.TotalPrice)</MudTd>
                        <MudTd Style="@RowStyle">
                            <AppBaseButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Width="ButtonWidth.Long"
                                           Class="custom-details-btn"
                                           OnClick="@(() => GoToDetail(context.InvoiceNo))">
                                Details
                            </AppBaseButton>
                        </MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <MudText Class="p-4">@(_loading ? "Loading..." : "No Data Available")</MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudHidden>

        <!-- View Mobile -->
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            @if (_loading)
            {
                <div class="d-flex justify-content-center my-4"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var row in Invoices)
                    {
                        <MudPaper Class="mobile-card" Elevation="0">
                            <div class="kv"><span class="k">No</span><span class="v">@row.No</span></div>
                            <div class="kv"><span class="k">No. Invoice</span><span class="v">@row.InvoiceNo</span></div>
                            <div class="kv"><span class="k">Date</span>
                                <span class="v">@row.Date.ToString("dd MMMM yyyy", new CultureInfo("en-US"))</span>
                            </div>
                            <div class="kv"><span class="k">Total Course</span><span class="v">@row.TotalCourseDisplay</span></div>
                            <div class="kv total"><span class="k">Total Price</span><span class="v">@FormatIdr(row.TotalPrice)</span></div>

                            <div class="mobile-actions">
                                <AppBaseButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Width="ButtonWidth.Long"
                                               Class="custom-details-btn"
                                               OnClick="@(() => GoToDetail(row.InvoiceNo))">
                                    Details
                                </AppBaseButton>
                            </div>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudHidden>

    </MudContainer>
</div>

<Footer />

<style>
    .custom-table tbody tr:hover { background-color: #790B0A1A !important; transition: background-color 0.2s ease-in-out; }
    .mud-breadcrumbs li a, .mud-breadcrumbs li .mud-typography { color: #828282 !important; }
    .mud-breadcrumbs li:last-child a, .mud-breadcrumbs li:last-child .mud-typography { color: #790b0a !important; font-weight: 600; }
    .custom-details-btn { border: 1px solid #790b0a !important; color: #790b0a !important; }
    .custom-details-btn .mud-button-label { font-weight: bold !important; }
    .custom-details-btn:hover { background-color: #790b0a !important; color: white !important; }
    .mobile-card{ border:1px solid #E0E0E0; border-radius:10px; padding:12px 14px; margin-bottom: 20px; }
    .mobile-card:last-child { margin-bottom: 35px; }
    .mobile-card .kv{ display:flex; justify-content:space-between; gap:12px; padding:8px 0; border-bottom:1px solid #F2F2F2; }
    .mobile-card .kv:last-child{ border-bottom:none; }
    .mobile-card .k{ color:#7A7A7A; font-weight:500; }
    .mobile-card .v{ color:#333; font-weight:600; text-align:right; }
    .mobile-card .total .k{ color:#5A5A5A; }
    .mobile-card .total .v{ color:#790b0a; font-weight:700; }
    @* @media (max-width: 600px){ .mobile-card .k, .mobile-card .v { font-size:.92rem; } } *@
</style>

@code {
    private string HeaderStyle => "background-color:#790b0a; height:55px; text-align:center; vertical-align:middle; font-weight:bold;";
    private string RowStyle => "height:55px; vertical-align:middle; text-align:center;";

    private List<BreadcrumbItem> Crumbs => new() { 
        new BreadcrumbItem("Home", href: "/"), 
        new BreadcrumbItem("Invoice", href: null, disabled: true) 
    };

    private bool _loading;
    private List<InvoiceItem> Invoices = new();

    // DTO 
    private record InvoiceLite(Guid Id, long TotalPrice, int InvoiceNumber, string InvoiceCode, Guid OrderId, DateTime CreatedAt);
    private record OrderItemLite(Guid Id, long Price, Guid OrderId, Guid SessionId);

    protected override async Task OnInitializedAsync()
    {
        
        _loading = true;
        await Task.Delay(100);
        try
        {
            // Get All Data Invoice
            var invoices = await Http.GetFromJsonAsync<List<InvoiceLite>>("api/Invoices") ?? new();

            // Get All Data OrderItem & Sum / OrderId
            var orderItems = await Http.GetFromJsonAsync<List<OrderItemLite>>("api/OrderItems") ?? new();
            var itemCountByOrder = orderItems
                .GroupBy(i => i.OrderId)
                .ToDictionary(g => g.Key, g => g.Count());

            // Map Ke View Model & Data Isian 
            Invoices = invoices
                .OrderByDescending(x => x.CreatedAt)
                .Select((x, idx) => new InvoiceItem
                {
                    No = idx + 1,
                    InvoiceNo = x.InvoiceCode,
                    Date = x.CreatedAt,
                    TotalCourse = itemCountByOrder.TryGetValue(x.OrderId, out var c) ? c : (int?)null,
                    TotalPrice = x.TotalPrice,
                    OrderId = x.OrderId
                })
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatIdr(long value)
        => string.Format(new CultureInfo("id-ID"), "IDR {0:N0}", value);

    private void GoToDetail(string invoiceNo)
        => NavigationManager.NavigateTo($"/detail-invoice?no={invoiceNo}");

    // Models
    public class InvoiceItem
    {
        public int No { get; set; }
        public string InvoiceNo { get; set; } = "";
        public DateTime Date { get; set; }
        public int? TotalCourse { get; set; }  
        public string TotalCourseDisplay => TotalCourse?.ToString() ?? "-";
        public long TotalPrice { get; set; }
        public Guid OrderId { get; set; }
    }
}