@using MudBlazor
@page "/detail-invoice"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Details Invoice</PageTitle>

<div style="min-height:calc(100vh - 200px); display:flex; flex-direction:column;">
    <MudContainer MaxWidth="MaxWidth.Large">

        <MudBreadcrumbs Class="mb-2" Style="margin-left:-10px;" Items="@Crumbs" Separator=">" />
        <MudText Typo="Typo.h5" Class="mb-4" Style="color:#4F4F4F; font-weight:600;">
            Details Invoice
        </MudText>

        <MudGrid Class="mb-4" Style="color:#4F4F4F;">
            <MudItem xs="12" md="6">
                <MudStack Spacing="1">
                    <MudText><b>No. Invoice :</b> @InvoiceNo</MudText>
                    <MudText><b>Date :</b> @InvoiceDate.ToString("dd MMMM yyyy", new CultureInfo("en-US"))</MudText>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex justify-end align-end">
                <MudText Typo="Typo.subtitle1" Class="mr-2"><b>Total Price</b></MudText>
                <MudText Typo="Typo.subtitle1"><b>@FormatIdr(TotalPrice)</b></MudText>
            </MudItem>
        </MudGrid>

        <!-- View Desktop -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <div class="table-responsive">
                <MudTable Items="Items" Dense="true" Hover="true" Elevation="0" Class="w-100">
                    <HeaderContent>
                        <MudTh Style="@HeaderStyle" Class="text-white"><b>No</b></MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white"><b>Course Name</b></MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white"><b>Type</b></MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white"><b>Schedule</b></MudTh>
                        <MudTh Style="@HeaderStyle" Class="text-white text-end"><b>Price</b></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="height:55px; vertical-align:middle; text-align:center;">@context.No</MudTd>
                        <MudTd Style="height:55px; vertical-align:middle; text-align:center;">@context.CourseName</MudTd>
                        <MudTd Style="height:55px; vertical-align:middle; text-align:center;">@context.Type</MudTd>
                        <MudTd Style="height:55px; vertical-align:middle; text-align:center;">
                            @context.Schedule.ToString("dddd, dd MMMM yyyy", new CultureInfo("en-US"))
                        </MudTd>
                        <MudTd Style="height:55px; vertical-align:middle;" Class="text-end">
                            @FormatIdr(context.Price)
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudHidden>

        <!-- View Mobile Phone -->
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudStack Spacing="2">
                @foreach (var row in Items)
                {
                    <MudPaper Class="mobile-card" Elevation="0">
                        <div class="kv">
                            <span class="k">No</span>
                            <span class="v">@row.No</span>
                        </div>
                        <div class="kv">
                            <span class="k">Course Name</span>
                            <span class="v">@row.CourseName</span>
                        </div>
                        <div class="kv">
                            <span class="k">Type</span>
                            <span class="v">@row.Type</span>
                        </div>
                        <div class="kv">
                            <span class="k">Schedule</span>
                            <span class="v">@row.Schedule.ToString("dddd, dd MMMM yyyy", new CultureInfo("en-US"))</span>
                        </div>
                        <div class="kv total">
                            <span class="k">Price</span>
                            <span class="v">@FormatIdr(row.Price)</span>
                        </div>
                    </MudPaper>
                }
            </MudStack>
        </MudHidden>

    </MudContainer>
</div>

<Footer />


<style>
/* first breadcrumb */
.mud-breadcrumbs li a,
.mud-breadcrumbs li .mud-typography {
    color: #828282 !important;
}

/* last breadcrumb */
.mud-breadcrumbs li:last-child a,
.mud-breadcrumbs li:last-child .mud-typography {
    color: #790b0a !important;
    font-weight: 600; 
}

.mobile-card{
    border:1px solid #E0E0E0;
    border-radius:10px;
    padding:12px 14px;
}
.mobile-card:last-child {
    margin-bottom: 35px; 
}
.mobile-card .kv{
    display:flex;
    justify-content:space-between;
    gap:12px;
    padding:8px 0;
    border-bottom:1px solid #F2F2F2;
}
.mobile-card .kv:last-child{ border-bottom:none; }
.mobile-card .k{
    color:#7A7A7A;       
    font-weight:500;
}
.mobile-card .v{
    color:#333;
    font-weight:600;
    text-align:right;
}
.mobile-card .total .k{ color:#5A5A5A; }
.mobile-card .total .v{
    color:#790b0a;          
    font-weight:700;
}

@@media (max-width: 600px){
    .mobile-card .k, .mobile-card .v { font-size:.92rem; }
}
</style>


@code {
    private readonly CultureInfo Indo = new("id-ID");

    private string HeaderStyle => "background-color:#790b0a; height:55px; text-align:center; vertical-align:middle;";

    private List<BreadcrumbItem> Crumbs => new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Invoice", href: "/invoice"),
        new BreadcrumbItem("Details Invoice", href: null, disabled: true),
    };

    // Dummy Data
    private string InvoiceNo = "OTO00003";
    private DateTime InvoiceDate = new(2022, 6, 12);
    private List<InvoiceItem> Items = new()
    {
        new() { No=1, CourseName="Hyundai Palisade 2021", Type="SUV", Schedule=new(2022,7,27), Price=850_000m },
        new() { No=2, CourseName="Mitsubishi Fuso Canter", Type="TRUCK", Schedule=new(2022,7,27), Price=900_000m }
    };

    private decimal TotalPrice => Items.Sum(i => i.Price);

    private string FormatIdr(decimal value)
        => string.Format(Indo, "IDR {0:N0}", value);

    public class InvoiceItem
    {
        public int No { get; set; }
        public string CourseName { get; set; } = "";
        public string Type { get; set; } = "";
        public DateTime Schedule { get; set; }
        public decimal Price { get; set; }
    }
}
