@page "/detail-invoice"
@using System.Globalization
@using MudBlazor
@using AutomotiveApp.Application.Invoices
@using Microsoft.AspNetCore.WebUtilities
@using System.Net.Http.Json
@using AutomotiveApp.BlazorUI.Services.Invoices
@rendermode InteractiveServer
@inject AutomotiveApp.BlazorUI.Services.Invoices.IInvoiceService InvoiceService
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IInvoiceService InvoiceService
@inject NavigationManager Navigation
@inject HttpClient Http


<PageTitle>Details Invoice</PageTitle>

<div style="min-height:calc(100vh - 200px); display:flex; flex-direction:column;">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pb-5">

        <MudBreadcrumbs Class="mb-2" Style="margin-left:-10px;" Items="@Crumbs" Separator=">" />
        <MudText Typo="Typo.h5" Class="mb-4" Style="color:#4F4F4F; font-weight:600;">
            Details Invoice
        </MudText>

        @if (_loading)
        {
            <div class="d-flex justify-content-center my-4"><MudProgressCircular Indeterminate="true" /></div>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        else
        {
            <MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.End" Class="mb-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="Download" Class="w-100">
                    Download
                </MudButton>
            </MudStack>
            <MudGrid Class="mb-4" Style="color:#4F4F4F;">
                <MudItem xs="12" md="6">
                    <MudStack Spacing="1">
                        <MudText><b>No. Invoice :</b> @InvoiceNo</MudText>
                        <MudText><b>Date :</b> @InvoiceDate.ToString("dd MMMM yyyy", new CultureInfo("en-US"))</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex justify-end align-end">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle1" class="mr-2"><b>Payment Method : @PaymentMethodDisplay </b></MudText>
                        <MudText Typo="Typo.subtitle1" Class="mr-2"><b>Total Price : @FormatIdr(TotalPrice)</b></MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <!-- View Desktop -->
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <div class="table-responsive">
                    <MudTable Items="Items" Dense="true" Hover="true" Elevation="0" Class="w-100 custom-table" Striped="true">
                        <HeaderContent>
                            <MudTh Style="@HeaderStyle" Class="text-white"><b>No</b></MudTh>
                            <MudTh Style="@HeaderStyle" Class="text-white"><b>Course Name</b></MudTh>
                            <MudTh Style="@HeaderStyle" Class="text-white"><b>Type</b></MudTh>
                            <MudTh Style="@HeaderStyle" Class="text-white"><b>Schedule</b></MudTh>
                            <MudTh Style="@HeaderStyle" Class="text-white text-end"><b>Price</b></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="height:55px; vertical-align:middle; text-align:center;">@context.No</MudTd>
                            <MudTd Style="height:55px; vertical-align:middle; text-align:center;">@context.CourseName</MudTd>
                            <MudTd Style="height:55px; vertical-align:middle; text-align:center;">@context.Type</MudTd>
                            <MudTd Style="height:55px; vertical-align:middle; text-align:center;">
                                @context.Schedule.ToString("dddd, dd MMMM yyyy", new CultureInfo("en-US"))
                            </MudTd>
                            <MudTd Style="height:55px; vertical-align:middle;" Class="text-end">
                                @FormatIdr(context.Price)
                            </MudTd>
                        </RowTemplate>

                        <NoRecordsContent>
                            <MudText Class="p-3">No Item Course</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </div>
            </MudHidden>

            <!-- View Mobile -->
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudStack Spacing="2">
                    @foreach (var row in Items)
                    {
                        <MudPaper Class="mobile-card" Elevation="0">
                            <div class="kv"><span class="k">No</span><span class="v">@row.No</span></div>
                            <div class="kv"><span class="k">Course Name</span><span class="v">@row.CourseName</span></div>
                            <div class="kv"><span class="k">Type</span><span class="v">@row.Type</span></div>
                            <div class="kv"><span class="k">Schedule</span>
                                <span class="v">@row.Schedule.ToString("dddd, dd MMMM yyyy", new CultureInfo("en-US"))</span>
                            </div>
                            <div class="kv total"><span class="k">Price</span><span class="v">@FormatIdr(row.Price)</span></div>
                        </MudPaper>
                    }
                </MudStack>
            </MudHidden>
        }
    </MudContainer>
</div>

<Footer />

<style>
    /* breadcrumb */
    .mud-breadcrumbs li a, .mud-breadcrumbs li .mud-typography { color: #828282 !important; }
    .mud-breadcrumbs li:last-child a, .mud-breadcrumbs li:last-child .mud-typography { color: #790b0a !important; font-weight: 600; }
    /* mobile cards */
    .mobile-card{ border:1px solid #E0E0E0; border-radius:10px; padding:12px 14px; }
    .mobile-card:last-child { margin-bottom: 35px; }
    .mobile-card .kv{ display:flex; justify-content:space-between; gap:12px; padding:8px 0; border-bottom:1px solid #F2F2F2; }
    .mobile-card .kv:last-child{ border-bottom:none; }
    .mobile-card .k{ color:#7A7A7A; font-weight:500; }
    .mobile-card .v{ color:#333; font-weight:600; text-align:right; }
    .mobile-card .total .k{ color:#5A5A5A; }
    .mobile-card .total .v{ color:#790b0a; font-weight:700; }

    .custom-table tbody {
        background-color: white !important;
    }

    .custom-table .mud-table-root {
        background-color: #ffffff !important;
    }

    .custom-table.mud-table-striped
    .mud-table-container
    .mud-table-root
    .mud-table-body
    .mud-table-row:nth-of-type(odd) {
        background-color: white !important;
    }

    .custom-table.mud-table-striped
    .mud-table-container
    .mud-table-root
    .mud-table-body
    .mud-table-row:nth-of-type(even) {
        background-color: rgba(121, 11, 10, 0.1) !important;
    }

    .custom-table.mud-table-striped
    .mud-table-container
    .mud-table-root
    .mud-table-body
    .mud-table-row:hover {
        background-color: rgba(121, 11, 10, 0.25) !important;
        transition: background-color 0.2s ease-in-out;
    }
</style>

@code {
    private readonly CultureInfo Indo = new("id-ID");
    private string HeaderStyle => "background-color:#790b0a; height:55px; text-align:center; vertical-align:middle;";
    private string PaymentMethodDisplay = "-";
    private Guid InvoiceId;

    private List<BreadcrumbItem> Crumbs => new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Invoice", href: "/invoice"),
        new BreadcrumbItem("Details Invoice", href: null, disabled: true),
    };

    private string InvoiceNo = "";
    private DateTime InvoiceDate = DateTime.Now;
    private long TotalPrice;
    private List<InvoiceItem> Items = new();
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

            if (query.TryGetValue("id", out var idStr) && Guid.TryParse(idStr, out var id))
            {
                var details = await InvoiceService.GetDetailsAsync(id);
                if (details is null) { _error = "Failed to load invoice details"; return; }
                BindToUi(details);
                return;
            }

            if (query.TryGetValue("no", out var no) && !string.IsNullOrWhiteSpace(no))
            {
                var myInvoices = await InvoiceService.GetMyInvoicesAsync();
                var inv = myInvoices.FirstOrDefault(x => string.Equals(x.InvoiceCode, no.ToString(), StringComparison.OrdinalIgnoreCase));
                if (inv is null) { _error = $"Invoice '{no}' not found."; return; }

                var details = await InvoiceService.GetDetailsAsync(inv.Id);
                if (details is null) { _error = "Failed to load invoice details."; return; }
                BindToUi(details);
                return;
            }

            _error = "Missing 'id' or 'no' query.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void BindToUi(InvoiceDetailsDto details)
    {
        InvoiceId   = details.Id;
        InvoiceNo   = details.InvoiceCode;
        InvoiceDate = details.CreatedAt;
        TotalPrice  = details.TotalPrice;
        PaymentMethodDisplay = string.IsNullOrWhiteSpace(details.PaymentMethod) ? "-" : details.PaymentMethod;

        Items = details.Items.Select((x, idx) => new InvoiceItem
        {
            No         = idx + 1,
            CourseName = x.CourseName,
            Type       = x.Type,
            Schedule   = x.Schedule,
            Price      = x.Price
        }).ToList();

        if (TotalPrice <= 0) TotalPrice = Items.Sum(i => (long)i.Price);
    }

    private async Task<T?> GetJsonOrError<T>(string url)
    {
        try
        {
            using var res = await Http.GetAsync(url);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                _error = $"GET {url} failed {(int)res.StatusCode}: {body}";
                return default;
            }
            return await res.Content.ReadFromJsonAsync<T>();
        }
        catch (Exception ex)
        {
            _error = $"GET {url} error: {ex.Message}";
            return default;
        }
    }

    private string FormatIdr(long value) => string.Format(Indo, "IDR {0:N0}", value);
    private string FormatIdr(decimal value) => string.Format(Indo, "IDR {0:N0}", value);

    public class InvoiceItem
    {
        public int No { get; set; }
        public string CourseName { get; set; } = "";
        public string Type { get; set; } = "";
        public DateTime Schedule { get; set; }
        public decimal Price { get; set; }
    }

    private void Download()
    {
        if (InvoiceId == Guid.Empty)
            return;

        var url = InvoiceService.GetPdfUrl(InvoiceId);
        Navigation.NavigateTo(url, forceLoad: true);
    }




}
