@page "/admin/dashboard"
@layout AdminLayout
@using AutomotiveApp.BlazorUI.Helper
@using AutomotiveApp.Domain.Entities.Courses
@using AutomotiveApp.WebAPI.Dto.Courses
@rendermode InteractiveServer
@inject IDashboardService DashboardService

@* @layout AdminLayout *@


<PageTitle>Dashboard</PageTitle>
<MudPaper Class="m-md-4 d-flex flex-column p-3 gap-3" Style="min-height: 80vh; " Elevation="0">
    <MudText Typo="Typo.h3" Class="mb-3">Welcome, Admin</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="4">
            <MudPaper Class="stat-card stat-red" Elevation="0">
                <div class="stat-left">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle2">Total Online Users</MudText>
                </div>
                <MudText Typo="Typo.h3" Class="stat-value">@TotalActiveUsers</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Class="stat-card stat-blue" Elevation="0">
                <div class="stat-left">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle2">Total Revenue</MudText>
                </div>
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudText Typo="Typo.body2" Class="stat-value">@TotalRevenue</MudText>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert=true>
                    <MudText Typo="Typo.h3" Class="stat-value">@TotalRevenue</MudText>
                </MudHidden>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" lg="4">
            <MudPaper Class="stat-card stat-purple" Elevation="0">
                <div class="stat-left">
                    <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle2">Total Members</MudText>
                </div>
                <MudText Typo="Typo.h3" Class="stat-value">@TotalMembers</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudStack Spacing="2" Class="mb-3">
        <MudSelect T="int" FitContent=true Variant="Variant.Outlined" @bind-Value="SelectedYear" Dense="true">
            @foreach (var year in availableYears)
            {
                <MudSelectItem Value="year">@year</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    <MudGrid Spacing="5" Class="text-center">
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h5">Total revenue per category</MudText>
            <MudPaper Class="pa-4 d-flex justify-content-center">
                <MudChart ChartType="ChartType.Donut" InputData="@revenuePerCategory" InputLabels="@categoryLabels"/>
            </MudPaper>
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h5">Enrolled Users per Course</MudText>
            <MudPaper Class="pa-4 d-flex justify-content-center">
                <MudChart ChartType="ChartType.Donut" InputData="@userPerCourse" InputLabels="@categoryLabels"/>
            </MudPaper>
            </MudStack>
    </MudItem>
    <MudItem xs="12" md="12">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h5">Monthly Revenue</MudText>
            <MudPaper Class="pa-4 d-flex justify-content-center" Style="">
                <MudChart ChartType="ChartType.Line" ChartSeries="@monthlyRevenueSeries" XAxisLabels="@monthLabels" Width="800px" Height="400px" ChartOptions="@lineChartOptions"/>
            </MudPaper>
            </MudStack>
    </MudItem>

    </MudGrid>
    <AdminTable TItem="DashboardTransactionModel" Items="Invoices" Columns="InvoiceColumns" Loading="@_isLoading" />
</MudPaper>


<style>
.stat-card{
    display:flex; 
    justify-content:space-between; 
    align-items:center;
    border-radius:10px; 
    padding:20px 20px;
    height: 90px;
    color:#fff;
    margin-bottom:16px;
    margin-top:2px;
}
.stat-left{ display:flex; gap:12px; align-items:center; }
.stat-value{ font-weight:800; }
.stat-red   { background:#c70e18; }      
.stat-blue  { background:#062b76; }      
.stat-purple{ background:#6a2b7a; }      

.table-responsive{ width:100%; overflow-x:auto; }
.mud-table tbody tr:hover { background-color:#0000000D !important; }
.btn-details {
    border-radius:8px !important;
    text-transform:none !important;
    font-weight:700 !important;
    padding:6px 18px !important;
}
</style>


@code {
    private double[] revenuePerCategory => statistics
        .GroupBy(s => s.Category)
        .Select(g => (double)g.Sum(s => s.TotalRevenue))
        .ToArray();
    
    private double[] userPerCourse => statistics
    .GroupBy(s => s.Category)
    .Select(g => (double)g.Sum(s => s.TotalOrders))
    .ToArray();

    private string[] categoryLabels => statistics
        .Select(s => s.Category ?? "")
        .Distinct()
        .ToArray();

    private string[] monthLabels => Enumerable.Range(1, 12)
        .Select(m => new DateTime(2025, m, 1).ToString("MMM"))
        .ToArray();

    private double totalRevenue => statistics
        .SelectMany(s => s.MonthlySales)
        .Sum(ms => ms.TotalRevenue);
    private int[] availableYears = [];

    private int _selectedYear = DateTime.UtcNow.Year;
    public int SelectedYear
    {
        get => _selectedYear;
        set
        {
            if (_selectedYear != value)
            {
                _selectedYear = value;
                OnYearChanged(value);
            }
        }
    }

    private List<ChartSeries> monthlyRevenueSeries => new List<ChartSeries>
    {
        new ChartSeries
        {
            Name = "Revenue",
            Data = Enumerable.Range(1, 12)
                .Select(month => (double)statistics
                    .SelectMany(s => s.MonthlySales)
                    .Where(ms => ms.Month == month)
                    .Sum(ms => ms.TotalRevenue))
                .ToArray(),
            ShowDataMarkers = true,
        }
    };
    
    private ChartOptions lineChartOptions = new ChartOptions() {
        InterpolationOption = InterpolationOption.Straight,
        LineStrokeWidth = 4,
        YAxisTicks = 1_500_000,
        YAxisFormat = "N0",
        ChartPalette = new string[]
        {
            Colors.Red.Darken3, // first series
        }

    };

    private async void OnYearChanged(int year)
    {
        _selectedYear = year;
        statistics = await DashboardService.GetCourseStatistics(year);
        StateHasChanged();
    }
    private readonly CultureInfo Indo = new("id-ID");

    private string FormatIdr(decimal v) => string.Format(Indo, "IDR {0:N0}", v);

    // Statistik
    private bool _isLoading = true;
    private int TotalActiveUsers;
    private string TotalRevenue = string.Empty;
    private int TotalMembers;
    private List<CourseStatisticDto> statistics = [];
    private List<DashboardTransactionModel> Invoices = new();

    private List<ColumnDefinition<DashboardTransactionModel>> InvoiceColumns => new()
    {
        new ColumnDefinition<DashboardTransactionModel> { Header = "Date", CellTemplate = x => x.Date.ToString("dddd, dd MMM yyyy", new CultureInfo("en-US")), IsSearchable = true },
        new ColumnDefinition<DashboardTransactionModel> { Header = "Email", CellTemplate = x => x.Email, IsSearchable = true },
        new ColumnDefinition<DashboardTransactionModel> { Header = "No. Invoice", CellTemplate = x => x.InvoiceCode, IsSearchable = true },
        new ColumnDefinition<DashboardTransactionModel> { Header = "Total Course", CellTemplate = x => x.TotalCourse.ToString(), IsSearchable = false },
        new ColumnDefinition<DashboardTransactionModel> { Header = "Total Price", CellTemplate = x => FormatIdr(x.TotalPrice), IsSearchable = false },
        new ColumnDefinition<DashboardTransactionModel> { Header = "Action", IsActionColumn = true, ShowDetails = true }
    };

    protected override async Task OnInitializedAsync()
    {
        await RetryHelper.ExecuteWithRetryAsync(
        action: () => LoadDashboardAsync(),
        onLoadingChanged: (loading) => _isLoading = loading,
        maxAttempts: 5,
        delayMs: 100
        );
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            var overview = await DashboardService.GetOverview();
            statistics = await DashboardService.GetCourseStatistics(null);
            availableYears = statistics
            .SelectMany(s => s.MonthlySales)
            .Select(ms => ms.Year)
            .Distinct()
            .OrderByDescending(y => y)
            .ToArray();

            if (overview != null)
            {
                TotalActiveUsers = overview.ActiveUsers;
                TotalRevenue = string.Format(Indo, "{0:N0}", overview.TotalRevenue);
                TotalMembers = overview.TotalUsers;
            }
            else
            {
                TotalActiveUsers = 0;
                TotalRevenue = "0";
                TotalMembers = 0;
            }

            var rows = await DashboardService.GetDashboardTransactions();
            Invoices = rows.Select(x => new DashboardTransactionModel
                {
                    UserName = x.UserName,
                    Email = x.Email,
                    InvoiceCode = x.InvoiceCode,
                    Date = x.CreatedAt,
                    TotalCourse = x.CourseCount,
                    TotalPrice = x.TotalPrice,
                    PaymentMethodName = x.PaymentMethodName,
                }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] Failed to load: {ex.Message}");
            TotalActiveUsers = 0;
            TotalRevenue = "0";
            TotalMembers = 0;
            Invoices = new List<DashboardTransactionModel>();
        }
    }
}
