@page "/admin/course"
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject HttpClient Http
@inject ICourseService CourseSvc
@inject ICourseCategoryService CategorySvc
@inject ICourseSessionService CourseSessionSvc
@using AutomotiveApp.Shared.Dtos.Courses
@using AutomotiveApp.BlazorUI.Models.Admin
@inject ISnackbar Snackbar

@layout AdminLayout

<PageTitle>Course Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">Course Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" OnClick="ShowAddCourseDialog"  Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add Course</AppBaseButton>
    <AdminTable TItem="CourseViewModel" Items="courses" Columns="courseColumns" OnEdit="OnCourseEdited" />
</MudPaper>

@code {
    private List<CourseViewModel> courses = new();
    private readonly Dictionary<Guid, string> _catMap = new();

    private List<ColumnDefinition<CourseViewModel>> courseColumns = new()
    {
        new ColumnDefinition<CourseViewModel>
        {
            Header = "ID",
            CellTemplate = x => x.ID,
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Course Name",
            CellTemplate = x => x.Name,
            IsSearchable = true
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Description",
            CellTemplate = x => x.Description,
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Price",
            CellTemplate = course => $"IDR {course.Price.ToString("N0", new CultureInfo("id-ID"))}",
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Category",
            CellTemplate = x => x.Category,
            IsSearchable = true
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Date",
            CellTemplate = x => x.Schedule?.ToString("dd MMM yyyy") ?? "-",
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Capacity",
            CellTemplate = x => x.Capacity.ToString(),
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Image",
            CellTemplate = x => x.Image,
            IsImageColumn = true,
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Action",
            CellTemplate = _ => "Edit",
            IsSearchable = false,
            IsActionColumn = true,
            ShowEdit = true
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var cats = await CategorySvc.GetAllAsync();
        foreach (var c in cats)
            _catMap[c.Id] = c.Name ?? "-";

        await ReloadList();
    }


    private async Task ReloadList()
    {
        // courses
        var res = await CourseSvc.GetAllAsync();
        var rows = res.Data ?? Enumerable.Empty<CourseQueryDto>();

        // sessions
        var sessRes = await CourseSessionSvc.GetAllAsync();
        var allSessions = sessRes.Data ?? Enumerable.Empty<CourseSessionQueryDto>();

        // mapping peta CourseId -> (Date, Capacity) 
        var now = DateTime.UtcNow;
        var chosenSession = allSessions
            .GroupBy(s => s.CourseId)
            .Select(g =>
            {
                var upcoming = g.Where(s => s.Date >= now)
                                .OrderBy(s => s.Date)
                                .FirstOrDefault();
                var picked = upcoming ?? g.OrderByDescending(s => s.Date).FirstOrDefault();
                return new
                {
                    CourseId = g.Key,
                    Date = picked?.Date,
                    Capacity = picked?.Capacity
                };
            })
            .ToDictionary(x => x.CourseId, x => (x.Date, x.Capacity));

        // mapping ke VM
        courses = rows
            .OrderByDescending(x => x.CreatedAt)
            .Select((x, idx) =>
            {
                DateTime? sched = null;
                uint cap = 0;

                if (chosenSession.TryGetValue(x.Id, out var s))
                {
                    sched = s.Date;
                    cap = s.Capacity ?? 0u;
                }

                return new CourseViewModel
                {
                    ID          = idx + 1,
                    CourseId    = x.Id,
                    Name        = x.Name,
                    Description = x.Description ?? string.Empty,
                    Price       = x.Price,
                    CategoryId  = x.CategoryId,
                    Category    = _catMap.TryGetValue(x.CategoryId, out var catName) ? catName : "-",
                    Image       = ResolveImageUrl(x.ImageUrl),
                    Schedule    = sched,        
                    Capacity    = cap
                };
            })
            .ToList();

        StateHasChanged();
    }

    private string ResolveImageUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "/images/course/placeholder.svg";

        var v = value.Trim();
        if (v.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return v;
        if (v.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
            return v;

        var api = Http.BaseAddress?.ToString()?.TrimEnd('/');
        return $"{api}/images/Course/{v}";
    }

    private async Task ShowAddCourseDialog()
    {
        var parameters = new DialogParameters
        {
            { "Categories", _catMap } 
        };

        var dlg = await DialogService.ShowAsync<AddCourseDialog>("Add Course", parameters);
        var result = await dlg.Result;

        if (result is not { Canceled: false, Data: CourseViewModel vm })
            return;

        try
        {
            Guid? id = await CourseSvc.CreateMultipartAsync(
                vm.Name,
                vm.Description ?? string.Empty,
                vm.Price,
                vm.CategoryId,
                vm.File
            );

            if (id is null)
            {
                Snackbar.Add("Course add failed", Severity.Error);
                return;
            }

            @* Save to CourseSession *@
            if (vm.Schedule is DateTime date && vm.Capacity is uint cap && cap > 0)
            {
                var okId = await CourseSessionSvc.CreateAsync(new()
                {
                    Date = date,
                    Capacity = cap,
                    CourseId = id.Value
                });

                if (okId is null)
                    Snackbar.Add("Course Saved, But Create Session Failed", Severity.Warning);
            }

            await ReloadList();
            Snackbar.Add("Course added successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Course add failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnCourseEdited(CourseViewModel vm)
    {
        try
        {
            var ok = await CourseSvc.UpdateMultipartAsync(
                vm.CourseId,
                vm.Name,
                vm.Description,
                vm.Price,
                vm.CategoryId,
                vm.File
            );

            if (!ok)
            {
                Snackbar.Add("Course update failed", Severity.Error);
                return;
            }


            // course session update
            if (vm.Schedule is DateTime date && vm.Capacity is uint cap && cap > 0)
            {
                var okId = await CourseSessionSvc.CreateAsync(new()
                {
                    Date = date,
                    Capacity = cap,
                    CourseId = vm.CourseId
                });

                if (okId is null)
                    Snackbar.Add("Course Succesfully Updated, But Updated Course Session Failed", Severity.Warning);
            }


            // refresh baris + gambar (cache-busting)
            var row = courses.FirstOrDefault(c => c.CourseId == vm.CourseId);
            if (row is not null)
            {
                row.Name       = vm.Name;
                row.Description= vm.Description ?? string.Empty;
                row.Price      = vm.Price;
                row.CategoryId = vm.CategoryId;
                row.Category   = _catMap.TryGetValue(vm.CategoryId, out var catName) ? catName : row.Category;

                if (vm.File is not null)
                {
                    var baseUrl = Http.BaseAddress?.ToString()?.TrimEnd('/');
                    var ext = Path.GetExtension(vm.File.Name);
                    row.Image = $"{baseUrl}/images/Course/{vm.CourseId}{ext}?t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
                }
            }

            StateHasChanged();
            Snackbar.Add("Course updated successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Course update failed: {ex.Message}", Severity.Error);
        }
    }
}
