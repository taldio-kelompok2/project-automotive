@page "/admin/course"
@rendermode InteractiveServer
@using Enums
@inject IDialogService DialogService

@layout AdminLayout

<PageTitle>Course Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">Course Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" OnClick="ShowAddCourseDialog"  Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add Course</AppBaseButton>
    <AdminTable TItem="CourseViewModel" Items="courses" Columns="courseColumns" OnEdit="OnCourseEdit" />
</MudPaper>

@code {

    private List<CourseViewModel> courses = new()
{
        new CourseViewModel { Name = "Basic Driving Course", Price = 299, Category = CarCategory.Sedan, Status = Status.Active, Image="basic.png", Schedule=DateTime.Today },
        new CourseViewModel { Name = "Advanced Driving Techniques", Price = 499, Category = CarCategory.SUV, Status = Status.Active, Image="advanced.png" },
        new CourseViewModel { Name = "Defensive Driving", Price = 399, Category = CarCategory.Sedan, Status = Status.Active, Image="defensive.png" },
        new CourseViewModel { Name = "Motorcycle Safety Course", Price = 349, Category = CarCategory.SUV, Status = Status.Inactive, Image="motorcycle.png" },
        new CourseViewModel { Name = "Commercial License Training", Price = 899, Category = CarCategory.Truck, Status = Status.Active, Image="commercial.png" },
        new CourseViewModel { Name = "Eco Driving Course", Price = 329, Category = CarCategory.Hatchback, Status = Status.Inactive, Image="eco.png" },
        new CourseViewModel { Name = "Off-Road Adventure Driving", Price = 599, Category = CarCategory.SUV, Status = Status.Active, Image="offroad.png" }
    };

    List<ColumnDefinition<CourseViewModel>> courseColumns = new()
{
    new ColumnDefinition<CourseViewModel>
    {
        Header = "Course Name",
        CellTemplate = course => @course.Name,
        IsSearchable = true,
    },
    new ColumnDefinition<CourseViewModel>
    {
        Header = "Price",
        CellTemplate = course => @course.Price.ToString("C2"),
        IsSearchable = false,
    },
    new ColumnDefinition<CourseViewModel>
    {
        Header = "Category",
        CellTemplate = course => @course.Category,
        IsSearchable = true,
    },
    new ColumnDefinition<CourseViewModel>
    {
        Header = "Status",
        CellTemplate = course => @course.Status,
        IsSearchable = true,
        IsStatusColumn = true,
    },
    new ColumnDefinition<CourseViewModel>
    {
        Header = "Action",
        CellTemplate = course => "Edit",
        IsSearchable = false,
        IsActionColumn = true,
        ShowEdit = true
    }
};

    private async Task ShowAddCourseDialog()
    {
        var dialog = DialogService.Show<AddCourseDialog>("Add Course");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CourseViewModel newCourse)
        {
            courses.Add(newCourse);
            StateHasChanged();
        }
    }

    private async Task OnCourseEdit(CourseViewModel course)
    {
        var index = courses.FindIndex(c => c.Name == course.Name);
        if (index >= 0)
        {
            courses[index] = course;
            StateHasChanged();
        }
    }
}
