@page "/admin/course"
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject HttpClient Http
@inject ICourseService CourseSvc
@inject ICourseCategoryService CategorySvc
@inject ICourseSessionService CourseSessionSvc
@using AutomotiveApp.Shared.Dtos.Courses
@using AutomotiveApp.BlazorUI.Models.Admin
@inject ISnackbar Snackbar
@using System.Globalization

@layout AdminLayout

<PageTitle>Course Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">Course Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" OnClick="ShowAddCourseDialog"  Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add Course</AppBaseButton>
    <AdminTable TItem="CourseViewModel" Items="courses" Columns="courseColumns" OnEdit="OnCourseEdited" OnDetails="OnCourseDetails"  />
</MudPaper>

<style>
  .mud-dialog-content td:nth-child(2) { white-space: pre-line; }
</style>

@code {
    private List<CourseViewModel> courses = new();
    private readonly Dictionary<Guid, string> _catMap = new();

    private List<ColumnDefinition<CourseViewModel>> courseColumns = new()
    {
        new ColumnDefinition<CourseViewModel>
        {
            Header = "ID",
            CellTemplate = x => x.ID,
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Course Name",
            CellTemplate = x => x.Name,
            IsSearchable = true
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Description",
            CellTemplate = x => x.Description,
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Price",
            CellTemplate = course => $"IDR {course.Price.ToString("N0", new CultureInfo("id-ID"))}",
            IsSearchable = false
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Category",
            CellTemplate = x => x.Category,
            IsSearchable = true
        },
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Image",
            CellTemplate = x => x.Image,
            IsImageColumn = true,
            IsSearchable = false
        },
        @* new ColumnDefinition<CourseViewModel>
        {
            Header = "Detail",
            CellTemplate = _ => "Detail",
            IsSearchable = false,
            IsActionColumn = true,
            ShowDetails = true,
        }, *@
        new ColumnDefinition<CourseViewModel>
        {
            Header = "Action",
            @* CellTemplate = _ => "Edit", *@
            IsSearchable = false,
            IsActionColumn = true,
            ShowEdit = true,
            ShowDetails = true,
        }
    };


    protected override async Task OnInitializedAsync()
    {
        var cats = await CategorySvc.GetAllAsync();
        foreach (var c in cats)
            _catMap[c.Id] = c.Name ?? "-";

        await ReloadList();
    }


    private async Task ReloadList()
    {
        // courses
        var res = await CourseSvc.GetAllAsync();
        var rows = res.Data ?? Enumerable.Empty<CourseQueryDto>();

        // sessions
        var sessRes = await CourseSessionSvc.GetAllAsync();
        var allSessions = sessRes.Data ?? Enumerable.Empty<CourseSessionQueryDto>();

        // sessions per course
        var sessionsByCourse = allSessions
            .GroupBy(s => s.CourseId)
            .ToDictionary(
                g => g.Key,
                g => g.OrderBy(s => s.Date).ToList()
            );

        var idID = new CultureInfo("id-ID");

        // mapping ke VM + buat dialog view
        courses = rows
            .OrderByDescending(x => x.CreatedAt)
            .Select((x, idx) =>
            {
                // ringkasan jadwal 
                DateTime? sched = null;
                uint cap = 0;

                // view dialog sessions
                string sessionsText = "-";
                if (sessionsByCourse.TryGetValue(x.Id, out var list) && list.Count > 0)
                {
                    var enUS = new CultureInfo("en-US");
                    sessionsText = string.Join(Environment.NewLine,
                        list.Select((it, i) =>
                            $"{i + 1}) {it.Date.ToLocalTime().ToString("dddd, dd MMM yyyy", enUS)} - Capacity {it.Capacity}"
                        )
                    );

                    // pick 1 utk ringkasan di tabel utama 
                    var first = list[0];
                    sched = first.Date;
                    cap = first.Capacity;
                }

                return new CourseViewModel
                {
                    ID          = idx + 1,
                    CourseId    = x.Id,
                    Name        = x.Name,
                    Description = x.Description ?? string.Empty,
                    Price       = x.Price,
                    CategoryId  = x.CategoryId,
                    Category    = _catMap.TryGetValue(x.CategoryId, out var catName) ? catName : "-",
                    Image       = ResolveImageUrl(x.ImageUrl),
                    Schedule    = sched,
                    Capacity    = cap,
                    Session     = sessionsText
                };
            })
            .ToList();

        StateHasChanged();
    }


    private string ResolveImageUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "/images/course/placeholder.svg";

        var v = value.Trim();
        if (v.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return v;
        if (v.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
            return v;

        var api = Http.BaseAddress?.ToString()?.TrimEnd('/');
        return $"{api}/images/Course/{v}";
    }

    private async Task ShowAddCourseDialog()
    {
        var parameters = new DialogParameters
        {
            { "Categories", _catMap } 
        };

        var dlg = await DialogService.ShowAsync<AddCourseDialog>("Add Course", parameters);
        var result = await dlg.Result;

        if (result is not { Canceled: false, Data: CourseViewModel vm })
            return;

        try
        {
            Guid? id = await CourseSvc.CreateMultipartAsync(
                vm.Name,
                vm.Description ?? string.Empty,
                vm.Price,
                vm.CategoryId,
                vm.File
            );

            if (id is null)
            {
                Snackbar.Add("Course add failed", Severity.Error);
                return;
            }

            // save to CourseSession
            if (vm.Sessions is { Count: > 0 })
            {
                foreach (var s in vm.Sessions)
                {
                    // hanya buat baris valid
                    if (s.Capacity > 0)
                    {
                        var okId = await CourseSessionSvc.CreateAsync(new()
                        {
                            Date = s.Date.Value, 
                            Capacity = s.Capacity,
                            CourseId = id.Value
                        });

                        if (okId is null)
                            Snackbar.Add($"Session {s.Date:dd MMM yyyy} failed to create", Severity.Warning);
                    }
                }
            }

            await ReloadList();
            Snackbar.Add("Course added successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Course add failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnCourseEdited(CourseViewModel vm)
    {
        try
        {
            // update data course 
            var ok = await CourseSvc.UpdateMultipartAsync(
                vm.CourseId,
                vm.Name,
                vm.Description,
                vm.Price,
                vm.CategoryId,
                vm.File
            );

            if (!ok)
            {
                Snackbar.Add("Course update failed", Severity.Error);
                return;
            }

            // update CourseSession sesuai jadwal & kapasitas
            var currentRes = await CourseSessionSvc.GetAllAsync();
            var current = (currentRes.Data ?? Enumerable.Empty<CourseSessionQueryDto>())
                            .Where(s => s.CourseId == vm.CourseId)
                            .ToList();
            var currentById = current.ToDictionary(x => x.Id, x => x);

            // Id yang datang dari dialog (yang existing)
            var incoming = vm.Sessions;
            var incomingExistingIds = incoming.Where(x => x.Id.HasValue)
                                            .Select(x => x.Id!.Value)
                                            .ToHashSet();

            // delete
            foreach (var c in current)
            {
                if (!incomingExistingIds.Contains(c.Id))
                {
                    var deleted = await CourseSessionSvc.DeleteAsync(c.Id);
                    if (!deleted)
                        Snackbar.Add($"Failed to delete session {c.Date:dd MMM yyyy}", Severity.Warning);
                }
            }

            // upsert
            foreach (var s in incoming)
            {
                if (s.Id is null)
                {
                    // create 
                    if (s.Capacity > 0)
                    {
                        var createdId = await CourseSessionSvc.CreateAsync(new()
                        {
                            Date = s.Date.Value,
                            Capacity = s.Capacity,
                            CourseId = vm.CourseId
                        });

                        if (createdId is null)
                            Snackbar.Add($"Failed to create session {s.Date:dd MMM yyyy}", Severity.Warning);
                    }
                }
                else
                {
                    // upodate 
                    var old = currentById[s.Id.Value];
                    var oldCap = old.Capacity;
                    if (old.Date != s.Date || oldCap != s.Capacity)
                    {
                        var updated = await CourseSessionSvc.UpdateAsync(
                            s.Id.Value,
                            new()
                            {
                                Date = s.Date.Value,
                                Capacity = s.Capacity,
                                CourseId = vm.CourseId
                            });

                        if (!updated)
                            Snackbar.Add($"Failed to update session {s.Date:dd MMM yyyy}", Severity.Warning);
                    }
                }
            }


            // refresh data + gambar
            var row = courses.FirstOrDefault(c => c.CourseId == vm.CourseId);
            if (row is not null)
            {
                row.Name        = vm.Name;
                row.Description = vm.Description ?? string.Empty;
                row.Price       = vm.Price;
                row.CategoryId  = vm.CategoryId;
                row.Category    = _catMap.TryGetValue(vm.CategoryId, out var catName) ? catName : row.Category;

                var orderedSessions = (vm.Sessions ?? new())
                    .Where(s => s.Date.HasValue && s.Capacity > 0)
                    .OrderBy(s => s.Date)
                    .ToList();

                var first = orderedSessions.FirstOrDefault();
                row.Schedule = first?.Date;
                row.Capacity = (uint)(first?.Capacity ?? 0);

                var enUS = new CultureInfo("en-US");
                row.Session = orderedSessions.Count == 0
                    ? "-"
                    : string.Join(Environment.NewLine,
                        orderedSessions.Select((it, i) =>
                            $"{i + 1}) {it.Date!.Value.ToLocalTime():dddd, dd MMM yyyy} - Capacity {it.Capacity}"
                        ));

                if (vm.File is not null)
                {
                    var baseUrl = Http.BaseAddress?.ToString()?.TrimEnd('/');
                    var ext = Path.GetExtension(vm.File.Name);
                    row.Image = $"{baseUrl}/images/Course/{vm.CourseId}{ext}?t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
                }
            }

            courses = courses.ToList();
            await InvokeAsync(StateHasChanged);
            Snackbar.Add("Course updated successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Course update failed: {ex.Message}", Severity.Error);
        }
    }


    private static CourseSessionQueryDto? PickEditableSession(IEnumerable<CourseSessionQueryDto> sessions)
    {
        var now = DateTime.UtcNow;

        var upcoming = sessions
            .Where(s => s.Date >= now)
            .OrderBy(s => s.Date)
            .FirstOrDefault();

        return upcoming ?? sessions
            .OrderByDescending(s => s.Date)
            .FirstOrDefault();
    }

    private async Task OnCourseDetails(CourseViewModel course)
    {
        var sessRes = await CourseSessionSvc.GetAllAsync();
        var sessions = (sessRes.Data ?? Enumerable.Empty<CourseSessionQueryDto>())
                        .Where(s => s.CourseId == course.CourseId)
                        .OrderBy(s => s.Date)
                        .ToList();

        var parameters = new DialogParameters
        {
            { "Course", course },
            { "Sessions", sessions }
        };

        await DialogService.ShowAsync<ViewCourseSessionsDialog>(
            $"Sessions — {course.Name}", parameters);
    }

    

    
    





}
