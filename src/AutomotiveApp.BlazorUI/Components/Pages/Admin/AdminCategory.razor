@page "/admin/category"
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject HttpClient Http
@inject ICourseCategoryService CategorySvc
@using AutomotiveApp.Shared.Dtos.Courses
@using AutomotiveApp.BlazorUI.Models.Admin
@using AutomotiveApp.Shared.Enums
@inject ISnackbar Snackbar

@layout AdminLayout

<PageTitle>Category Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">Category Management</MudText>

    <AppBaseButton Width="ButtonWidth.Short" OnClick="ShowAddCategoryDialog" Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add Category</AppBaseButton>
    
    <AdminTable TItem="CategoryViewModel" Items="categories" Columns="categoryColumns" OnEdit="OnCategoryEdited" />
</MudPaper>

@code {
    private List<CategoryViewModel> categories = new();

    private static string Norm(string? s) => (s ?? "").Trim().ToUpperInvariant();

    @* private List<CategoryViewModel> categories = new()
    {
        new CategoryViewModel { Name = "Beginner", Status = Status.Active },
        new CategoryViewModel { Name = "Advanced", Status = Status.Active },
        new CategoryViewModel { Name = "Safety", Status = Status.Active },
        new CategoryViewModel { Name = "Motorcycle", Status = Status.Inactive },
        new CategoryViewModel { Name = "Commercial", Status = Status.Active },
        new CategoryViewModel { Name = "Seasonal", Status = Status.Active },
        new CategoryViewModel { Name = "Skills", Status = Status.Active },
        new CategoryViewModel { Name = "Eco-Friendly", Status = Status.Inactive },
        new CategoryViewModel { Name = "Performance", Status = Status.Active },
        new CategoryViewModel { Name = "Adventure", Status = Status.Active },
        new CategoryViewModel { Name = "Defensive Driving", Status = Status.Active },
        new CategoryViewModel { Name = "Night Driving", Status = Status.Inactive },
        new CategoryViewModel { Name = "Emergency Maneuvers", Status = Status.Active }
    }; *@

    private List<ColumnDefinition<CategoryViewModel>> categoryColumns = new()
    {
        new ColumnDefinition<CategoryViewModel>
        {
            Header = "ID",
            CellTemplate = category => @category.ID,
            IsSearchable = true
        },
        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Category Name",
            CellTemplate = category => @category.Name,
            IsSearchable = true
        },

        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Description",
            CellTemplate = category => @category.Description,
            IsSearchable = true
        },

        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Image",
            CellTemplate = category => @category.Logo,
            IsImageColumn = true,
            IsSearchable = false
        },
        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Hero",
            CellTemplate = category => @category.Hero,
            IsImageColumn = true,
            IsSearchable = false
        },
        @* new ColumnDefinition<CategoryViewModel>
        {
            Header = "Status",
            CellTemplate = category => @category.Status,
            IsSearchable = true,
            IsStatusColumn = true
        }, *@
        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Action",
            CellTemplate = category => "Edit",
            IsSearchable = false,
            IsActionColumn = true,
            ShowEdit = true
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var res = await CategorySvc.GetAllAsync(); 

        categories = res
            .OrderByDescending(x => x.CreatedAt)
            .Select((x, idx) => new CategoryViewModel
            {
                ID          = idx + 1,
                CategoryId  = x.Id,
                Name        = x.Name,
                Description = x.Description ?? "",
                Logo        = ResolveLogoUrl(x.ImageUrl), 
                Hero        = ResolveHeroUrl(x.HeroImageUrl)
                @* Status = Status.Active *@
            })
            .ToList();
    }

    private string ResolveLogoUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "/images/coursecategory/placeholder.svg";

        var v = value.Trim();
        if (v.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return v;
        if (v.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
            return v;

        var api = Http.BaseAddress?.ToString()?.TrimEnd('/');
        return $"{api}/images/CourseCategory/{v}";
    }

    private string ResolveHeroUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "/images/coursecategory/placeholder-hero.svg"; 

        var v = value.Trim();
        if (v.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return v;
        if (v.StartsWith("/images/", StringComparison.OrdinalIgnoreCase))
            return v;

        var api = Http.BaseAddress?.ToString()?.TrimEnd('/');
        return $"{api}/images/CourseCategory/{v}";
    }

    private bool CategoryNameExists(string name, Guid? excludeId = null)
    {
        var key = Norm(name);
        return categories.Any(x =>
            Norm(x.Name) == key &&
            (excludeId == null || x.CategoryId != excludeId.Value));
    }

    private async Task ReloadList()
    {
        var rows = await CategorySvc.GetAllAsync();
        categories = rows
             .OrderByDescending(x => x.CreatedAt)
            .Select((x, idx) => new CategoryViewModel
            {
                ID          = idx + 1,
                CategoryId  = x.Id,
                Name        = x.Name,
                Description = x.Description ?? "",
                Logo        = ResolveLogoUrl(x.ImageUrl), 
                Hero        = ResolveHeroUrl(x.HeroImageUrl),
                @* Status = Status.Active *@
            })
            .ToList();
        StateHasChanged();
    }

    private async Task ShowAddCategoryDialog()
    {
        var dialog = await DialogService.ShowAsync<AddCategoryDialog>("Add Category");
        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: CategoryViewModel vm })
            return;
        
        // cek duplikasi name
        if (CategoryNameExists(vm.Name))
        {
            Snackbar.Add($"Category '{vm.Name}' already exists.", Severity.Error);
            return;
        }

        try
        {
            // file null tetap kirim tanpa file.
            Guid? id;
            if (vm.File is null && vm.HeroFile is null)
            {
                id = await CategorySvc.CreateMultipartAsync(
                    vm.Name, 
                    vm.Description, 
                    vm.File,
                    vm.HeroFile
                );
            }
            else
            {
                id = await CategorySvc.CreateMultipartAsync(vm.Name, vm.Description, vm.File, vm.HeroFile); 
            }

            if (id is null)
            {
                Snackbar.Add("Category Added Failed", Severity.Error);
                return;
            }

            await ReloadList();
            Snackbar.Add("Category Added Successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Category Added Failed : {ex.Message}", Severity.Error);
        }
    }

    private async Task OnCategoryEdited(CategoryViewModel vm)
    {
        // cek duplikasi name
        if (CategoryNameExists(vm.Name, vm.CategoryId))
        {
            Snackbar.Add($"Category '{vm.Name}' already exists.", Severity.Error);
            return;
        }

        try
        {
            var ok = await CategorySvc.UpdateMultipartAsync(
                vm.CategoryId,
                vm.Name,
                vm.Description,
                vm.File,
                vm.HeroFile
            );

            if (!ok)
            {
                Snackbar.Add("Category Added Failed", Severity.Error);
                return;
            }

            // supaya gambar langsung ke-refresh di tabel
            var row = categories.FirstOrDefault(c => c.CategoryId == vm.CategoryId);
            if (row is not null)
            {
                row.Name        = vm.Name;
                row.Description = vm.Description;

                if (vm.File is not null)
                {
                    var baseUrl = Http.BaseAddress?.ToString()?.TrimEnd('/');
                    var ext = Path.GetExtension(vm.File.Name);
                    row.Logo = $"{baseUrl}/images/CourseCategory/{vm.CategoryId}{ext}?t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
                }
                
                if (vm.HeroFile is not null)
                {
                    var baseUrl = Http.BaseAddress?.ToString()?.TrimEnd('/');
                    var ext = Path.GetExtension(vm.HeroFile.Name);
                    row.Hero = $"{baseUrl}/images/CourseCategory/{vm.CategoryId}-hero{ext}?t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
                }
            }

            StateHasChanged();
            Snackbar.Add("Category Updated Successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Category Added Failed : {ex.Message}", Severity.Error);
        }
    }

}