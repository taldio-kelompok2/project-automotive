@page "/admin/category"
@rendermode InteractiveServer

@layout AdminLayout

<PageTitle>Category Management</PageTitle>

<MudPaper Class="m-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">Category Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add Course</AppBaseButton>
    <AdminTable TItem="Category" Items="categories" Columns="categoryColumns" OnEdit="OnCategoryEdit" />
</MudPaper>

@code {
    public class Category
    {
        public required string Name { get; set; }
        public required string Status { get; set; }
    }

    private List<Category> categories = new()
    {
        new Category { Name = "Beginner", Status = "Active" },
        new Category { Name = "Advanced", Status = "Active" },
        new Category { Name = "Safety", Status = "Active" },
        new Category { Name = "Motorcycle", Status = "Inactive" },
        new Category { Name = "Commercial", Status = "Active" },
        new Category { Name = "Seasonal", Status = "Active" },
        new Category { Name = "Skills", Status = "Active" },
        new Category { Name = "Eco-Friendly", Status = "Inactive" },
        new Category { Name = "Performance", Status = "Active" },
        new Category { Name = "Adventure", Status = "Active" },
        new Category { Name = "Defensive Driving", Status = "Active" },
        new Category { Name = "Night Driving", Status = "Inactive" },
        new Category { Name = "Emergency Maneuvers", Status = "Active" }
    };

    List<ColumnDefinition<Category>> categoryColumns = new()
    {
        new ColumnDefinition<Category>
        {
            Header = "Category Name",
            CellTemplate = category => @category.Name,
            IsSearchable = true
        },
        new ColumnDefinition<Category>
        {
            Header = "Status",
            CellTemplate = category => @category.Status,
            IsSearchable = true,
            IsStatusColumn = true
        },
        new ColumnDefinition<Category>
        {
            Header = "Action",
            CellTemplate = category => "Edit",
            IsSearchable = false,
            IsActionColumn = true,
            ShowEdit = true
        }
    };

    private void OnCategoryEdit(Category category)
    {
        // TODO: Handle edit logic
        Console.WriteLine($"Editing category: {category.Name}");
    }
}