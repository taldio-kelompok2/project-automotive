@page "/admin/category"
@rendermode InteractiveServer
@inject IDialogService DialogService

@layout AdminLayout

<PageTitle>Category Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">Category Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" OnClick="ShowAddCategoryDialog" Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add Category</AppBaseButton>
    <AdminTable TItem="CategoryViewModel" Items="categories" Columns="categoryColumns" OnEdit="OnCategoryEdit" />
</MudPaper>

@code {
    private List<CategoryViewModel> categories = new()
    {
        new CategoryViewModel { Name = "Beginner", Status = Status.Active },
        new CategoryViewModel { Name = "Advanced", Status = Status.Active },
        new CategoryViewModel { Name = "Safety", Status = Status.Active },
        new CategoryViewModel { Name = "Motorcycle", Status = Status.Inactive },
        new CategoryViewModel { Name = "Commercial", Status = Status.Active },
        new CategoryViewModel { Name = "Seasonal", Status = Status.Active },
        new CategoryViewModel { Name = "Skills", Status = Status.Active },
        new CategoryViewModel { Name = "Eco-Friendly", Status = Status.Inactive },
        new CategoryViewModel { Name = "Performance", Status = Status.Active },
        new CategoryViewModel { Name = "Adventure", Status = Status.Active },
        new CategoryViewModel { Name = "Defensive Driving", Status = Status.Active },
        new CategoryViewModel { Name = "Night Driving", Status = Status.Inactive },
        new CategoryViewModel { Name = "Emergency Maneuvers", Status = Status.Active }
    };

    List<ColumnDefinition<CategoryViewModel>> categoryColumns = new()
    {
        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Category Name",
            CellTemplate = category => @category.Name,
            IsSearchable = true
        },
        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Status",
            CellTemplate = category => @category.Status,
            IsSearchable = true,
            IsStatusColumn = true
        },
        new ColumnDefinition<CategoryViewModel>
        {
            Header = "Action",
            CellTemplate = category => "Edit",
            IsSearchable = false,
            IsActionColumn = true,
            ShowEdit = true
        }
    };

    private async Task ShowAddCategoryDialog()
    {
        var dialog = await DialogService.ShowAsync<AddCategoryDialog>("Add Category");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CategoryViewModel newCategory)
        {
            categories.Add(newCategory);
            StateHasChanged();
        }
    }

    private void OnCategoryEdit(CategoryViewModel category)
    {
        var idx = categories.FindIndex(c => c.Name == category.Name);
        if (idx >= 0)
        {
            categories[idx] = category;
            StateHasChanged();
        }
    }
}