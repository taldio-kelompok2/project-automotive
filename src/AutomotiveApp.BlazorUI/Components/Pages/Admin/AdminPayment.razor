@page "/admin/payment-method"
@rendermode InteractiveServer

@layout AdminLayout

<PageTitle>Payment Method Management</PageTitle>

<MudPaper Class="m-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">Payment Method Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add Payment Method</AppBaseButton>
    <AdminTable TItem="PaymentMethod" Items="paymentMethods" Columns="paymentMethodColumns" OnEdit="OnPaymentMethodEdit" />
</MudPaper>

@code {
    public class PaymentMethod
    {
        public required int ID { get; set; }
        public required string Name { get; set; }
        public required string LogoUrl { get; set; }
        public required string Status { get; set; }
    }

    private List<PaymentMethod> paymentMethods = new()
    {
        new PaymentMethod { ID = 1, Name = "DANA", LogoUrl = "/images/payment/dana.svg", Status = "Active" },
        new PaymentMethod { ID = 2, Name = "GoPay", LogoUrl = "/images/payment/gopay.svg", Status = "Active" },
        new PaymentMethod { ID = 3, Name = "BCA", LogoUrl = "/images/payment/bca.svg", Status = "Active" },
        new PaymentMethod { ID = 4, Name = "BRI", LogoUrl = "/images/payment/bri.svg", Status = "Active" },
        new PaymentMethod { ID = 5, Name = "Mandiri", LogoUrl = "/images/payment/mandiri.svg", Status = "Active" },
        new PaymentMethod { ID = 6, Name = "OVO", LogoUrl = "/images/payment/ovo.svg", Status = "Active" },
        new PaymentMethod { ID = 7, Name = "BNI", LogoUrl = "/images/payment/bni.svg", Status = "Active" },
        new PaymentMethod { ID = 8, Name = "PayPal", LogoUrl = "/images/payment/paypal.svg", Status = "Active" }
    };

    List<ColumnDefinition<PaymentMethod>> paymentMethodColumns = new()
    {
        new ColumnDefinition<PaymentMethod>
        {
            Header = "ID",
            CellTemplate = pm => pm.ID,
            IsSearchable = false
        },
        new ColumnDefinition<PaymentMethod>
        {
            Header = "Name",
            CellTemplate = pm => pm.Name,
            IsSearchable = true
        },
        new ColumnDefinition<PaymentMethod>
        {
            Header = "Logo",
            CellTemplate = pm => pm.LogoUrl,
            IsSearchable = false,
            IsImageColumn = true
        },
        new ColumnDefinition<PaymentMethod>
        {
            Header = "Status",
            CellTemplate = pm => pm.Status,
            IsSearchable = true,
            IsStatusColumn = true
        },
        new ColumnDefinition<PaymentMethod>
        {
            Header = "Action",
            CellTemplate = pm => "Edit",
            IsSearchable = false,
            IsActionColumn = true,
            ShowEdit = true
        }
    };

    private void OnPaymentMethodEdit(PaymentMethod paymentMethod)
    {
        // TODO: Handle edit logic
        Console.WriteLine($"Editing payment method: {paymentMethod.Name}");
    }
}