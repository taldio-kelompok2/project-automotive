@page "/admin/invoice"
@rendermode InteractiveServer
@layout AdminLayout

@using System.Globalization
@using System.Net.Http.Json
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel
@inject IDialogService DialogService
@inject HttpClient Http

<PageTitle>Invoice Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-3">Invoice Management</MudText>
    
    <AdminTable TItem="Invoice" Items="invoices" Columns="invoiceColumns" OnDetails="OnInvoiceDetails" />
</MudPaper>

<style>
  .mud-dialog-content td:nth-child(2) { white-space: pre-line; }
</style>

@code {
    private record ApiInvoiceDto(
        Guid Id,
        long TotalPrice,
        int InvoiceNumber,
        string InvoiceCode,
        Guid OrderId,
        DateTime CreatedAt
    );

    private record InvoiceDetailsDto(
        Guid Id, 
        string InvoiceCode, 
        DateTime CreatedAt, 
        long TotalPrice, 
        List<InvoiceItemDto> Items
    );
    private record InvoiceItemDto(
        string CourseName, 
        string Type, 
        DateTime Schedule, 
        decimal Price
    );

    // TODO: add list of courses
    public class Invoice
    {
        [Browsable(false)]
        [Display(AutoGenerateField = false)]
        internal Guid Id { get; set; }   
        public required string InvoiceNumber { get; set; }
        public required string Date { get; set; }
        public required string TotalPrice { get; set; }
        public string Courses { get; set; } = "-";
    }

    private readonly CultureInfo _indo = new("id-ID");

    private List<Invoice> invoices = new();

    List<ColumnDefinition<Invoice>> invoiceColumns = new()
    {
        new ColumnDefinition<Invoice>
        {
            Header = "Invoice Number",
            CellTemplate = invoice => invoice.InvoiceNumber,
            IsSearchable = true
        },
        new ColumnDefinition<Invoice>
        {
            Header = "Date",
            CellTemplate = invoice => invoice.Date,
            IsSearchable = true
        },
        new ColumnDefinition<Invoice>
        {
            Header = "Total Price",
            CellTemplate = invoice => invoice.TotalPrice,
            IsSearchable = false
        },
        new ColumnDefinition<Invoice>
        {
            Header = "Details",
            CellTemplate = invoice => "Details",
            IsSearchable = false,
            IsActionColumn = true,
            ShowDetails = true
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var rows = await Http.GetFromJsonAsync<List<ApiInvoiceDto>>("api/Invoices") ?? new();
        
        invoices = rows
            .OrderByDescending(x => x.CreatedAt)
            .Select(x => new Invoice
            {
                Id              = x.Id,
                InvoiceNumber   = x.InvoiceCode,                              
                Date            = x.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd"),    
                TotalPrice      = string.Format(_indo, "IDR {0:N0}", x.TotalPrice),
                Courses         = "-"
            })
            .ToList();
        
        var detailTasks = invoices.ToDictionary(
            inv => inv.Id,
            inv => Http.GetFromJsonAsync<InvoiceDetailsDto>($"api/Invoices/{inv.Id}/details")
        );

        await Task.WhenAll(detailTasks.Values);

        foreach (var inv in invoices)
        {
            var dto = await detailTasks[inv.Id];
            if (dto?.Items is { Count: > 0 })
            {
                var enUS = new CultureInfo("en-US"); 

                inv.Courses = string.Join(Environment.NewLine,
                    dto.Items.Select((it, idx) =>
                        $"{idx + 1}) {it.CourseName} - {it.Type} - " +
                        $"{it.Schedule.ToLocalTime().ToString("dddd, dd MMM yyyy", enUS)} - " +
                        $"{string.Format(_indo, "IDR {0:N0}", it.Price)}"
                    )
                );
            }
            else
            {
                inv.Courses = "-";
            }
        }
    }

    private Task OnInvoiceDetails(Invoice invoice) => Task.CompletedTask;


    @* private async Task OnInvoiceDetails(Invoice invoice)
    {
        var parameters = new DialogParameters { ["Data"] = invoice };

        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<InvoiceDetailContent>(
            string.Empty,
            parameters,
            options
        );
    } *@
}