@page "/admin/user"
@layout AdminLayout
@using AutomotiveApp.BlazorUI.Helper
@using AutomotiveApp.Shared.Dtos.User
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject IUserService UserService
@inject ISnackbar Snackbar

@* @layout AdminLayout *@

<PageTitle>User Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">User Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" OnClick="ShowAddUserDialog" Class="align-self-start m-2 mb-4"
        Color="Color.Primary" Variant="Variant.Filled">Add User</AppBaseButton>
    <AdminTable TItem="UserViewModel" Items="users" Columns="userColumns" OnEdit="OnUserEdit" Loading="_isLoading" />
</MudPaper>

@code {
    private bool _isLoading { get; set; } = true;
    private List<UserViewModel> users = new();

    List<ColumnDefinition<UserViewModel>> userColumns = new()
{
new ColumnDefinition<UserViewModel> { Header = "Name", CellTemplate = u => u.Name, IsSearchable = true, IsStatusColumn =
false },
new ColumnDefinition<UserViewModel> { Header = "Email", CellTemplate = u => u.Email, IsSearchable = true, IsStatusColumn
= false },
new ColumnDefinition<UserViewModel> { Header = "Phone", CellTemplate = u => u.PhoneNumber ?? "", IsSearchable = false,
IsStatusColumn = false },
new ColumnDefinition<UserViewModel> { Header = "Role", CellTemplate = u => u.Role, IsSearchable = false, IsStatusColumn
= false },
new ColumnDefinition<UserViewModel> { Header = "Status", CellTemplate = u => u.Status, IsSearchable = false,
IsStatusColumn = true },
new ColumnDefinition<UserViewModel> { Header = "Action", CellTemplate = u => "Edit", IsSearchable = false,
IsStatusColumn = false, IsActionColumn = true, ShowEdit = true },
};

    protected override async Task OnInitializedAsync()
    {
        await RetryHelper.ExecuteWithRetryAsync(
        action: () => LoadUsersAsync(),
        onLoadingChanged: (loading) => _isLoading = loading,
        maxAttempts: 5,
        delayMs: 100
        );
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var rows = await UserService.GetAllUsers();
            Console.WriteLine($"rows exist {rows.Any()}");
            if (rows != null)
            {
                users = rows.Select(x => new UserViewModel
                {
                    Id = x.Id,
                    Name = x.UserName,
                    Email = x.Email,
                    PhoneNumber = x.PhoneNumber,
                    Role = RoleMapper(x.Roles),
                    Status = x.Status ? Status.Active : Status.Inactive
                }).ToList();
            }
        }
        catch
        {

        }
    }

    // string list to enum
    private UserRole RoleMapper(List<string> input)
    {
        var role = input.FirstOrDefault() ?? "Buyer";
        if (role.Equals("Admin"))
        {
            return UserRole.Admin;
        }
        return UserRole.Buyer;
    }

    // enum to bool
    private bool StatusMapper(Status input)
    {
        return input == Status.Active;
    }

    private async Task OnUserEdit(UserViewModel user)
    {
        try
        {
            UserUpdateRequestDto? updatedUser = new UserUpdateRequestDto
            {
                UserName = user.Name,
                Email = user.Email,
                PhoneNumber = user.PhoneNumber,
                Role = user.Role.ToString(),
                Status = StatusMapper(user.Status),
            };

            var res = await UserService.UpdateUser(user.Id, updatedUser);
            if (res.Success)
            {
                Snackbar.Add("User updated Successfully", Severity.Success);
                await LoadUsersAsync();
            }
            else
            {
                Console.WriteLine($"update user: {res.Success}, message: {res.Errors?.ToString() ?? ""}");

                Snackbar.Add($"User update failed:\n{string.Join("\n", res.Errors ?? Array.Empty<string>())}", Severity.Error);

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"update Crashed user: {ex.Message}");

            Snackbar.Add($"User update failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowAddUserDialog()
    {
        var dialog = await DialogService.ShowAsync<AddUserDialog>("Add User");
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is UserViewModel user)
        {

            try
            {
                var input = new UserCreateRequestDto
                {
                    UserName = user.Name,
                    Email = user.Email,
                    Password = user.Password,
                    PhoneNumber = user.PhoneNumber,
                    Role = user.Role.ToString(),
                    Status = StatusMapper(user.Status),
                };

                var res = await UserService.CreateUser(input);
                if (res.Success)
                {
                    await LoadUsersAsync();
                    Snackbar.Add("User added Successfully", Severity.Success);
                }
                else
                {
                    Console.WriteLine($"add user: {res.Success}, message: {res.Errors?.ToString() ?? ""}");

                    Snackbar.Add($"User add failed:\n{string.Join("\n", res.Errors ?? Array.Empty<string>())}", Severity.Error);

                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"add user: {ex.Message}");

                Snackbar.Add($"User add failed: {ex.Message}", Severity.Error);
            }
        }
    }
}