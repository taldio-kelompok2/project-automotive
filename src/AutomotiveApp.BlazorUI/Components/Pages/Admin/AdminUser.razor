    {
        new UserViewModel { Email="admin@dlanguage.com", Name="Super Admin", Role=UserRole.Admin, Status=Status.Active},
        new UserViewModel { Email="nurimamiskandar@gmail.com", Name="Nur Imam Iskandar", Role=UserRole.User, Status=Status.Active},
        new UserViewModel { Email="imam.stmik15@gmail.com", Name="Iskandar", Role=UserRole.User, Status=Status.Active},
        new UserViewModel { Email="iniemaildummysaya@gmail.com", Name="Dummy User", Role=UserRole.User, Status=Status.Inactive},
        new UserViewModel { Email="yusrisahrul.works@gmail.com", Name="yusri sahrul", Role=UserRole.User, Status=Status.Active},
        new UserViewModel { Email="yusribootcamp@gmail.com", Name="yusri sahrul test", Role=UserRole.Admin, Status=Status.Active},
        new UserViewModel { Email="adasdasda@gmail.com", Name="yusri test", Role=UserRole.Admin, Status=Status.Active},
        new UserViewModel { Email="asdasd@gmail.com", Name="yusri sahrul test", Role=UserRole.Admin, Status=Status.Active},
        new UserViewModel { Email="dssdsdsd@gmail.com", Name="yusri sahrul test", Role=UserRole.Admin, Status=Status.Active},
        new UserViewModel { Email="dssd6767d@gmail.com", Name="yusri sahrul test", Role=UserRole.Admin, Status=Status.Active},
        new UserViewModel { Email="iniemail@gmail.com", Name="Dummy User", Role=UserRole.User, Status=Status.Inactive},
    };

    List<ColumnDefinition<UserViewModel>> userColumns = new()
    {
        new ColumnDefinition<UserViewModel> { Header = "Name", CellTemplate = u => u.Name, IsSearchable = true, IsStatusColumn = false },
        new ColumnDefinition<UserViewModel> { Header = "Email", CellTemplate = u => u.Email, IsSearchable = true, IsStatusColumn = false },
        new ColumnDefinition<UserViewModel> { Header = "Role", CellTemplate = u => u.Role, IsSearchable = false, IsStatusColumn = false },
        new ColumnDefinition<UserViewModel> { Header = "Status", CellTemplate = u => u.Status, IsSearchable = true, IsStatusColumn = true },
        new ColumnDefinition<UserViewModel> { Header = "Action", CellTemplate = u => "Edit", IsSearchable = false, IsStatusColumn = false, IsActionColumn = true, ShowEdit = true },
    };

    private void OnUserEdit(UserViewModel user)
    {
        var idx = users.FindIndex(c => c.Name == user.Name);
        if (idx >= 0)
        {
            users[idx] = user;
            StateHasChanged();
        }
    }

    private async Task ShowAddUserDialog()
    {
        var dialog = await DialogService.ShowAsync<AddUserDialog>("Add User");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UserViewModel newUser)
        {
            users.Add(newUser);
            StateHasChanged();
        }
    }
}
