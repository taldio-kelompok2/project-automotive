@page "/admin/user"
@using AutomotiveApp.Shared.Dtos.User
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject IUserService UserService

@layout AdminLayout

<PageTitle>User Management</PageTitle>

<MudPaper Class="m-md-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">User Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" OnClick="ShowAddUserDialog" Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add User</AppBaseButton>
    <AdminTable TItem="UserViewModel" Items="users" Columns="userColumns" OnEdit="OnUserEdit" />
</MudPaper>

@code {
    private List<UserViewModel> users = new();

    List<ColumnDefinition<UserViewModel>> userColumns = new()
    {
        new ColumnDefinition<UserViewModel> { Header = "Name", CellTemplate = u => u.Name, IsSearchable = true, IsStatusColumn = false },
        new ColumnDefinition<UserViewModel> { Header = "Email", CellTemplate = u => u.Email, IsSearchable = true, IsStatusColumn = false },
        new ColumnDefinition<UserViewModel> { Header = "Role", CellTemplate = u => u.Role, IsSearchable = false, IsStatusColumn = false },
        new ColumnDefinition<UserViewModel> { Header = "Status", CellTemplate = u => u.Status, IsSearchable = false, IsStatusColumn = true },
        new ColumnDefinition<UserViewModel> { Header = "Action", CellTemplate = u => "Edit", IsSearchable = false, IsStatusColumn = false, IsActionColumn = true, ShowEdit = true },
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        var rows = await UserService.GetAllUsers();
        users = rows.Select(x => new UserViewModel
        {
            Id = x.Id,
            Name = x.UserName,
            Email = x.Email,
            Role = RoleMapper(x.Roles),
            Status = x.Status ? Status.Active : Status.Inactive
        }).ToList();
    }

    // string list to enum
    private UserRole RoleMapper(List<string> input)
    {
        var role = input.FirstOrDefault() ?? "Buyer";
        if (role.Equals("Admin"))
        {
            return UserRole.Admin;
        }
        return UserRole.Buyer;
    }

    // enum to bool
    private bool StatusMapper(Status input)
    {
        if (input == Status.Active)
        {
            return true;
        }
        return false;
    }

    private async Task OnUserEdit(UserViewModel user)
    {
        var updatedUser = new UserUpdateRequestDto // TODO: update mapping
            {
                UserName = user.Name,
                Email = user.Email,
                PhoneNumber = user.PhoneNumber,
                Status = StatusMapper(user.Status),
            };
            Console.WriteLine($"user: {updatedUser.ToString()} and {user.Id.ToString()}");

            var success = await UserService.UpdateUser(user.Id, updatedUser);
            if (success)
                await LoadUsersAsync();
    }

    private async Task ShowAddUserDialog()
    {
        var dialog = await DialogService.ShowAsync<AddUserDialog>("Add User");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UserViewModel user)
        {
            var input = new UserCreateRequestDto
            {
                UserName = user.Name,
                Email = user.Email,
                Password = user.Password,
                PhoneNumber = user.PhoneNumber,
                Role = user.Role.ToString(),
                Status = StatusMapper(user.Status),
            };

            var success = await UserService.CreateUser(input);
            if (success)
                await LoadUsersAsync();
        }
    }

    // private async Task ShowAddUserDialog()
    // {
    //     // var dialog = DialogService.Show<AddUserDialog>("Add User");
    //     // var result = await dialog.Result;

    //     // if (!result.Canceled && result.Data is UserViewModel user)
    //     // {

    //     // }
    // }
}
