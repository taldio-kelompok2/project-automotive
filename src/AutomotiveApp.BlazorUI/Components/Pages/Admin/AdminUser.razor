@page "/admin/user"
@rendermode InteractiveServer

@layout AdminLayout

<PageTitle>User Management</PageTitle>

<MudPaper Class="m-4 d-flex flex-column p-3" Style="min-height: 80vh; background-color: white; ">
    <MudText Typo="Typo.h3" Class="pb-2">User Management</MudText>
    <AppBaseButton Width="ButtonWidth.Short" Class="align-self-start m-2 mb-4" Color="Color.Primary" Variant="Variant.Filled">Add User</AppBaseButton>
    <!-- styling belum selesai -->
    <MudTable Items="@users">
        <HeaderContent>
            <MudTh>Name</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
        </RowTemplate>
    </MudTable>
    <MudSpacer />
</MudPaper>

@code {
    public class User
    {
        public string Email { get; set; }
        public string Name { get; set; }
        public string Role { get; set; }
        public string Status { get; set; }
    }

