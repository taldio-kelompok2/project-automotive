@page "/my-class"
@using AutomotiveApp.BlazorUI.Helper

@inject ICourseBookingService BookingService
@inject NavigationManager Nav

@rendermode InteractiveServer

@* TODO: rename file? *@
<PageTitle>Your Booked Sessions</PageTitle>

@* <AuthorizeRedirect Role="Admin"> *@
<div style="overflow-x:hidden; display:flex; flex-direction:column; min-height: 100vh;">
    <div style="flex:1;">
        <MudGrid Class="m-0 pt-4 pb-4 px-md-5 px-4" Justify="Justify.Center">

            @if (_isLoading)
            {
                <div class="loading-overlay">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">
                        Loading your bookings...
                    </MudText>
                </div>
            }
            else if (bookedSessions.Success)
            {
                @if (bookedSessions.Data?.Any() ?? false)
                {
                    @foreach (var car in bookedSessions.Data)
                    {
                        <ClassScheduleRow Car="car" />
                    }

                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        @* Pagination controls here *@
                    </MudHidden>

                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        @* Pagination controls here *@
                    </MudHidden>
                }
                else
                {
                    <MudText>No booked sessions yet.</MudText>
                }
            }
        </MudGrid>
    </div>
</div>

<Footer />
@* </AuthorizeRedirect> *@

@code {
    [Inject] IJSRuntime JS { get; set; } = default!;

    [CascadingParameter]
    public UserContext UserContext { get; set; } = default!;
    private int _selectedPage = 1;
    private bool _isLoading { get; set; } = true;
    private int pageSize = 5;
    private int pageCount => (int)Math.Ceiling((double)cars.Count() / pageSize);
    private ApiResponse<IEnumerable<CourseBookingQueryDto>> bookedSessions = new();
    private List<CarViewModel> cars = new List<CarViewModel>();
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"🔄 Starting - _isLoading: {_isLoading}");

        await RetryHelper.ExecuteWithRetryAsync(
        action: async () =>
        {
            Console.WriteLine($"🔄 Attempting API call...");
            bookedSessions = await BookingService.GetUserBooking();
            Console.WriteLine($"✅ API call completed - Data: {bookedSessions.Data?.Count() ?? 0} items");
        },
        onLoadingChanged: (loading) =>
        {
            Console.WriteLine($"🔄 Loading changed to: {loading}");
            _isLoading = loading;
            StateHasChanged();
        },
        maxAttempts: 5,
        delayMs: 100
        );

        Console.WriteLine($"🏁 Completed - _isLoading: {_isLoading}, Data: {bookedSessions.Data?.Count() ?? 0} items");
    }

    private async Task OnPageChange(int newPage)
    {
        _selectedPage = newPage;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("scrollToTop");
    }
}