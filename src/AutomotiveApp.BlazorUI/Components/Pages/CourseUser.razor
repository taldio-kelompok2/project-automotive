@page "/my-class"
@using AutomotiveApp.BlazorUI.Helper
@using AutomotiveApp.Shared.Models

@inject ICourseBookingService BookingService
@inject NavigationManager Nav

@rendermode InteractiveServer

@* TODO: rename file? *@
<PageTitle>Your Booked Sessions</PageTitle>

@* <AuthorizeRedirect Role="Admin"> *@
<div style="overflow-x:hidden; display:flex; flex-direction:column; min-height: 100vh;">
    <div style="flex:1;">
        <MudStack Class="m-0" Justify="Justify.Center" AlignItems="AlignItems.Center">

            @if (_isLoading)
            {
                <div class="loading-overlay">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-3">
                        Loading your bookings...
                    </MudText>
                </div>
            }
            else if (bookedSessions.Success)
            {
                @if (bookedSessions.Data?.Items.Any() ?? false)
                {
                    @foreach (var car in bookedSessions.Data.Items)
                    {
                        <ClassScheduleRow Car="car" />
                    }

                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        @if (bookedSessions.Data.TotalCount > _pageSize)
                        {
                            <MudStack Class="my-12 p-0" Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center">
                                <MudPagination Class="pl-0" Count="@totalPages" Selected="@_selectedPage"
                                    SelectedChanged="@OnPageChange" BoundaryCount="5" />
                            </MudStack>
                        }
                    </MudHidden>

                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        @if (bookedSessions.Data.TotalCount > _pageSize)
                        {
                            <MudStack Class="my-12 p-0" Justify="Justify.Center" AlignItems="AlignItems.Center">
                                <MudPagination Class="pl-0" Count="@totalPages" Selected="@_selectedPage"
                                    SelectedChanged="@OnPageChange" BoundaryCount="5" />
                            </MudStack>
                        }
                    </MudHidden>
                }
                else
                {
                    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" style="min-height: 80vh">
                        <MudText>No booked sessions yet.</MudText>
                    </MudStack>
                }
            }
        </MudStack>
    </div>
</div>


<Footer />
@* </AuthorizeRedirect> *@

@code {
    [Inject] IJSRuntime JS { get; set; } = default!;
    private int _selectedPage = 1;
    private bool _isLoading { get; set; } = true;
    private int _pageSize = 3;
    private int totalPages;
    private ApiResponse<PaginatedResult<CourseBookingQueryDto>> bookedSessions = new();
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"🔄 Starting - _isLoading: {_isLoading}");

        await RetryHelper.ExecuteWithRetryAsync(
        action: async () =>
        {
            Console.WriteLine($"🔄 Attempting API call...");
            await LoadBookingsAsync(_selectedPage);
            Console.WriteLine($"✅ API call completed - Data: {bookedSessions.Data?.TotalCount ?? 0} items");
        },
        onLoadingChanged: (loading) =>
        {
            Console.WriteLine($"🔄 Loading changed to: {loading}");
            _isLoading = loading;
            StateHasChanged();
        },
        maxAttempts: 10,
        delayMs: 100
        );

        Console.WriteLine($"🏁 Completed - _isLoading: {_isLoading}, Data: {bookedSessions.Data?.TotalCount ?? 0} items");
    }

    private async Task LoadBookingsAsync(int page)
    {
        _isLoading = true;

        bookedSessions = await BookingService.GetUserBookingPaged(page: _selectedPage, itemTaken: _pageSize);

        if (bookedSessions.Data != null)
            totalPages = (int)Math.Ceiling((double)bookedSessions.Data.TotalCount / _pageSize);

        _isLoading = false;
    }

    private async Task OnPageChange(int newPage)
    {
        _selectedPage = newPage;
        await LoadBookingsAsync(_selectedPage);
        await JS.InvokeVoidAsync("scrollToTop");
    }
}