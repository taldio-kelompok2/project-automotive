@page "/my-class"

@inject ICourseBookingService BookingService
@inject NavigationManager Nav

@rendermode InteractiveServer

@* TODO: rename file? *@
<PageTitle>Your Booked Sessions</PageTitle>

<div style="overflow-x:hidden; display:flex; flex-direction:column; min-height: 100vh;">
    <div style="flex:1;">
        <MudGrid Class="m-0 pt-4 pb-4 px-md-5 px-4" Justify="Justify.Center">

            @if (bookedSessions.Data?.Any() ?? false)
            {
                @foreach (var car in bookedSessions.Data)
                {
                    <ClassScheduleRow Car="car" />
                }

                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    @* Pagination controls here *@
                </MudHidden>

                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    @* Pagination controls here *@
                </MudHidden>
            }
            else
            {
                <MudText>No booked sessions yet.</MudText>
            }
        </MudGrid>
    </div>
</div>

<Footer />

@code {
    [Inject] IJSRuntime JS { get; set; } = default!;

    [CascadingParameter]
    public UserContext UserContext { get; set; } = default!;
    private int _selectedPage = 1;
    private int pageSize = 5;
    private int pageCount => (int)Math.Ceiling((double)cars.Count() / pageSize);
    private ApiResponse<IEnumerable<CourseBookingQueryDto>> bookedSessions = new();
    private List<CarViewModel> cars = new List<CarViewModel>();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ini wajib
            await Task.Delay(100);
            bookedSessions = await BookingService.GetUserBooking();
            StateHasChanged();
        }
    }

    private async Task OnPageChange(int newPage)
    {
        _selectedPage = newPage;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("scrollToTop");
    }
}