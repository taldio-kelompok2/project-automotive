@page "/new-password"

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-5 mx-auto p-0" Style="max-width: 700px; ">
    <MudText Typo="Typo.h5" Class="font-regular mb-5 pb-1">Create Password</MudText>
    <MudStack Spacing="3">
        <MudTextField T="String"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      Placeholder="New Password"
                      Class="m-0"
                      Style="font-size: 0.9rem; height: 35.2px; padding: 0; color:black " />

        <MudTextField T="String"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      Placeholder="Confirm New Password"
                      Class="m-0"
                      Style="font-size: 0.9rem; height: 35.2px; padding: 0; color:black " />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="3" Class="mt-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Cancel" DropShadow="false"
            Class="px-5 py-2" Style="border-width: 1.6px; font-size: 20px; border-radius: 10px; font-weight: 500">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" DropShadow="false"
                       Class="px-5 py-2" Style="font-size: 20px; border-radius: 10px; font-weight: 500">
                Submit
            </MudButton>
        </MudStack>
    </MudStack>
</MudContainer>

@code {
    private void Cancel()
    {
        // Placeholder
    }

    private void Submit()
    {
        // Placeholder
    }
}
