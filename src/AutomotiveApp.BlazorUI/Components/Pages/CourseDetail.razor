@using AutomotiveApp.BlazorUI.Services.Implementation
@using AutomotiveApp.Domain.Entities.Courses
@using AutomotiveApp.Shared.Dtos.Courses
@using AutomotiveApp.Shared.Models
@using AutomotiveApp.Shared.Response
@using MudBlazor 

@page "/course/{id:guid}"
@rendermode InteractiveServer
@inject IRentalCartService Cart
@inject ICourseService CourseService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService Dialog

<PageTitle>Course Detail</PageTitle>

<MudGrid Class="px-0 pt-0 mt-4 mb-2 mx-0 px-lg-5 pt-lg-4 justify-content-center justify-content-lg-start" Spacing="0">
    <MudItem xs="10" sm="10" md="5" lg="5"
        Class="m-0  ms-lg-5 d-flex justify-content-center justify-content-lg-start"
        Style="align-self:center;">
        <!-- Mobile (xs, sm) -->
        <MudImage Src="@chosenCar.Data?.ImageUrl" Class="d-block d-md-none"
            Style="width:100%; object-fit:cover; border:1px solid #BDBDBD;" />

        <!-- Tablet (md only) -->
        <MudImage Src="@chosenCar.Data?.ImageUrl" Class="d-none d-md-block d-lg-none mt-3"
            Style="width:95%; object-fit:cover; border:1px solid #BDBDBD;" />

        <!-- Desktop (lg and up) -->
        <MudImage Src="@chosenCar.Data?.ImageUrl" Class="d-none d-md-block d-lg-block"
            Style="width:90%; object-fit:cover; border:1px solid #BDBDBD;" />
    </MudItem>

    @* have to apply flex on both to work*@
    <MudItem xs="10" md="5" Class="pt-4 p-md-3 p-lg-0 pt-lg-0 d-flex justify-content-center justify-content-md-start"
        Style="flex-grow:1; display:flex; flex-direction:column;">
        <div class="px-0 mx-0" style="flex:1; display:flex; flex-direction:column;">
            <MudText Typo="Typo.h6" Class="p-0" Style="font-weight: 400; color: #828282; font-size: 20px">
                @chosenCar.Data?.Category</MudText>
            <MudText Typo="Typo.h4" Class="pt-2" Style="font-weight: 600;">@chosenCar.Data?.Name</MudText>
            <MudText Typo="Typo.h4" Class="pt-3" Color="Color.Primary" Style="font-weight:600">IDR
                @chosenCar.Data?.Price.ToString("N0")</MudText>

            <!-- schedule dropdown -->
            <MudForm @ref="ScheduleForm">
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudSelect T="Guid?" Class="my-8 pb-8 pb-md-0 select-schedule" 
                        Variant="Variant.Outlined" IconSize="Size.Large"
                        @bind-Value="_selectedSessionId" Required="true"
                        Placeholder="Select schedule" Dense="true" FitContent="true"
                        RequiredError="Please select a schedule">
                        @foreach(var session in Sessions.OrderBy(s => s.Value)) {
                            <MudSelectItem T="Guid?" Value="@(session.Key)">
                            <MudText Typo="Typo.body2">@session.Value.ToString("dddd, dd MMMM yyyy")</MudText>
                        </MudSelectItem>
                        }
                    </MudSelect>
                </MudHidden>

                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudSelect T="Guid?" @bind-Value="_selectedSessionId" Required="true" 
                        Class="my-8 pb-8 pb-md-0 select-schedule" 
                        Variant="Variant.Outlined" IconSize="Size.Large"
                        Placeholder="Select schedule" Dense="true" FitContent="true" FullWidth="true"
                        RequiredError="Please select a schedule">
                        @foreach(var session in Sessions.OrderBy(s => s.Value)) {
                            <MudSelectItem T="Guid?" Value="@(session.Key)">
                            <MudText Typo="Typo.body2">@session.Value.ToString("dddd, dd MMMM yyyy")</MudText>
                        </MudSelectItem>
                        }
                    </MudSelect>
                </MudHidden>
            </MudForm>

        <div class="d-block d-lg-none d-flex justify-content-center" Style="width:100%;margin-top: auto;">
            <MudStack Spacing="2" Class="justify-center w-100">
                <PurchaseButtonGroup Width="ButtonWidth.Medium" AddToCart="@AddToCartHandler" InstantPayment="@InstantPaymentHandler" /> 
            </MudStack>
        </div>
        <div class="d-none d-lg-block" Style=" margin-top: auto;">
            <MudStack Row="true" Spacing="2">
                <PurchaseButtonGroup Width="ButtonWidth.Long" AddToCart="@AddToCartHandler" InstantPayment="@InstantPaymentHandler" /> 
            </MudStack> 
        </div> 
    </div>
    </MudItem>
</MudGrid>

<MudStack Class="mt-12 px-4 px-md-5" Style="border-bottom: 1px solid #E0E0E0;">
    <MudText Typo="Typo.h3" Class="text-black mx-2 px-0 mt-1 pt-2 px-md-4 mx-md-4 pt-md-0" Align="Align.Left"
        Style="font-weight: 600;">Description</MudText>
    <MudText Typo="Typo.subtitle1" Class="text-black mx-0 px-0 pt-2 pb-2 px-md-4 mx-md-4"
        Style="text-align: justify; line-height: 1.3; font-size: 20px ">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
        magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
        consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
        pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est
        laborum.
    </MudText>
    <MudText Typo="Typo.subtitle1" Class="text-black mx-0 px-0 mb-5 pt-2 pb-5 px-md-4 mx-md-4"
        Style="text-align: justify; line-height: 1.5; font-size: 20px; font-family: 'Poppins', sans-serif;">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
        magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
        consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
        pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est
        laborum.
    </MudText>
</MudStack>


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-12 mt-md-16" Style="background-color: white">
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudText Typo="Typo.h3" Align="Align.Center" Color="Color.Primary"
            Class="mt-6 mb-16 pb-4 pt-3 align-content-center" Style="font-weight: 600;">Another favorite course
        </MudText>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary"
            Class="mt-6 mb-10 pb-4 pt-3 align-content-center" Style="font-weight: 600;">Another favorite course
        </MudText>
    </MudHidden>
    <!-- Courses card -->
    <MudGrid Spacing="6" Class="px-2 pb-8 mb-16">
        @foreach (var car in cars.Data?.Items ?? [])
        {
            <MudItem xs="12" sm="6" md="4">
                <CarCard Car="car" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<Footer />

@code {
    [Parameter]
    public Guid Id { get; set; }
    [Parameter]
    public string Name { get; set; } = null!;
    private Guid? _selectedSessionId;
    private MudForm ScheduleForm = null!;
    private ApiResponse<PaginatedResult<CourseQueryDto>> cars = new ();
    private ApiResponse<CourseQueryDetailDto> chosenCar = new();
    private Dictionary<Guid,DateTime> Sessions = []; 
    private RenderFragment SnackbarToCart =>
    @<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body1">
            Added to your cart
        </MudText>
        <AppBaseButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" DisableElevation="true"
            OnClick="GoCheckout">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />
            View Cart
        </AppBaseButton>
    </MudStack>;

    protected override async Task OnInitializedAsync()
    {
        cars = await CourseService.GetPaged(1, 6, true);
        await Cart.GetUserCartData();
    }
    protected override async Task OnParametersSetAsync()
    {
        chosenCar = await CourseService.GetById(Id);
        if(chosenCar.Data == null) {
            Navigation.NavigateTo("error");
            return;
        }
        Sessions = chosenCar.Data.Sessions;  

        Console.WriteLine(Sessions);  
    }

    private async Task AddToCartHandler()
    {
        await ScheduleForm.Validate();

        if (!ScheduleForm.IsValid) return;

        try
        {
            if(_selectedSessionId == null) {
                return;
            }
            await Cart.AddItem(_selectedSessionId.Value);
            Snackbar.Add(SnackbarToCart, Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<bool> OpenDialogAsync()
    {
        if (_selectedSessionId == null)
        {
            Snackbar.Add("Session is not selected.", Severity.Error);
            return false;
        }

        var parameters = new DialogParameters
        {
        };

        var dialog = await Dialog.ShowAsync<TransactionDialog>("Select Payment Method", parameters);
        var result = await dialog.Result;

        if (result!.Canceled || result.Data is not TransactionViewModel transaction)
        {
            Snackbar.Add("Payment was canceled or invalid.", Severity.Warning);
            return false;
        }
        
        try
        {
            await Cart.FinalizeInstantPaymentAsync(_selectedSessionId.Value, transaction.Id);
            return true; // success
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Payment failed: {ex.Message}", Severity.Error);
            return false;
        }
    }

    private async Task InstantPaymentHandler()
    {
        await ScheduleForm.Validate();
        if (!ScheduleForm.IsValid) return;

        try
        {
            var result = await OpenDialogAsync(); // true = payment success, false = failed/canceled

            if (result)
            {
                Snackbar.Add("Payment successful, Redirecting in 2 seconds", Severity.Success,
                    config => config.VisibleStateDuration = 2000);

                await Task.Delay(2000);
                Navigation.NavigateTo("/success-purchase");
            }
            else
            {
                Snackbar.Add("Payment was canceled or failed.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error);
        }
    }



    private void GoCheckout()
    {
        Navigation.NavigateTo(uri: $"checkout");

    }

}