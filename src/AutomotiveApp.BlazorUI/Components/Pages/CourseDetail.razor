@page "/{category}/{name}"
@using MudBlazor
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Course Detail</PageTitle>

<MudGrid Class="px-0 pt-0 mt-4 mb-2 mx-0 px-md-5 pt-md-4 justify-content-center justify-content-md-start" Spacing="0">
    <MudItem xs="10" sm="12" md="5" Class="m-0 ps-md-5 d-flex justify-content-center justify-content-md-start" Style="align-self:center;">
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudImage Src="@chosenCar.Image"
                  Class="responsive-img"
                  Style="width: 90%; object-fit:cover; border: 1px solid #BDBDBD;" />
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudImage Src="@chosenCar.Image"
                      Class="responsive-img"
                      Style="width: 100%; object-fit:cover; border: 1px solid #BDBDBD;" />
        </MudHidden>
    </MudItem>

    <MudItem xs="10" md="5" Class="pt-4 pt-md-0 d-flex justify-content-center justify-content-md-start" Style="flex-grow:1; display:flex; flex-direction:column;">
        <div class="px-0 mx-0" style="flex:1; display:flex; flex-direction:column;">
            @* have to apply flex on both to work*@
            <MudText Typo="Typo.h6" Class="p-0"
                    Style="font-weight: 400; color: #828282; font-size: 20px">@CategoryTitle</MudText>
            <MudText Typo="Typo.h4" Class="pt-2"
                    Style="font-weight: 600;">@chosenCar.Name</MudText>
            <MudText Typo="Typo.h4" Class="pt-3" Color="Color.Primary" 
                    Style="font-weight:600">IDR @chosenCar.Price.ToString("N0")</MudText>
            <MudSelect T="string" Variant="Variant.Outlined" IconSize="Size.Large" @bind-Value="_selectedSchedule"
                        Class="my-8 pb-8 pb-md-0 select-schedule" Dense=true FitContent=true>
                <MudSelectItem Value="DummySchedule">
                    <MudText Typo="Typo.body2" >
                        Wednesday, 27 July 2022
                    </MudText>
                </MudSelectItem>
            </MudSelect>
        <div class="d-block d-lg-none d-flex justify-content-center" Style="width:100%;margin-top: auto;">
            <MudStack Spacing="3" Class="justify-center w-100">
                <AppBaseButton Variant="Variant.Outlined" Color="Color.Primary" Width="ButtonWidth.Medium">
                    <MudText Typo="Typo.body1">Add to Cart</MudText>
                </AppBaseButton>
                <AppBaseButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Width="ButtonWidth.Medium">
                    <MudText Typo="Typo.body1">Buy Now</MudText>
                </AppBaseButton>
            </MudStack>
        </div>
            <div class="d-none d-lg-block" Style=" margin-top: auto;">
            <MudStack Row="true" Spacing="2">
                <AppBaseButton Variant="Variant.Outlined" Color="Color.Primary" Width="ButtonWidth.Long" FullWidth=true Style="border-radius:10px; border-width: 2px !important;">
                    <MudText Typo="Typo.body1" Class="py-1" Style="font-size: 20px;">Add to Cart</MudText>
                </AppBaseButton>
                <AppBaseButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Width="ButtonWidth.Long" FullWidth=true Style="border-radius:10px;">
                        <MudText Typo="Typo.body1" Class="py-1" Style="font-size: 20px">Buy Now</MudText>
                </AppBaseButton>
            </MudStack>
        </div>
    </div>
    </MudItem>
</MudGrid>

<MudStack Class="mt-12 px-4 px-md-5" Style="border-bottom: 1px solid #E0E0E0;">
    <MudText Typo="Typo.h3"
             Class="text-black mx-2 px-0 mt-1 pt-2 px-md-4 mx-md-4 pt-md-0"
             Align="Align.Left"
             Style="font-weight: 600;">Description</MudText>
    <MudText Typo="Typo.subtitle1"
             Class="text-black mx-0 px-0 pt-2 pb-2 px-md-4 mx-md-4"
             Style="text-align: justify; line-height: 1.3; font-size: 20px ">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
    </MudText>
    <MudText Typo="Typo.subtitle1"
             Class="text-black mx-0 px-0 mb-5 pt-2 pb-5 px-md-4 mx-md-4"
             Style="text-align: justify; line-height: 1.5; font-size: 20px; font-family: 'Poppins', sans-serif;">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.  
    </MudText>
</MudStack>


<MudContainer MaxWidth="MaxWidth.Large"
              Class="mt-12 mt-md-16"
              Style="background-color: white">
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudText Typo="Typo.h3"
                 Align="Align.Center"
                 Color="Color.Primary"
                 Class="mt-6 mb-16 pb-4 pt-3 align-content-center"
                 Style="font-weight: 600;">Another favorite course</MudText>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudText Typo="Typo.h4"
                 Align="Align.Center"
                 Color="Color.Primary"
                 Class="mt-6 mb-10 pb-4 pt-3 align-content-center"
                 Style="font-weight: 600;">Another favorite course</MudText>
    </MudHidden>
    <!-- Courses card -->
        <MudGrid Spacing="6" Class="px-2 pb-8 mb-16">
        @foreach (var car in cars)
        {
            <MudItem xs="12" sm="6" md="4">
                <CarCard Car="car" />
            </MudItem>
        }
        </MudGrid>
</MudContainer>

<Footer />

@code {
    [Parameter]
    public string? Category { get; set; }
    [Parameter]
    public string Name { get; set; } = null!;

    public string DummySchedule = "Wednesday, 27 July 2022";
    private string _selectedSchedule = "Select Schedule";

    private List<CarViewModel> allCars = new List<CarViewModel>();
    private List<CarViewModel> cars = new List<CarViewModel>();
    private CarViewModel chosenCar = new CarViewModel();

    private readonly Random _random = new();

    private string CategoryTitle => Category?.ToLower() switch
    {
        "electric" => "Electric",
        "hatchback" => "Hatchback",
        "lcgc" => "LCGC",
        "offroad" => "Offroad",
        "truck" => "Truck",
        "suv" => "SUV",
        "mpv" => "MPV",
        "sedan" => "Sedan",
        _ => "SUV"
    };


    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(200);
        CarViewModel.InitDummyData(allCars);

        // get cars
        if (!string.IsNullOrEmpty(Category))
            cars = allCars
                .Where(c => string.IsNullOrEmpty(Category) ||
                            c.Category.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase))
                .OrderBy(_ => _random.Next())
                .Take(6)
                .ToList();
        else
            cars = allCars;

        // get chosen course
        string normalizedTitle = Name.Replace("-", " ").Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(Name))
        {
            chosenCar = allCars
                .FirstOrDefault(c => c.Name.ToLowerInvariant().Equals(normalizedTitle))
                ?? new CarViewModel { Name = "", Category = CarCategory.Electric, Image = "", Price = 0 };
        }
        else
        {
            // fallback when no title in route
            chosenCar = new CarViewModel { Name = "", Category = CarCategory.Electric, Image = "", Price = 0 };
        }

        if (cars != null && chosenCar != null)
            cars.RemoveAll(c => c.Name.ToLowerInvariant().Equals(normalizedTitle));
    }

    protected override Task OnParametersSetAsync()
    {
        if (allCars is null)
            return Task.CompletedTask;

        // get courses
        if (!string.IsNullOrEmpty(Category))
            cars = allCars
                .Where(c => string.IsNullOrEmpty(Category) ||
                            c.Category.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase))
                .OrderBy(_ => _random.Next())
                .Take(6)
                .ToList();
        else
            cars = allCars;

        string normalizedTitle = Name.Replace("-", " ").Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(Name))
        {
            chosenCar = allCars
                .FirstOrDefault(c => c.Name.ToLowerInvariant().Equals(normalizedTitle))
                ?? new CarViewModel { Name = "", Category = CarCategory.Electric, Image = "", Price = 0 };
        }
        else
        {
            // fallback when no title in route
            chosenCar = new CarViewModel { Name = "", Category = CarCategory.Electric, Image = "", Price = 0 };
        }

        if (cars != null && chosenCar != null)
            cars.RemoveAll(c => c.Name.ToLowerInvariant().Equals(normalizedTitle));

        return Task.CompletedTask;
    }

    private void NavigateToCourseDetail(string courseTitle)
    {
        string normalizedTitle = courseTitle.Replace(" ", "-").ToLowerInvariant();
        Navigation.NavigateTo($"/{Category}/{normalizedTitle}");
    }
}
