@page "/{category}/{name}"
@using MudBlazor
@rendermode InteractiveServer
@inject IRentalCartService Cart
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService Dialog

<PageTitle>Course Detail</PageTitle>

<MudGrid Class="px-0 pt-0 mt-4 mb-2 mx-0 px-lg-5 pt-lg-4 justify-content-center justify-content-lg-start" Spacing="0">
    <MudItem xs="10" sm="10" md="5" lg="6"
        Class="m-0 pb-sm-0 pb-md-0 ps-lg-5 d-flex justify-content-center justify-content-lg-start"
        Style="align-self:center;">
        <!-- Mobile (xs, sm) -->
        <MudImage Src="@chosenCar.Image" Class="d-block d-md-none"
            Style="width:100%; object-fit:cover; border:1px solid #BDBDBD;" />

        @* <!-- Tablet (md only) -->
        <MudImage Src="@chosenCar.Image" Class="d-none d-md-block d-lg-none"
            Style="width:100%; object-fit:cover; border:1px solid #BDBDBD;" /> *@

        <!-- Desktop (lg and up) -->
        <MudImage Src="@chosenCar.Image" Class="d-none d-md-block d-lg-block"
            Style="width:90%; object-fit:cover; border:1px solid #BDBDBD;" />
    </MudItem>

    @* have to apply flex on both to work*@
    <MudItem xs="10" md="5" Class="pt-4 pt-md-0 d-flex justify-content-center justify-content-md-start"
        Style=" display:flex; flex-direction:column;">
        <div class="px-0 mx-0" style="flex:1; display:flex; flex-direction:column;">
            <MudText Typo="Typo.h6" Class="p-0" Style="font-weight: 400; color: #828282; font-size: 20px">
                @CategoryTitle.ToString()</MudText>
            <MudText Typo="Typo.h4" Class="pt-2" Style="font-weight: 600;">@chosenCar.Name</MudText>
            <MudText Typo="Typo.h4" Class="pt-3" Color="Color.Primary" Style="font-weight:600">IDR
                @chosenCar.Price.ToString("N0")</MudText>

            <!-- schedule dropdown -->
            <MudForm @ref="ScheduleForm">
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudSelect T="DateTime ?" Class="my-8 pb-8 pb-md-0 select-schedule" 
                        Variant="Variant.Outlined" IconSize="Size.Large"
                        @bind-Value="_selectedSchedule" Required="true"
                        Placeholder="Select schedule" Dense="true" FitContent="true"
                        RequiredError="Please select a schedule">
                        <MudSelectItem T="DateTime ?" Value="@(new DateTime(2022, 7, 27))">
                            <MudText Typo="Typo.body2">Wednesday, 27 July 2022</MudText>
                        </MudSelectItem>
                        <MudSelectItem T="DateTime ?" Value="@(new DateTime(2022, 7, 29))">
                            <MudText Typo="Typo.body2">Friday, 29 July 2022</MudText>
                        </MudSelectItem>
                    </MudSelect>
                </MudHidden>

                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudSelect T="DateTime ?" @bind-Value="_selectedSchedule" Required="true" 
                        Class="my-8 pb-8 pb-md-0 select-schedule" 
                        Variant="Variant.Outlined" IconSize="Size.Large"
                        Placeholder="Select schedule" Dense="true" FitContent="true" FullWidth="true"
                        RequiredError="Please select a schedule">
                        <MudSelectItem T="DateTime ?" Value="@(new DateTime(2022, 7, 27))">
                            <MudText Typo="Typo.body2">Wednesday, 27 July 2022</MudText>
                        </MudSelectItem>
                        <MudSelectItem T="DateTime ?" Value="@(new DateTime(2022, 7, 29))">
                            <MudText Typo="Typo.body2">Friday, 29 July 2022</MudText>
                        </MudSelectItem>
                    </MudSelect>
                </MudHidden>
            </MudForm>

        <div class="d-block d-lg-none d-flex justify-content-center" Style="width:100%;margin-top: auto;">
            <MudStack Spacing="2" Class="justify-center w-100">
                <PurchaseButtonGroup Width="ButtonWidth.Medium" AddToCart="@AddToCartHandler" InstantPayment="@InstantPaymentHandler" /> 
            </MudStack>
        </div>
        <div class="d-none d-lg-block" Style=" margin-top: auto;">
            <MudStack Row="true" Spacing="2">
                <PurchaseButtonGroup Width="ButtonWidth.Long" AddToCart="@AddToCartHandler" InstantPayment="@InstantPaymentHandler" /> 
            </MudStack> 
        </div> 
    </div>
    </MudItem>
</MudGrid>

<MudStack Class="mt-12 px-4 px-md-5" Style="border-bottom: 1px solid #E0E0E0;">
    <MudText Typo="Typo.h3" Class="text-black mx-2 px-0 mt-1 pt-2 px-md-4 mx-md-4 pt-md-0" Align="Align.Left"
        Style="font-weight: 600;">Description</MudText>
    <MudText Typo="Typo.subtitle1" Class="text-black mx-0 px-0 pt-2 pb-2 px-md-4 mx-md-4"
        Style="text-align: justify; line-height: 1.3; font-size: 20px ">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
        magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
        consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
        pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est
        laborum.
    </MudText>
    <MudText Typo="Typo.subtitle1" Class="text-black mx-0 px-0 mb-5 pt-2 pb-5 px-md-4 mx-md-4"
        Style="text-align: justify; line-height: 1.5; font-size: 20px; font-family: 'Poppins', sans-serif;">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
        magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
        consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
        pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est
        laborum.
    </MudText>
</MudStack>


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-12 mt-md-16" Style="background-color: white">
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudText Typo="Typo.h3" Align="Align.Center" Color="Color.Primary"
            Class="mt-6 mb-16 pb-4 pt-3 align-content-center" Style="font-weight: 600;">Another favorite course
        </MudText>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary"
            Class="mt-6 mb-10 pb-4 pt-3 align-content-center" Style="font-weight: 600;">Another favorite course
        </MudText>
    </MudHidden>
    <!-- Courses card -->
    <MudGrid Spacing="6" Class="px-2 pb-8 mb-16">
        @foreach (var car in cars)
        {
            <MudItem xs="12" sm="6" md="4">
                <CarCard Car="car" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<Footer />

@code {
    [Parameter]
    public string? Category { get; set; }
    [Parameter]
    public string Name { get; set; } = null!;
    private DateTime? _selectedSchedule = null;
    private MudForm ScheduleForm = null!;

    private List<CarViewModel> allCars = new List<CarViewModel>();
    private List<CarViewModel> cars = new List<CarViewModel>();
    private CarViewModel chosenCar = new CarViewModel();
    private readonly Random _random = new();

    private RenderFragment SnackbarToCart =>
    @<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body1">
            Added to your cart
        </MudText>
        <AppBaseButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" DisableElevation="true"
            OnClick="GoCheckout">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />
            View Cart
        </AppBaseButton>
    </MudStack>;

    private CarCategory CategoryTitle => Category?.ToLowerInvariant() switch
    {
        "electric" => CarCategory.Electric,
        "hatchback" => CarCategory.Hatchback,
        "lcgc" => CarCategory.LCGC,
        "offroad" => CarCategory.Offroad,
        "truck" => CarCategory.Truck,
        "suv" => CarCategory.SUV,
        "mpv" => CarCategory.MPV,
        "sedan" => CarCategory.Sedan,
        _ => CarCategory.SUV
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(200);
        allCars = CarViewModel.InitDummyData();
        LoadData();
    }
    protected override Task OnParametersSetAsync()
    {
        if (allCars is not null)
            LoadData();

        return Task.CompletedTask;
    }

    private void LoadData()
    {
        // get cars
        if (!string.IsNullOrEmpty(Category))
            cars = allCars
            .Where(c => string.IsNullOrEmpty(Category) ||
            c.Category.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase))
            .OrderBy(_ => _random.Next())
            .Take(6)
            .ToList();
        else
            cars = allCars;

        // get chosen course
        string normalizedTitle = Name.Replace("-", " ").Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(Name))
        {
            chosenCar = allCars
            .FirstOrDefault(c => c.Name.ToLowerInvariant().Equals(normalizedTitle))
            ?? new CarViewModel { Name = "", Category = CarCategory.Electric, Image = "", Price = 0 };
        }
        else
        {
            chosenCar = new CarViewModel { Name = "Car not found", Category = CarCategory.Electric, Image = "", Price = 0 };
        }

        if (cars != null && chosenCar != null)
            cars.RemoveAll(c => c.Name.ToLowerInvariant().Equals(normalizedTitle));
    }

    private void NavigateToCourseDetail(string courseTitle)
    {
        string normalizedTitle = courseTitle.Replace(" ", "-").ToLowerInvariant();
        Navigation.NavigateTo(uri: $"/{Category}/{normalizedTitle}");
    }

    private async Task AddToCartHandler()
    {
        await ScheduleForm.Validate();

        if (!ScheduleForm.IsValid) return;

        try
        {
            Cart.AddItem(chosenCar, _selectedSchedule);
            Snackbar.Add(SnackbarToCart, Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task InstantPaymentHandler() {
        await ScheduleForm.Validate();
        if (!ScheduleForm.IsValid) return;

        try
        {
            if(!await OpenDialogAsync()) {
                Snackbar.Add("Payment successful, Redirecting in 2 second", Severity.Success,
                config =>
                {
                    config.VisibleStateDuration = 2000;
                });
                await Task.Delay(2000);
                Navigation.NavigateTo("/success-purchase");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<bool> OpenDialogAsync() {
        var parameters = new DialogParameters
        {
            ["OnSubmit"] = EventCallback.Factory.Create<TransactionViewModel>(this, HandleDialogSubmit)
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialogRef = await Dialog.ShowAsync<TransactionDialog>("Select Payment Method", parameters, options);
        var transactionResult = await dialogRef.Result;

        return transactionResult?.Canceled! ?? true;
    }

    private async Task HandleDialogSubmit(TransactionViewModel transaction)
    {
        await Cart.FinalizeInstantPaymentAsync(chosenCar, transaction, _selectedSchedule);
    }

    private void GoCheckout()
    {
        Navigation.NavigateTo(uri: $"checkout");
    }



}