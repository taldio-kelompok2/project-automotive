@rendermode InteractiveServer
@inject NavigationManager NavManager
@page "/register"
@layout AuthLayout

<AuthHeader Title="Lets Join Our Course!" SubTitle="Please Register first" />
<EditForm OnValidSubmit="OnValidSubmit" Model="@_registerModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="2">
        <AuthTextField @bind-Value="_registerModel.Name" For="@(() => _registerModel.Name)" Placeholder="Name" />
        <AuthTextField @bind-Value="_registerModel.Email" For="@(() => _registerModel.Email)" Placeholder="Email" />
        <AuthTextField @bind-Value="_registerModel.Password" For="@(() => _registerModel.Password)"
            Placeholder="Password" Mode="AuthTextMode.Password" />
        <AuthTextField @bind-Value="_registerModel.ConfirmPassword" For="@(() => _registerModel.ConfirmPassword)"
            Placeholder="Confirm Password" Mode="AuthTextMode.ConfirmPassword" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
            Disabled="@(!IsFormFilled())" Class="ml-auto custom-form-button mt-3">
            Sign Up
        </MudButton>
        <div class="d-flex gap-1 justify-content-center p-4">
            <MudText Typo="Typo.body2">
                Have Account?
            </MudText>
            <MudLink OnClick="() => NavManager.NavigateTo(LOGIN_PAGE)" Typo="Typo.body2" Underline="Underline.None"
                Color="Color.Tertiary">Login here
            </MudLink>
        </div>
    </MudStack>
</EditForm>
@* TODO: Remove on Auth Implementation *@
@if (success)
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.body2">Name: @_registerModel.Name</MudText>
            <MudText Typo="Typo.body2">Email: @_registerModel.Email</MudText>
            <MudText Typo="Typo.body2">Password: @_registerModel.Password</MudText>
        </MudCardContent>
    </MudCard>
}

@code {
    private const string LOGIN_PAGE = "/login";
    private RegisterRequestDto _registerModel = new RegisterRequestDto();
    private bool success = false;
    private bool IsFormFilled()
    {
        var props = _registerModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            var value = prop.GetValue(_registerModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }
    private void OnValidSubmit()
    {
        success = true;
        //navigate
    }
}