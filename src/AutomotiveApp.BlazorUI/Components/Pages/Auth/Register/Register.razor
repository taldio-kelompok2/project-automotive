@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IAuthService AuthService

@rendermode InteractiveServer
@layout AuthLayout
@page "/register"
@using AutomotiveApp.BlazorUI.Services.Interface
@using AutomotiveApp.Shared.Dtos.Auth

<AuthHeader Title="Lets Join Our Course!" SubTitle="Please Register first" />
<EditForm OnValidSubmit="OnValidSubmit" Model="@_registerModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="2">
        <AuthTextField @bind-Value="_registerModel.Name" For="@(() => _registerModel.Name)" Placeholder="Name" />
        <AuthTextField @bind-Value="_registerModel.Email" For="@(() => _registerModel.Email)" Placeholder="Email" />
        <AuthTextField @bind-Value="_registerModel.Password" For="@(() => _registerModel.Password)"
            Placeholder="Password" Mode="AuthTextFieldMode.Password" />
        <AuthTextField @bind-Value="_registerModel.ConfirmPassword" For="@(() => _registerModel.ConfirmPassword)"
            Placeholder="Confirm Password" Mode="AuthTextFieldMode.ConfirmPassword" />
        <AppBaseButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
            Disabled="@(!IsFormFilled())" Width="ButtonWidth.Medium" Class="mt-3 ml-auto">
            Sign Up
        </AppBaseButton>
        <div class="d-flex gap-1 justify-content-center p-4">
            <MudText Typo="Typo.body2">
                Have Account?
            </MudText>
            <MudLink OnClick="() => Nav.NavigateTo(LOGIN_PAGE)" Typo="Typo.body2" Underline="Underline.None"
                Color="Color.Tertiary">Login here
            </MudLink>
        </div>
    </MudStack>
</EditForm>

@code {



    private const string LOGIN_PAGE = "/login";
    private RegisterViewModel _registerModel = new RegisterViewModel();

    private bool IsFormFilled()
    {
        var props = _registerModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            var value = prop.GetValue(_registerModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }

    private async Task ShowSuccessDialogAsync(string email)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Registration Successful",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddContent(1, $"We’ve sent a confirmation link to {email}. Please confirm your email before logging in.");
                builder.AddMarkupContent(2, "<br /><br />");
                builder.AddContent(3, "Didn’t receive the email?");
                builder.AddMarkupContent(4, "<br />");
                builder.OpenElement(5, "button");
                builder.AddAttribute(6, "class", "mud-button mud-button-filled mud-button-sm mud-button-primary mt-2 mb-1");
                builder.AddAttribute(7, "onclick", EventCallback.Factory.Create(this, async () =>
                {
                    await ResendConfirmationEmailAsync(email);
                }));
                builder.AddContent(8, "Resend Confirmation Email");
                builder.CloseElement();
                builder.CloseElement();
            })
        };

        var options = new DialogOptions { 
            CloseOnEscapeKey = true,
            BackdropClick = false
        };
        var dialog = await DialogService.ShowAsync<AuthResultDialog>("Success", parameters, options);
        await dialog.Result;
    }

    private async Task ShowErrorDialogAsync(string message)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Register Failed",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddContent(1, message);
                builder.CloseElement();
            })
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = false
        };
        var dialog = await DialogService.ShowAsync<AuthResultDialog>("Error", parameters, options);
        await dialog.Result;
    }

    private async Task ResendConfirmationEmailAsync(string email)
    {
        try
        {
            var request = new SendConfirmEmailRequestDto { Email = email };
            var success = await AuthService.SendConfirmEmailAsync(request);

            if (success)
            {
                await DialogService.ShowMessageBox("Email Sent", $"A new confirmation email has been sent to {email}.", "OK");
            }
            else
            {
                await DialogService.ShowMessageBox("Error", "Failed to resend confirmation email. Please try again later.", "OK");
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBox("Error", $"Something went wrong: {ex.Message}", "OK");
        }
    }

    private async Task OnValidSubmit()
    {
        try
        {
            var request = new RegisterRequestDto
            {
                UserName = _registerModel.Name,
                Email = _registerModel.Email,
                Password = _registerModel.Password,
                ConfirmPassword = _registerModel.ConfirmPassword
            };

            var result = await AuthService.RegisterAsync(request);

            if (result != null)
            {
                await ShowSuccessDialogAsync(_registerModel.Email);
                Nav.NavigateTo("/", forceLoad: true);
            }
            else
            {
                await ShowErrorDialogAsync("Invalid registration data. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await ShowErrorDialogAsync($"Register failed: {ex.Message}");
        }
    }
}