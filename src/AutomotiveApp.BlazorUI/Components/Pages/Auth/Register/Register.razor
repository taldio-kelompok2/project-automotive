@rendermode InteractiveServer

@page "/Register"

<div class="auth-container">
    <div class="auth-title-group">
        <MudText Typo="Typo.h5" Color="Color.Primary">Lets Join Our Course!</MudText>
        <MudText Typo="Typo.body2">Please Register first</MudText>
    </div>
    <EditForm OnValidSubmit="OnValidSubmit" EditContext="@_editContext">
        <DataAnnotationsValidator />
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_registerModel.Name" For="@(() => _registerModel.Name)"
                Variant="Variant.Outlined" Margin="Margin.Dense" placeholder="Name" OnBlur="UpdateFormValidity" />
            <MudTextField @bind-Value="_registerModel.Email" For="@(() => _registerModel.Email)"
                Variant="Variant.Outlined" Margin="Margin.Dense" placeholder="Email" OnBlur="UpdateFormValidity" />
            <MudTextField @bind-Value="_registerModel.Password" For="@(() => _registerModel.Password)"
                Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End"
                InputType="@(_isPasswordVisible? InputType.Text: InputType.Password)"
                AdornmentIcon="@(_isPasswordVisible? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                AdornmentColor="Color.Default" OnAdornmentClick="ViewPassword" IconSize="Size.Small"
                AdornmentAriaLabel="Toggle password visibility" placeholder="Password" OnBlur="UpdateFormValidity" />
            <MudTextField @bind-Value="_registerModel.ConfirmPassword" For="@(() => _registerModel.ConfirmPassword)"
                Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End"
                InputType="@(_isPasswordVisible? InputType.Text: InputType.Password)" placeholder="Confirm Password"
                OnBlur="UpdateFormValidity" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                Disabled="@(!_isFormValid)" Class="ml-auto custom-form-button">
                Sign Up
            </MudButton>
            <div class="d-flex gap-1 justify-content-center p-4">
                <MudText Typo="Typo.body2">
                    Have Account?
                </MudText>
                <MudLink Href="#" Typo="Typo.body2" Underline="Underline.None" Color="Color.Tertiary">Login here
                </MudLink>
            </div>
        </MudStack>
    </EditForm>
    @if (success)
    {
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.body2">Name: @_registerModel.Name</MudText>
                <MudText Typo="Typo.body2">Email: @_registerModel.Email</MudText>
                <MudText Typo="Typo.body2">Password: @_registerModel.Password</MudText>
            </MudCardContent>
        </MudCard>

    }
</div>

@code {
    private EditContext _editContext = null!;
    private RegisterRequestDto _registerModel = new RegisterRequestDto();
    private bool _isPasswordVisible = false;
    private bool _isFormValid = false;
    private bool success = false;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_registerModel);
    }

    private void UpdateFormValidity(FocusEventArgs e)
    {
        _editContext.Validate();
        _isFormValid = !_editContext.GetValidationMessages().Any();
        Console.WriteLine($"Form valid? {_isFormValid}");

        StateHasChanged();
    }

    private void ViewPassword() => _isPasswordVisible = !_isPasswordVisible;
    private void OnValidSubmit()
    {
        success = true;
    }
}