@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IAuthService AuthService

@using AutomotiveApp.Shared.Dtos.Auth
@rendermode InteractiveServer
@layout AuthLayout
@page "/new-password"

<PageTitle>New Password</PageTitle>
<AuthHeader Title="Create Password" Style="AuthHeaderStyle.Black" />
    @if (!_isValidLink)
    {
        <MudText Typo="Typo.h6" Color="Color.Error">Invalid or expired password reset link.</MudText>
    }
    else
    {
<EditForm OnValidSubmit="OnValidSubmit" Model="@_newPassModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="8">
        <MudStack Spacing="2">
            <AuthTextField @bind-Value="_newPassModel.Password" For="@(() => _newPassModel.Password)"
                Placeholder="New Password" Mode="AuthTextFieldMode.Password" />
            <AuthTextField @bind-Value="_newPassModel.ConfirmPassword" For="@(() => _newPassModel.ConfirmPassword)"
                Placeholder="Confirm new Password" Mode="AuthTextFieldMode.ConfirmPassword" />
        </MudStack>
        <div class="d-none d-md-block">
            <MudStack Row="true" Spacing="3" Reverse="true">
                    <AppBaseButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!IsFormFilled() || _isLoading)"
                    Width="ButtonWidth.Medium">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" />
                            <span class="ml-2">Changing password...</span>
                        }
                        else
                        {
                            <span>Confirm</span>
                        }
                    </AppBaseButton>
                    <AppBaseButton ButtonType=" ButtonType.Reset" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_isLoading)"
                    OnClick="@(() => {Nav.NavigateTo(LOGIN_PAGE);})" Width="ButtonWidth.Medium">
                    Cancel
                </AppBaseButton>
            </MudStack>
        </div>
        <div class="d-block d-md-none">
            <MudStack Row="true" Spacing="3" Reverse="true">
            <AppBaseButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!IsFormFilled() || _isLoading)"
                Width="ButtonWidth.Short">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" />
                            <span class="ml-2">Changing password...</span>
                        }
                        else
                        {
                            <span>Confirm</span>
                        }
                    </AppBaseButton>
            <AppBaseButton ButtonType=" ButtonType.Reset" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_isLoading)"
                OnClick="@(() => {Nav.NavigateTo(LOGIN_PAGE);})" Width="ButtonWidth.Short">
                Cancel
            </AppBaseButton>
        </MudStack>
        </div>
    </MudStack>
</EditForm>
}

@code {



    private const string LOGIN_PAGE = "/login";
    private NewPasswordViewModel _newPassModel = new NewPasswordViewModel();
    private bool _isValidLink = false;
    private bool _isLoading = false;
    private string _email = "";
    private string _token = "";

    private bool IsFormFilled()
    {
        var props = _newPassModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            if (prop.PropertyType == typeof(bool))
                continue;

            var value = prop.GetValue(_newPassModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("email", out var email) && query.TryGetValue("token", out var token))
        {
            _email = email!;
            _token = token!;
            _isValidLink = true;
        }
    }

    private async Task OnValidSubmit()
    {
        _isLoading = true;
        try
        {
            if (!_isValidLink)
            {
                await DialogService.ShowMessageBox("Error", "Invalid reset link.", "OK");
                return;
            }

            var request = new ResetPasswordRequestDto
            {
                Email = _email,
                Token = _token,
                NewPassword = _newPassModel.Password,
                ConfirmNewPassword = _newPassModel.ConfirmPassword
            };

            var success = await AuthService.ResetPasswordAsync(request);

            await Task.Delay(1000);
            if (success)
            {
                await ShowSuccessDialogAsync();
                Nav.NavigateTo(LOGIN_PAGE, forceLoad: true);
            }
            else
            {
                await ShowErrorDialogAsync("Could not reset password. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await ShowErrorDialogAsync($"Reset Password failed: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowSuccessDialogAsync()
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Password Changed!",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "style", "overflow: visible; max-height: none; padding: 0.3rem");
                builder.AddContent(2, $"Password has been reset successfully.");
                builder.CloseElement();
            })
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<AuthResultDialog>("Success", parameters, options);

        await dialog.Result;
    }

    private async Task ShowErrorDialogAsync(string message)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Password Reset Failed!",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "style", "overflow: visible; max-height: none; padding: 0.3rem");
                builder.AddContent(2, message);
                builder.CloseElement();
            })
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<AuthResultDialog>("Error", parameters, options);
        await dialog.Result;

    }
}