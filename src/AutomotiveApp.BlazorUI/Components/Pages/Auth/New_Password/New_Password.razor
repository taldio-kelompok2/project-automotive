@inject NavigationManager Nav
@inject IDialogService DialogService

@rendermode InteractiveServer
@layout AuthLayout
@page "/new-password"

<PageTitle>New Password</PageTitle>
<AuthHeader Title="Create Password" Style="AuthHeaderStyle.Black" />
<EditForm OnValidSubmit="OnValidSubmit" Model="@_newPassModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="8">
        <MudStack Spacing="2">
            <AuthTextField @bind-Value="_newPassModel.Password" For="@(() => _newPassModel.Password)"
                Placeholder="New Password" Mode="AuthTextMode.Password" />
            <AuthTextField @bind-Value="_newPassModel.ConfirmPassword" For="@(() => _newPassModel.ConfirmPassword)"
                Placeholder="Confirm new Password" Mode="AuthTextMode.ConfirmPassword" />
        </MudStack>
        <MudStack Row="true" Spacing="4" Reverse="true">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="false"
                Class="custom-form-button">
                Confirm
            </MudButton>
            <MudButton ButtonType=" ButtonType.Reset" Variant="Variant.Outlined" Color="Color.Primary" Disabled="false"
                Class="custom-form-button" OnClick="@(() => {Nav.NavigateTo(LOGIN_PAGE);})">
                Cancel
            </MudButton>
        </MudStack>
    </MudStack>
</EditForm>

@code {
    private const string LOGIN_PAGE = "/login";
    private NewPasswordViewModel _newPassModel = new NewPasswordViewModel();
    private RenderFragment ForgotDialogContent =>
    @<div>
        <MudText Typo=" Typo.body2">New Password: @_newPassModel.Password</MudText>
    </div>;

    private bool IsFormFilled()
    {
        var props = _newPassModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            if (prop.PropertyType == typeof(bool))
                continue;

            var value = prop.GetValue(_newPassModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }

    @* TODO: Remove on Auth Implementation *@
    private async Task OpenDialogAsync(string location)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Reset password Successful",
            ["Content"] = ForgotDialogContent,
            ["Location"] = location
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };

        await DialogService.ShowAsync<AuthResultDialog>("Reset password Successful", parameters, options);
    }

    private async Task OnValidSubmit()
    {
        _newPassModel.Success = true;
        await OpenDialogAsync(LOGIN_PAGE);
    }
}