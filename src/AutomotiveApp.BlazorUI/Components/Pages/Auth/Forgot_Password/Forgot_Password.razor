@inject NavigationManager Nav
@inject IDialogService DialogService

@rendermode InteractiveServer
@layout AuthLayout
@page "/forgot-password"

<PageTitle>Forgot Password</PageTitle>
<AuthHeader Title="Reset Password" SubTitle="Send OTP code to your email address" Style="AuthHeaderStyle.Black" />
<EditForm OnValidSubmit="OnValidSubmit" Model="@_forgotPasswordModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="4">
        <AuthTextField @bind-Value="_forgotPasswordModel.Email" For="@(() => _forgotPasswordModel.Email)"
            Placeholder="Email" />
        <MudStack Row="true" Spacing="4" Reverse="true">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                Disabled="@(!IsFormFilled())" Class="custom-form-button">
                Confirm
            </MudButton>
            <MudButton ButtonType="ButtonType.Reset" Variant="Variant.Outlined" Color="Color.Primary" Disabled="false"
                OnClick=@(() => {Nav.NavigateTo(LOGIN_PAGE);}) Class="custom-form-button">
                Cancel
            </MudButton>
        </MudStack>
    </MudStack>
</EditForm>

@code {
    private const string LOGIN_PAGE = "/login";
    private const string NEW_PASS_PAGE = "/new-password";
    private ForgotPasswordViewModel _forgotPasswordModel = new ForgotPasswordViewModel();
    private RenderFragment ForgotDialogContent =>
    @<div>
        <MudText Typo="Typo.body2">Email: @_forgotPasswordModel.Email</MudText>
    </div>;

    private bool IsFormFilled()
    {
        var props = _forgotPasswordModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            if (prop.PropertyType == typeof(bool))
                continue;

            var value = prop.GetValue(_forgotPasswordModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }

    @* TODO: Remove on Auth Implementation *@
    private async Task OpenDialogAsync(string location)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Reset password Successful",
            ["Content"] = ForgotDialogContent,
            ["Location"] = location
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };

        await DialogService.ShowAsync<AuthResultDialog>("Reset password Successful", parameters, options);
    }

    private async Task OnValidSubmit()
    {
        _forgotPasswordModel.Success = true;
        await OpenDialogAsync(NEW_PASS_PAGE);
    }
}