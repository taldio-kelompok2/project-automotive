@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IAuthService AuthService

@rendermode InteractiveServer
@layout AuthLayout
@page "/forgot-password"
@using AutomotiveApp.BlazorUI.Services.Interface
@using AutomotiveApp.Shared.Dtos.Auth

<PageTitle>Forgot Password</PageTitle>
<AuthHeader Title="Reset Password" SubTitle="Send reset link to your email address" Style="AuthHeaderStyle.Black" />
<EditForm OnValidSubmit="OnValidSubmit" Model="@_forgotPasswordModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="4">
        <AuthTextField @bind-Value="_forgotPasswordModel.Email" For="@(() => _forgotPasswordModel.Email)"
            Placeholder="Email" />
            <div class="d-none d-md-block">
                <MudStack Row="true" Spacing="3" Reverse="true">
                    <AppBaseButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                        Disabled="@(!IsFormFilled() || _isLoading)" Width="ButtonWidth.Medium">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" />
                            <span class="ml-2">Sending email...</span>
                        }
                        else
                        {
                            <span>Confirm</span>
                        }
                    </AppBaseButton>
                    <AppBaseButton ButtonType="ButtonType.Reset" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_isLoading)"
                        OnClick=@(() => {Nav.NavigateTo(LOGIN_PAGE);}) Width="ButtonWidth.Medium">
                        Cancel
                    </AppBaseButton>
                </MudStack>
            </div>
            <div class="d-block d-md-none">
                <MudStack Row="true" Spacing="3" Reverse="true">
                    <AppBaseButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                        Disabled="@(!IsFormFilled() || _isLoading)" Width="ButtonWidth.Short">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" />
                            <span class="ml-2">Sending email...</span>
                        }
                        else
                        {
                            <span>Confirm</span>
                        }
                    </AppBaseButton>
                    <AppBaseButton ButtonType="ButtonType.Reset" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_isLoading)"
                        OnClick=@(() => {Nav.NavigateTo(LOGIN_PAGE);}) Width="ButtonWidth.Short">
                        Cancel
                    </AppBaseButton>
                </MudStack>
            </div>
    </MudStack>
</EditForm>

@code {
    private const string LOGIN_PAGE = "/login";
    private readonly ForgotPasswordViewModel _forgotPasswordModel = new ForgotPasswordViewModel();
    private bool _isLoading = false;

    private bool IsFormFilled()
    {
        var props = _forgotPasswordModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            if (prop.PropertyType == typeof(bool))
                continue;

            var value = prop.GetValue(_forgotPasswordModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }

    private async Task ShowSuccessDialogAsync()
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Email Sent!",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "style", "overflow: visible; max-height: none; padding: 0.3rem");
                builder.AddContent(2, $"Check your email to reset your password!");
                builder.CloseElement();
            })
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<AuthResultDialog>("Success", parameters, options);

        await dialog.Result;
    }

    private async Task ShowErrorDialogAsync(string message)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Email Failed!",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "style", "overflow: visible; max-height: none; padding: 0.3rem");
                builder.AddContent(2, message);
                builder.CloseElement();
            })
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<AuthResultDialog>("Error", parameters, options);
        await dialog.Result;

    }

    private async Task OnValidSubmit()
    {
        _isLoading = true;
        try
        {
            var request = new ForgotPasswordRequestDto
            {
                Email = _forgotPasswordModel.Email
            };

            var success = await AuthService.ForgotPasswordAsync(request);

            if (success)
            {
                await ShowSuccessDialogAsync();
                Nav.NavigateTo(LOGIN_PAGE, forceLoad: true);
            }
            else
            {
                await ShowErrorDialogAsync("Failed to send reset link. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await ShowErrorDialogAsync($"Forgot Password failed: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}