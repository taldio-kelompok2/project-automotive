@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject UserContextService UserContext

@rendermode InteractiveServer
@layout AuthLayout
@page "/login"
@using AutomotiveApp.BlazorUI.Services.Interface
@using AutomotiveApp.Shared.Dtos.Auth
@using System.Text.Json
@using System.Text

<AuthHeader Title="Welcome Back!" SubTitle="Please login first" />
<EditForm OnValidSubmit="OnValidSubmit" Model="@_loginModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="2">
        <AuthTextField @bind-Value="_loginModel.Email" For="@(() => _loginModel.Email)" Placeholder="Email" />
        <AuthTextField @bind-Value="_loginModel.Password" For="@(() => _loginModel.Password)" Placeholder="Password"
            Mode="AuthTextFieldMode.Password" />
        <div class="d-flex gap-1 mt-2">
            <MudText Typo="Typo.body2" Color="Color.Secondary">Forgot Password?</MudText>
            <MudLink OnClick="() => Nav.NavigateTo(FORGOT_PASSWORD_PAGE)" Typo="Typo.body2" Underline="Underline.None"
                Color="Color.Tertiary">Click here
            </MudLink>
        </div>

        <AppBaseButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
            Disabled="@(!IsFormFilled() || _isLoading)" Width="ButtonWidth.Medium" Class="ml-auto">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" />
                <span class="ml-2">Logging in...</span>
            }
            else
            {
                <span>Login</span>
            }
        </AppBaseButton>
        <div class="d-flex gap-1 justify-content-center p-4">
            <MudText Typo="Typo.body2">
                Dont Have An Account?
            </MudText>
            <MudLink OnClick="() => Nav.NavigateTo(REGISTER_PAGE)" Typo="Typo.body2" Underline="Underline.None"
                Color="Color.Tertiary">Click here
            </MudLink>
        </div>
    </MudStack>
</EditForm>

@code {

    [Parameter] public string? ReturnUrl { get; set; }
    private const string FORGOT_PASSWORD_PAGE = "/forgot-password";
    private const string HOME_PAGE = "/";
    private const string REGISTER_PAGE = "/register";
    private LoginViewModel _loginModel = new LoginViewModel();
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"User State: {UserContext.Current.IsAuthenticated}");
        if (UserContext.Current.IsAuthenticated == true)
        {
            var redirect = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
            Nav.NavigateTo(redirect, forceLoad: true);
            return;
        }
    }

    private bool IsFormFilled()
    {
        var props = _loginModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            var value = prop.GetValue(_loginModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }

    private async Task ShowSuccessDialogAsync()
    {
        var redirect = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
        var parameters = new DialogParameters
        {
            ["Title"] = "Login Successful",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "style", "overflow: visible; max-height: none; padding: 0.3rem");
                builder.AddContent(2, $"Welcome back, {_loginModel.Email}!");
                builder.CloseElement();
            }),
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        await DialogService.ShowAsync<AuthResultDialog>("Success", parameters, options);
    }

    private async Task ShowErrorDialogAsync(string message)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Login Failed",
            ["Content"] = (RenderFragment)(builder =>
            {
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "style", "overflow: visible; max-height: none; padding: 0.3rem");
                builder.AddContent(2, message);
                builder.CloseElement();
            })
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        await DialogService.ShowAsync<AuthResultDialog>("Error", parameters, options);
    }

    private async Task<bool> ShowConfirmEmailDialogAsync(string message)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialogRef = await DialogService.ShowAsync<ConfirmEmailDialog>("Login Failed", options);
        var result = await dialogRef.Result;

        return !result.Canceled && result.Data is bool confirmed && confirmed;
    }

    private async Task OnValidSubmit()
    {
        _isLoading = true;
        try
        {
            // Call the proxy login via JS fetch
            var res = await AuthService.LoginViaProxyAsync(_loginModel.Email, _loginModel.Password);

            if (res.Success)
            {
                await ShowSuccessDialogAsync();
                await Task.Delay(1500);
                var redirect = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
                Nav.NavigateTo(redirect, forceLoad: true);
            }
            else
            {
                if (res.Status == 401)
                {
                    bool wantsToConfirm = await ShowConfirmEmailDialogAsync(res.Message);

                    if (wantsToConfirm)
                    {
                        var emailEncoded = Uri.EscapeDataString(_loginModel.Email);
                        Nav.NavigateTo($"/resend-email?email={emailEncoded}");
                    }
                }
                else
                {
                    await ShowErrorDialogAsync(res.Message);
                }

            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}