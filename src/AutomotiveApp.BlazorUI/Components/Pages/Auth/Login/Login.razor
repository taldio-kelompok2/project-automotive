@inject NavigationManager NavManager
@rendermode InteractiveServer

@page "/login"
@layout AuthLayout

<AuthHeader Title="Welcome Back!" SubTitle="Please login first" />
<EditForm OnValidSubmit="OnValidSubmit" Model="@_loginModel">
    <DataAnnotationsValidator />
    <MudStack Spacing="2">
        <AuthTextField @bind-Value="_loginModel.Email" For="@(() => _loginModel.Email)" Placeholder="Email" />
        <AuthTextField @bind-Value="_loginModel.Password" For="@(() => _loginModel.Password)" Placeholder="Password"
            Mode="AuthTextMode.Password" />
        <div class="d-flex gap-1 mt-2">
            <MudText Typo="Typo.body2" Color="Color.Secondary">Forgot Password?</MudText>
            <MudLink OnClick="() => NavManager.NavigateTo(FORGOT_PASSWORD_PAGE)" Typo="Typo.body2"
                Underline="Underline.None" Color="Color.Tertiary">Click here
            </MudLink>
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
            Disabled="@(!IsFormFilled())" Class="ml-auto custom-form-button">
            Login
        </MudButton>
        <div class="d-flex gap-1 justify-content-center p-4">
            <MudText Typo="Typo.body2">
                Dont Have An Account?
            </MudText>
            <MudLink OnClick="() => NavManager.NavigateTo(REGISTER_PAGE)" Typo="Typo.body2" Underline="Underline.None"
                Color="Color.Tertiary">Click here
            </MudLink>
        </div>
    </MudStack>
</EditForm>

@* TODO: Remove on Auth Implementation *@

@if (success)
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.body2">Name: @_loginModel.Email</MudText>
            <MudText Typo="Typo.body2">Password: @_loginModel.Password</MudText>
        </MudCardContent>
    </MudCard>

}
@code {
    private const string FORGOT_PASSWORD_PAGE = "/forgot-password";
    private const string REGISTER_PAGE = "/register";
    private LoginRequestDto _loginModel = new LoginRequestDto();
    private bool success = false;
    private bool IsFormFilled()
    {
        var props = _loginModel.GetType()
        .GetProperties(BindingFlags.Public | BindingFlags.Instance);

        foreach (var prop in props)
        {
            var value = prop.GetValue(_loginModel);
            if (value == null || string.IsNullOrWhiteSpace(value.ToString())) return false;
        }

        return true;
    }
    private void OnValidSubmit()
    {
        success = true;
        //navigate
    }
}