@page "/resend-email"
@using AutomotiveApp.Shared.Dtos.Auth
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer
@layout AuthLayout

<PageTitle>Resend Email Verification</PageTitle>

<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3">
    <MudImage Src="Images/verify_email.svg" Alt="verify email" Elevation="0" Width="200" Height="200"
        Class="rounded-lg" />

    <div class="text-center d-flex flex-column gap-4">
        <MudText Typo="Typo.h4" Color="Color.Primary">Verify Your Account</MudText>
        <MudText Typo="Typo.body2">
            We've sent a verification link to <b>@Email</b>. Please check your inbox to complete the registration
            process.
        </MudText>
    </div>

    <AppBaseButton Width="ButtonWidth.Medium" Class="my-3 p-3" Variant="Variant.Filled" Color="Color.Primary"
        @onclick="ResendVerificationEmail" Disabled="@(IsLoading || Countdown > 0)">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (IsLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                <MudText>Sending...</MudText>
            }
            else if (Countdown > 0)
            {
                <MudText>Resend in @Countdown s</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                <MudText>Resend Verification Email</MudText>
            }
        </MudStack>
    </AppBaseButton>

    <MudText Typo="Typo.body2" Class="mt-1 text-center">
        Already verified your account?
        <MudLink OnClick="() => Nav.NavigateTo(LOGIN_PAGE)" Typo="Typo.body2" Underline="Underline.None"
            Color="Color.Primary">
            Login here
        </MudLink>
    </MudText>
</MudStack>

@code {
    private const string LOGIN_PAGE = "/login";
    private string Email { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = false;
    private int Countdown { get; set; } = 0;
    private Timer? _countdownTimer;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("email", out var email))
        {
            Email = email.FirstOrDefault() ?? string.Empty;
        }
    }

    private async Task ResendVerificationEmail()
    {
        if (Countdown > 0) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            await ResendConfirmationEmailAsync(Email);
            Snackbar.Add("Verification email sent! Please check your inbox.", Severity.Success);

            // Start 15-second countdown only on success
            StartCountdown(15);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to send email: {ex.Message}", Severity.Error);
            // Don't start countdown on failure - stay on page without cooldown
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void StartCountdown(int seconds)
    {
        Countdown = seconds;
        _countdownTimer?.Dispose();
        _countdownTimer = new Timer(async _ =>
        {
            Countdown--;
            if (Countdown <= 0)
            {
                _countdownTimer?.Dispose();
                _countdownTimer = null;
            }
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private async Task ResendConfirmationEmailAsync(string email)
    {
        try
        {
            var request = new SendConfirmEmailRequestDto { Email = email };
            var success = await AuthService.SendConfirmEmailAsync(request);

            if (!success)
            {
                throw new HttpRequestException("Failed to resend confirmation email. Please try again later.");
            }
        }
        catch (Exception ex)
        {
            throw new InvalidOperationException($"Something went wrong: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _countdownTimer?.Dispose();
    }
}