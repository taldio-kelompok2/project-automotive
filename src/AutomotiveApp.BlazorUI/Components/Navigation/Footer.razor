@rendermode InteractiveServer

@inject NavigationManager Nav

<footer class="footer">
    <MudStack Spacing="1">
        <MudText Typo="Typo.body1" Color="Color.Primary">About Us</MudText>
        <div class="footer-text">
            We are a trusted driving school dedicated to preparing drivers who are not only skilled but also disciplined on the road. With a strong track record and positive testimonials, we aim to deliver the best driving education experience for all learners.
        </div>
    </MudStack>

    <MudStack Spacing="1">
        <MudText Typo="Typo.body1" Color="Color.Primary">Product</MudText>
        <div class="footer-text">
            @* <ul>
                <li>Electric</li>
                <li>Hatchback</li>
                <li>LCGC</li>
                <li>MPV</li>
                <li>Offroad</li>
                <li>Sedan</li>
                <li>SUV</li>
                <li>Truck</li>
            </ul> *@

            <ul class="footer-text">
                <li @onclick='@(() => GoToCategory("electric"))' role="button" tabindex="0">Electric</li>
                <li @onclick='@(() => GoToCategory("hatchback"))' role="button" tabindex="0">Hatchback</li>
                <li @onclick='@(() => GoToCategory("lcgc"))' role="button" tabindex="0">LCGC</li>
                <li @onclick='@(() => GoToCategory("mpv"))' role="button" tabindex="0">MPV</li>
                <li @onclick='@(() => GoToCategory("offroad"))' role="button" tabindex="0">Offroad</li>
                <li @onclick='@(() => GoToCategory("sedan"))' role="button" tabindex="0">Sedan</li>
                <li @onclick='@(() => GoToCategory("suv"))' role="button" tabindex="0">SUV</li>
                <li @onclick='@(() => GoToCategory("truck"))' role="button" tabindex="0">Truck</li>
            </ul>

        </div>
    </MudStack>

    <MudStack>
        <MudStack Spacing="1">
            <MudText Typo="Typo.body1" Color="Color.Primary">Address</MudText>
            <div class="footer-text">
                1234 Learning Road, Training City, Education State, 56789
            </div>
        </MudStack>
        <MudStack Spacing="1">
            <MudText Typo="Typo.body1" Color="Color.Primary">Contact Us</MudText>
            <div class="d-flex align-items-center justify-content-start gap-3">
                <!-- Phone -->
                <MudIconButton class="footer-icons" Icon="@Icons.Material.Outlined.Phone" Title="Telephone Number"
                    Href="tel:+1234567890" />

                <!-- Instagram -->
                <MudIconButton class="footer-icons" Icon="@Icons.Custom.Brands.Instagram" Title="Instagram"
                    Href="https://instagram.com/yourpage" Target="_blank" />

                <!-- YouTube -->
                <MudIconButton class="footer-icons" Icon="@Icons.Custom.Brands.YouTube" Title="YouTube"
                    Href="https://youtube.com/yourchannel" Target="_blank" />

                <!-- Telegram -->
                <MudIconButton class="footer-icons" Icon="@Icons.Custom.Brands.Telegram" Title="Telegram"
                    Href="https://t.me/yourchannel" Target="_blank" />

                <!-- Email -->
                <MudIconButton class="footer-icons" Icon="@Icons.Material.Outlined.Email" Title="Email"
                    Href="mailto:youremail@example.com" />
            </div>
        </MudStack>
    </MudStack>
</footer>


@code {
    private void GoToCategory(string category)
        => Nav.NavigateTo($"/courses/{category.ToLowerInvariant()}");
}
