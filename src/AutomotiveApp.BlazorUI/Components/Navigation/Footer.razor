@rendermode InteractiveServer
@using AutomotiveApp.Shared.Dtos.Courses
@inject NavigationManager Nav
@inject ICourseCategoryService CategorySvc

@inject NavigationManager Nav

<footer class="footer">
    <MudStack Spacing="1">
        <MudText Typo="Typo.body1" Color="Color.Primary">About Us</MudText>
        <div class="footer-text">
            We are a trusted driving school dedicated to preparing drivers who are not only skilled but also disciplined on the road. With a strong track record and positive testimonials, we aim to deliver the best driving education experience for all learners.
        </div>
    </MudStack>

    <MudStack Spacing="1">
        <MudText Typo="Typo.body1" Color="Color.Primary">Product</MudText>
        <div>
            <ul class="footer-text">
                @if (visibleCats.Count == 0)
                {
                    <li>-</li>
                }
                else
                {
                    @foreach (var c in visibleCats)
                    {
                        <li @onclick="() => GoToCategory(c.Id)" role="button" tabindex="0">@c.Name</li>
                    }
                }
            </ul>
        </div>
    </MudStack>

    <MudStack>
        <MudStack Spacing="1">
            <MudText Typo="Typo.body1" Color="Color.Primary">Address</MudText>
            <div class="footer-text">
                1234 Learning Road, Training City, Education State, 56789
            </div>
        </MudStack>
        <MudStack Spacing="1">
            <MudText Typo="Typo.body1" Color="Color.Primary">Contact Us</MudText>
            <div class="d-flex align-items-center justify-content-start gap-3">
                <!-- Phone -->
                <MudIconButton class="footer-icons" Icon="@Icons.Material.Outlined.Phone" title="Telephone Number"
                    Href="tel:+1234567890" />

                <!-- Instagram -->
                <MudIconButton class="footer-icons" Icon="@Icons.Custom.Brands.Instagram" title="Instagram"
                    Href="https://instagram.com/yourpage" Target="_blank" />

                <!-- YouTube -->
                <MudIconButton class="footer-icons" Icon="@Icons.Custom.Brands.YouTube" title="YouTube"
                    Href="https://youtube.com/yourchannel" Target="_blank" />

                <!-- Telegram -->
                <MudIconButton class="footer-icons" Icon="@Icons.Custom.Brands.Telegram" title="Telegram"
                    Href="https://t.me/yourchannel" Target="_blank" />

                <!-- Email -->
                <MudIconButton class="footer-icons" Icon="@Icons.Material.Outlined.Email" title="Email"
                    Href="mailto:youremail@example.com" />
            </div>
        </MudStack>
    </MudStack>
</footer>

@code {
    @* private List<string> categories = Enum.GetNames(typeof(CarCategory)).ToList();

    private void GoToCategory(string category)
        => Nav.NavigateTo($"/course/{category.ToLowerInvariant()}"); *@
    
    private List<(Guid Id, string Name)> allCats = new();
    // yang ditampilkan (random & berganti)
    private List<(Guid Id, string Name)> visibleCats = new();

    private readonly Random _rnd = new();
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        // data kategori dari API
        var res = await CategorySvc.GetAllAsync();
        foreach (var c in res.OrderByDescending(x => x.CreatedAt))
        {
            var name = string.IsNullOrWhiteSpace(c.Name) ? "-" : c.Name!;
            allCats.Add((c.Id, name));
        }

        // fallback
        if (allCats.Count == 0)
        {
            visibleCats = new() { (Guid.Empty, "Course") };
            return;
        }

        PickRandomVisible();
        StateHasChanged();

        // auto random 15 detik 
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = StartRotateAsync(_cts.Token);
    }

    private async Task StartRotateAsync(CancellationToken token)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(token))
            {
                PickRandomVisible();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* dispose */ }
    }

    private void PickRandomVisible()
    {
        // get data 8 random
        int take = Math.Min(8, allCats.Count);
        visibleCats = allCats.OrderBy(_ => _rnd.Next()).Take(take).ToList();
    }

    private void GoToCategory(Guid id)
        => Nav.NavigateTo($"/course-category/{id}");

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync(); 
            _cts.Dispose();
        }

        _timer?.Dispose();
    }

}
