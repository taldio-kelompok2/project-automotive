@* @inject NavigationManager NavManager *@
@rendermode InteractiveServer

<MudAppBar Elevation="2" Color="Color.Primary" Fixed=true style="height:55px;">
    <MudText Typo="Typo.h6">Dashboard</MudText>
</MudAppBar>

<MudDrawer @bind-Open="_drawerOpen"
           Anchor="Anchor.Left"
           Variant="DrawerVariant.Mini"
           Elevation="2"
           Class="d-flex">
    <MudNavMenu>
        <div class="d-flex justify-content-end mb-3" style="border-bottom: 1px solid #828282; height: 55px;">
            <MudIconButton OnClick="@ToggleDrawer" Icon="@(_drawerOpen? Icons.Material.Filled.KeyboardArrowLeft : Icons.Material.Filled.KeyboardArrowRight)" />
        </div>
        @* TODO: implement navigation manager *@
        <MudNavLink Href="/admin" Icon="@Icons.Material.Filled.Dashboard" >Dashboard</MudNavLink>
        <MudNavLink Href="/admin/user" Icon="@Icons.Material.Filled.AccountBox" >User</MudNavLink>
        <MudNavLink Href="/admin/course" Icon="@Icons.Material.Filled.DirectionsCar" >Course</MudNavLink>
        <MudNavLink Href="/admin/category" Icon="@Icons.Material.Outlined.Category" >Category</MudNavLink>
        <MudNavLink Href="/admin/payment-method" Icon="@Icons.Material.Filled.AccountBalanceWallet" >Payment Method</MudNavLink>
        <MudNavLink Href="/admin/invoice" Icon="@Icons.Material.Filled.Article" >Invoice</MudNavLink>    
    </MudNavMenu>
    <MudSpacer />
    <MudNavMenu Class="mb-3">
        <MudNavLink Href="/logout" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    private bool _drawerOpen = true;

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    // TODO: implement navigation manager
}
