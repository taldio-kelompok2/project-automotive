@inject NavigationManager Nav
@rendermode InteractiveServer

<MudAppBar class="py-2 px-4" Fixed="false" Elevation="0" Dense="true">
    <img class="logo" src="icons/main.svg" @onclick="() => Nav.NavigateTo(LANDING_PAGE)" style="cursor: pointer;" />
    <MudText Typo="Typo.h6" @onclick="() => Nav.NavigateTo(LANDING_PAGE)" style="cursor: pointer;">
        Otomobil
    </MudText>
    <MudSpacer />
    <div class="d-none d-md-flex">
        <div class="d-flex gap-2">
            <AppBaseButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                OnClick="@(() => Nav.NavigateTo(REGISTER_PAGE))">Sign Up
            </AppBaseButton>
            <AppBaseButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo(LOGIN_PAGE))">
                Login
            </AppBaseButton>
        </div>
    </div>
    <div class="d-md-none position-relative">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.End"
            OnClick="@(() => expandMenu = !expandMenu)" />

        @if (expandMenu)
        {
            <div class="mobile-dropdown-menu">
                <AppBaseButton Variant="Variant.Text" Color="Color.Primary" Class="px-0"
                    OnClick="@(() => {Nav.NavigateTo(REGISTER_PAGE);})">Sign Up
                </AppBaseButton>
                <AppBaseButton Variant="Variant.Text" Color="Color.Primary" Class="px-0"
                    OnClick="@(() => {Nav.NavigateTo(LOGIN_PAGE);})">Login
                </AppBaseButton>
            </div>
        }
    </div>
</MudAppBar>

@code {
    private bool expandMenu = false;
    private const string LOGIN_PAGE = "/login";
    private const string REGISTER_PAGE = "/register";
    private const string LANDING_PAGE = "/";
}