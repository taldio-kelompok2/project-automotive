@inject NavigationManager NavManager
@rendermode InteractiveServer

<MudAppBar class="py-2 px-4" Fixed="false" Elevation="0" Dense="true">
    <img class="logo" src="icons/main.svg" />
    <MudText Typo="Typo.h6">Otomobil</MudText>
    <MudSpacer />
    <div class="d-none d-md-flex">
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                OnClick="@(() => NavManager.NavigateTo(REGISTER_PAGE))">Sign Up
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                OnClick="@(() => NavManager.NavigateTo(LOGIN_PAGE))">Login
            </MudButton>
        </div>
    </div>
    <div class="d-md-none position-relative">
        <div class="position-relative d-inline">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.End"
                OnClick="@(() => expandMenu = !expandMenu)" />

            @if (expandMenu)
            {
                <div class="dropdown-menu show mt-2">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                        OnClick="@(() => NavManager.NavigateTo(REGISTER_PAGE))">
                        Sign Up
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                        OnClick="@(() => NavManager.NavigateTo(LOGIN_PAGE))">
                        Login
                    </MudButton>
                </div>
            }
        </div>
    </div>
</MudAppBar>

@code {
    private bool expandMenu = false;
    private const string LOGIN_PAGE = "/login";
    private const string REGISTER_PAGE = "/register";
}