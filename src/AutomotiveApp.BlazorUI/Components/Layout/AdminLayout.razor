@inherits LayoutComponentBase
@inject UserContextService UserContext
@inject NavigationManager Nav
@layout MainLayout

@if (UserContext.Current?.IsAuthenticated == true && UserContext.Current.Role == "Admin")
{
    <MudLayout Style="background-color: var(--mud-palette-surface); min-height: 100vh;" Class="pb-3">
        <AdminNavBar />
        <MudMainContent Class="p-0">
            <div style="padding-top: 55px;">
                @Body
            </div>
        </MudMainContent>
    </MudLayout>
}
@code {
    protected override void OnInitialized()
    {
        if (UserContext.Current.Role != "Admin")
        {
            Nav.NavigateTo("/notFound", true);
        }
    }
}