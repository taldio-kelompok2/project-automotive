@using AutomotiveApp.BlazorUI.Models.Auth.Context
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject NavigationManager Nav
@inject IRentalCartService Cart
@inject AuthenticationStateProvider AuthStateProvider
@inject UserContextService UserContext

@inject IAuthService AuthService

@inherits LayoutComponentBase
<CascadingAuthenticationState>
    @if (_isAdminSection)
    {
        <!-- Admin Layout -->
        <MudLayout Style="background-color: var(--mud-palette-surface); min-height: 100vh;" Class="pb-3">
            <MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
            <MudPopoverProvider />
            <MudDialogProvider @rendermode="InteractiveServer" />
            <MudSnackbarProvider />

            <AdminNavBar />

            <MudMainContent Class="p-0">
                <div style="padding-top: 55px;">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    }
    else
    {
        <!-- Regular Layout -->
        <MudLayout>
            <MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
            <MudPopoverProvider />
            <MudDialogProvider @rendermode="InteractiveServer" />
            <MudSnackbarProvider />

            @if (!_hideNavbar)
            {
                <AuthorizeView>
                    <Authorized>
                        <UserNavbar />
                    </Authorized>
                    <NotAuthorized>
                        <GuestNavbar />
                    </NotAuthorized>
                </AuthorizeView>
            }

            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    }
</CascadingAuthenticationState>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new AppTheme();
    private Timer? _refreshTimer;

    private bool _isDarkMode = false;
    private bool _hideNavbar = false;
    private bool _isAdminSection = false;

    [CascadingParameter]
    private RouteData? CurrentRoute { get; set; }

    private readonly string[] _noNavbarPages =
    {
        "/email-confirmed",
        "/success-purchase"
    };

    private readonly string[] _protectedPages = new[]
    {
        "/checkout",
        "/profile",
        "/my-class"
    };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += async (_, __) =>
        {
            await CheckProtectedPage();
            UpdateNavbarVisibility();
        };


        // Listen for authentication state changes
        AuthStateProvider.AuthenticationStateChanged += async (task) =>
        {
            var state = await task;
            StateHasChanged();
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await ((CustomAuthStateProvider)AuthStateProvider).TryRefreshSessionAsync();
        await AuthStateProvider.GetAuthenticationStateAsync();

        // Initial checks
        await CheckProtectedPage();
        UpdateNavbarVisibility();

        _refreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
    {
        try
        {
            await ((CustomAuthStateProvider)AuthStateProvider).TryRefreshSessionAsync();
        }
        catch { /* Ignore errors */ }
    });
        }, null, TimeSpan.FromMinutes(0.5), TimeSpan.FromMinutes(0.5));
    }

    private void UpdateNavbarVisibility()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).ToLower();
        _hideNavbar = _noNavbarPages.Any(p => uri.Contains(p));

        StateHasChanged();
    }

    private async Task CheckProtectedPage()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).ToLower();
        _isAdminSection = uri.StartsWith("admin");

        if (_isAdminSection)
        {
            if (!UserContext.Current.IsAuthenticated)
            {
                Console.WriteLine("🚫 No access token, redirecting to login");
                Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", forceLoad: true);
                return;
            }

            if (UserContext.Current.Role != "Admin")
            {
                Console.WriteLine("🚫 Non-admin tried accessing admin route, redirecting");
                Nav.NavigateTo("/profile", forceLoad: true); // nanti ganti ke 404
                return;
            }
        }

        if (_protectedPages.Any(p => uri.StartsWith(p.TrimStart('/'))))
        {
            var hasUserContextAuth = UserContext.Current.IsAuthenticated;

            // Redirect only if NO access token found
            if (!hasUserContextAuth)
            {
                Console.WriteLine("🚫 No access token, redirecting to login");
                Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", forceLoad: true);
                return;
            }
            else
            {
                Console.WriteLine("✅ Access token found, allowing access");
            }
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}