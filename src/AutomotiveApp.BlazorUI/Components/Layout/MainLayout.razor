@using AutomotiveApp.BlazorUI.Models.Auth.Context
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject NavigationManager Nav
@inject IRentalCartService Cart
@inject AuthenticationStateProvider AuthStateProvider
@inject UserContextService UserContext
@inject IAuthService AuthService

@inherits LayoutComponentBase
<CascadingAuthenticationState>
    <MudLayout>
        <MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
        <MudPopoverProvider />
        <MudDialogProvider @rendermode="InteractiveServer" />
        <MudSnackbarProvider />

        @if (!_hideNavbar)
        {
            <AuthorizeView>
                <Authorized>
                    <UserNavbar />
                </Authorized>
                <NotAuthorized>
                    <GuestNavbar />
                </NotAuthorized>
            </AuthorizeView>
        }

        <MudMainContent>
            @Body
        </MudMainContent>
    </MudLayout>
</CascadingAuthenticationState>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new AppTheme();

    private bool _isDarkMode = false;
    private bool _hideNavbar = false;

    private readonly string[] _noNavbarPages =
    {
"/admin/",
"/email-confirmed",
"/success-purchase",
};

    private readonly string[] _protectedPages = new[]
    {
"/checkout",
"/profile",
"/my-class"
};

    protected override async Task OnInitializedAsync()
    {
        UpdateNavbarVisibility();

        Nav.LocationChanged += OnLocationChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _lastAuthState = authState.User.Identity?.IsAuthenticated ?? false;

        // Subscribe to changes
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        StateHasChanged();
    }

    private bool _lastAuthState = false;

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var state = await task;
            var isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;

            // Only update if auth state actually changed
            if (isAuthenticated != _lastAuthState)
            {
                Console.WriteLine($"Auth state changed: {_lastAuthState} → {isAuthenticated}");
                _lastAuthState = isAuthenticated;

                // Update critical UI immediately
                UpdateNavbarVisibility();

                // Full re-render after a tiny delay
                await Task.Delay(50);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in auth state change: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var success = await ((CustomAuthStateProvider)AuthStateProvider).TryRefreshSessionAsync();
        if (!success)
            await AuthStateProvider.GetAuthenticationStateAsync();

        // Initial checks
        await CheckProtectedPage();
        await StartRefreshTimer();
    }

    private void UpdateNavbarVisibility()
    {
        var currentUri = Nav.Uri.ToLower();
        _hideNavbar = _noNavbarPages.Any(path =>
        Nav.Uri.Contains(path, StringComparison.OrdinalIgnoreCase));
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateNavbarVisibility();
    }

    private async Task CheckProtectedPage()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).ToLower();

        if (_protectedPages.Any(p => uri.StartsWith(p.TrimStart('/'))))
        {
            var hasUserContextAuth = UserContext.Current.IsAuthenticated;

            // Redirect only if NO access token found
            if (!hasUserContextAuth)
            {
                Console.WriteLine("🚫 No access token, redirecting to login");
                Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", forceLoad: true);
            }
            else
            {
                Console.WriteLine("✅ Access token found, allowing access");
            }
        }
    }

    private async Task StartRefreshTimer()
    {
        _ = Task.Run(async () =>
        {
            while (true)
            {
                var delay = CalculateHalfExpiryTime();
                await Task.Delay(delay);

                try
                {
                    await ((CustomAuthStateProvider)AuthStateProvider).TryRefreshSessionAsync();
                }
                catch { /* Ignore errors */ }
            }
        });

        // Return immediately without waiting for the infinite loop
        await Task.CompletedTask;
    }
    private TimeSpan CalculateHalfExpiryTime()
    {
        if (UserContext.Current.ExpiresAtUtc == null)
            return TimeSpan.FromMinutes(5);

        var now = DateTime.UtcNow;
        var expiry = UserContext.Current.ExpiresAtUtc.Value;

        if (now >= expiry)
            return TimeSpan.Zero;

        var totalDuration = expiry - now;
        var halfDuration = TimeSpan.FromMinutes(totalDuration.TotalMinutes / 2);

        return halfDuration;
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}