@inject NavigationManager Nav
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization

<MudLayout>
    <MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider @rendermode="InteractiveServer" />
    <MudSnackbarProvider />
    @if (_hideNavbar)
    {
        <BlankNavbar />
    }
    else
    {
        @if (_isAuthenticated)
        {
            <UserNavbar />
        }
        else
        {
            <GuestNavbar />
        }
    }

    <MudMainContent Class="p-0">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new AppTheme();
    private bool _isDarkMode = false;
    private bool _isAuthenticated = false;
    private bool _hideNavbar = false;

    private readonly string[] _noNavbarPages = new[]
    {
"/email-confirmed",
"/success-purchase"
};


    protected override async Task OnInitializedAsync()
    {
        // Track route changes
        Nav.LocationChanged += (_, __) => UpdateNavbarVisibility();

        // Initial navbar visibility
        UpdateNavbarVisibility();

        // Determine initial auth state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        // Listen for authentication state changes
        AuthStateProvider.AuthenticationStateChanged += async (task) =>
        {
            var state = await task;
            _isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;
            StateHasChanged();
        };
    }

    private void UpdateNavbarVisibility()
    {
        var currentUri = Nav.Uri.ToLower();
        _hideNavbar = _noNavbarPages.Any(page => currentUri.Contains(page));
        StateHasChanged();
    }
}