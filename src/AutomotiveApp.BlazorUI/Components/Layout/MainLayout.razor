@using AutomotiveApp.BlazorUI.Models.Auth.Context
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject IRentalCartService Cart
@inject AuthenticationStateProvider AuthStateProvider
@inherits LayoutComponentBase

<MudLayout>
    <MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider @rendermode="InteractiveServer" />
    <MudSnackbarProvider />

    <CascadingValue Value="_userContext">
        @if (_hideNavbar)
        {
            <BlankNavbar />
        }
        else
        {
            <AuthorizeView>
                <Authorized>
                    <UserNavbar />
                </Authorized>
                <NotAuthorized>
                    <GuestNavbar />
                </NotAuthorized>
            </AuthorizeView>
        }

        <MudMainContent Class="p-0">
            @Body
        </MudMainContent>
    </CascadingValue>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new AppTheme();
    private bool _isDarkMode = false;
    private UserContext _userContext = new();
    private bool _hideNavbar = false;

    private readonly string[] _noNavbarPages = 
    {
        "/email-confirmed",
        "/success-purchase"
    };


    protected override async Task OnInitializedAsync()
    {
        // Track route changes
        Nav.LocationChanged += (_, __) => UpdateNavbarVisibility();

        // Initial navbar visibility
        UpdateNavbarVisibility();

        // Listen for authentication state changes
        AuthStateProvider.AuthenticationStateChanged += async (task) =>
        {
            var state = await task;
            _userContext = _userContext.Update(state.User);
            StateHasChanged();
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // refresh token
            await ((CustomAuthStateProvider)AuthStateProvider).TryRefreshSessionAsync();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _userContext = _userContext.Update(user);

            StateHasChanged();
        }
    }

    private void UpdateNavbarVisibility()
    {
        var currentUri = Nav.Uri.ToLower();
        _hideNavbar = _noNavbarPages.Any(page => currentUri.Contains(page));
        StateHasChanged();
    }
}