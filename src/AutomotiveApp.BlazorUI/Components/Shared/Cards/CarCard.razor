@using AutomotiveApp.Shared.Dtos.Courses
@rendermode InteractiveServer

@inject NavigationManager Nav

<div class="card card-car" @onclick="() => NavigateToCourseDetail(Car.Id)">
    <img src=@Car.ImageUrl class="car-card-img-top">
    <div class="card-body card-car-body">
        <div class="d-flex flex-column gap-1">
            <div class="card-car-category">
                <MudText Typo="Typo.body2" class="fw-light" Color="Color.Secondary">@(Car.Category ?? "Unknown")
                </MudText>
            </div>
            <div class="card-car-title">@Car.Name</div>
        </div>
        <div class="card-car-price">
            @Car.Price.ToString("C0", new CultureInfo("id-ID")).Replace("Rp", "IDR ")
        </div>
    </div>
</div>


@code {
    [Parameter] public CourseQueryDto Car { get; set; } = null!;

    private void NavigateToCourseDetail(Guid CourseId)
    {
        Nav.NavigateTo($"/course/{CourseId}");
    }
}