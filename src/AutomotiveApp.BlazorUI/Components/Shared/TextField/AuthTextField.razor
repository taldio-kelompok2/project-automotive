<MudTextField T="string" Value="Value" ValueChanged="EventCallback.Factory.Create<string>(this, OnValueChanged)"
    For="@For" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="@Placeholder" InputType="@GetInputType()"
    Adornment="@GetAdornmentPlacement()" AdornmentColor="Color.Secondary" AdornmentIcon="@GetAdornmentIcon()"
    OnAdornmentClick="@OnAdornmentClick" IconSize="Size.Small" />

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? For { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public AuthTextMode Mode { get; set; } = AuthTextMode.Text;

    private bool _isPasswordVisible;

    private Task OnValueChanged(string newValue)
    {
        Value = newValue;
        return ValueChanged.InvokeAsync(newValue); // -> update to the parent model
    }

    private InputType GetInputType()
    {
        if (Mode == AuthTextMode.Password)
        {
            if (_isPasswordVisible) return InputType.Text;
            return InputType.Password;
        }

        if (Mode == AuthTextMode.ConfirmPassword) return InputType.Password;

        return InputType.Text;
    }

    private Adornment GetAdornmentPlacement()
    {
        if (Mode == AuthTextMode.Password) return Adornment.End;

        return Adornment.None;

    }

    private string? GetAdornmentIcon()
    {
        if (Mode == AuthTextMode.Password)
        {
            if (_isPasswordVisible) return Icons.Material.Filled.Visibility;
            return Icons.Material.Filled.VisibilityOff;
        }
        return null;
    }

    private void OnAdornmentClick() => _isPasswordVisible = !_isPasswordVisible;
}