@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public EventCallback<TransactionViewModel> OnSubmit { get; set; }

    private List<TransactionViewModel> transactions = new();
    private TransactionViewModel? SelectedTransaction;

    protected override async Task OnInitializedAsync()
    {
        var rows = await PaymentSvc.GetAllAsync();

        transactions = new List<TransactionViewModel>();

        foreach (var x in rows.Where(r => r.Status)) // Active
        {
            Enum.TryParse<TransactionCategory>(x.Name, ignoreCase: true, out var cat);

            transactions.Add(new TransactionViewModel
            {
                Id       = x.Id,
                Name     = x.Name,                                         
                Image    = string.IsNullOrWhiteSpace(x.ImageUrl) 
                            ? "/images/payment/default.svg" 
                            : x.ImageUrl,
                Category = cat                                          
            });
        }

        Cart.OnLoadingChanged += StateHasChanged;
    }

    public void Dispose() => Cart.OnLoadingChanged -= StateHasChanged;

    private async Task HandleOnSubmit()
    {
        if (SelectedTransaction is null)
        {
            Snackbar.Add("Please select a payment method.", Severity.Warning);
            return;
        }

        await OnSubmit.InvokeAsync(SelectedTransaction);
        MudDialog.Close(DialogResult.Ok(SelectedTransaction));
    }

    private void Cancel() => MudDialog.Cancel();
}
