@using Enums

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string" Label="Email" @bind-Value="User.Email" Required="true" />
            <MudTextField T="string" Label="Name"  @bind-Value="User.Name"  Required="true" />

            <MudSelect T="UserRole" Label="Role" @bind-Value="User.Role" Required="true">
                <MudSelectItem Value="UserRole.User">User</MudSelectItem>
                <MudSelectItem Value="UserRole.Admin">Admin</MudSelectItem>
            </MudSelect>

            <MudSelect T="Status" Label="Status" @bind-Value="User.Status" Required="true">
                <MudSelectItem Value="Status.Active">Active</MudSelectItem>
                <MudSelectItem Value="Status.Inactive">Inactive</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public UserViewModel Item { get; set; } = default!;

    private MudForm _form = default!;
    private UserViewModel User = new();

    protected override void OnInitialized()
    {
        // clone so we don’t mutate the parent until Save
        User = new UserViewModel
        {
            Email = Item.Email,
            Name  = Item.Name,
            Role  = Item.Role,
            Status = Item.Status
        };
    }

    private async Task Save()
    {
        await _form.Validate();
        if (_form.IsValid)
            MudDialog.Close(DialogResult.Ok(User));
    }

    private void Cancel() => MudDialog.Cancel();
}
