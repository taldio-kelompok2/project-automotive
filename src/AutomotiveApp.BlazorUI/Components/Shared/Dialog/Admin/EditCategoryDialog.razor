@using AutomotiveApp.Shared.Enums
@using AutomotiveApp.BlazorUI.Models.Admin
@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_vm.Name" Label="Category Name" Required="true" Class="mb-2" />
            <MudTextField @bind-Value="_vm.Description" Label="Description" Required="true" Class="mb-3" />

            <MudItem Class="my-3">
                <MudText Typo="Typo.body2" Class="mb-1">Image:</MudText>
                <InputFile OnChange="OnFileSelected" />
                @if (!string.IsNullOrWhiteSpace(_vm.Logo))
                {
                    <MudText Typo="Typo.body2" Class="mt-1">Current: @_vm.Logo</MudText>
                }
            </MudItem>

            <MudItem Class="my-3">
                <MudText Typo="Typo.body2" Class="mb-1">Hero:</MudText>
                <InputFile OnChange="OnHeroSelected" />
                @if (!string.IsNullOrWhiteSpace(_vm.Hero))
                {
                    <MudText Typo="Typo.body2" Class="mt-1">Current: @_vm.Hero</MudText>
                }
            </MudItem>

            @* <MudSelect T="Status" @bind-Value="_vm.Status" Label="Status" Required="true">
                <MudSelectItem Value="Status.Active">Active</MudSelectItem>
                <MudSelectItem Value="Status.Inactive">Inactive</MudSelectItem>
            </MudSelect> *@

        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CategoryViewModel? Item { get; set; }

    private CategoryViewModel _vm = new();
    private MudForm _form = default!;
        
    protected override void OnInitialized()
    {
        if (Item is not null)
        {
            _vm = new CategoryViewModel
            {
                ID          = Item.ID,
                CategoryId  = Item.CategoryId,
                Name        = Item.Name,
                Description = Item.Description,
                Logo        = Item.Logo,
                Hero        = Item.Hero,
                Status      = Item.Status
            };
        }
    }

    private async Task Save()
    {
        await _form.Validate();
        if (_form.IsValid)
            MudDialog.Close(DialogResult.Ok(_vm));
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is not null)
            _vm.File = file;
    }

    private void OnHeroSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is not null)
            _vm.HeroFile = file;
    }

    @* protected override void OnInitialized()
    {
        if (Item != null)
        {
            _category = new CategoryViewModel
            {
                Name = Item.Name,
                Status = Item.Status
            };
        }
    } *@

    @* private async Task Save()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(_category));
        }
    } *@
}
