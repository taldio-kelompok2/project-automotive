<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_category.Name" Label="Category Name" Required="true" Class="mb-2" />
            <MudSelect T="Status" @bind-Value="_category.Status" Label="Status" Required="true">
                <MudSelectItem Value="Status.Active">Active</MudSelectItem>
                <MudSelectItem Value="Status.Inactive">Inactive</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CategoryViewModel? Item { get; set; }

    private CategoryViewModel _category = new();
    private MudForm _form = default!;

    protected override void OnInitialized()
    {
        if (Item != null)
        {
            _category = new CategoryViewModel
            {
                Name = Item.Name,
                Status = Item.Status
            };
        }
    }

    private async Task Save()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(_category));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
