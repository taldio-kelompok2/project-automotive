<MudDialog>
    <TitleContent>
        @Title
    </TitleContent>
    <DialogContent>
        <MudText Class="py-1" Typo="Typo.body1">@Content</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Title { get; set; } = null!;
    [Parameter] public RenderFragment? Content { get; set; }
    [Inject] public NavigationManager Nav { get; set; } = null!;
    [Parameter] public string Location { get; set; } = null!;
    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(Location))
        {
            MudDialog.Close(DialogResult.Ok(result: Location));
            Nav.NavigateTo(Location);
        }
        else MudDialog.Close(DialogResult.Ok(result: false));
    }
}