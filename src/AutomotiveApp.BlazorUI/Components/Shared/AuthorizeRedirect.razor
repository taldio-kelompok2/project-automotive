@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.ExtraSmall"
              Class="d-flex flex-column align-center justify-center"
              Style="min-height: 80vh;">
@if (!_checked)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else if (!_authorized)
{

    <MudText Typo="Typo.h3" Class="mb-4" Color="Color.Primary">Page not found!</MudText>
    <MudText Typo="Typo.h6" Color="Color.Error">Redirecting to login...</MudText>
}
else if (!_roleAuthorized)
{
    <MudText Typo="Typo.h6" Color="Color.Error">
        You do not have permission to access this page.
    </MudText>
}
else
{
    @ChildContent
}
</MudContainer>


@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Role { get; set; }

    private bool _authorized;
    private bool _roleAuthorized;
    private bool _checked;
    private bool _shouldRedirect;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _authorized = user.Identity?.IsAuthenticated ?? false;
        _roleAuthorized = string.IsNullOrWhiteSpace(Role) || user.IsInRole(Role);

        if (!_authorized)
            _shouldRedirect = true;

        _checked = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_authorized && _shouldRedirect)
        {
            _shouldRedirect = false;
            await Task.Delay(2500); 
            NavManager.NavigateTo("/login", forceLoad: true);
        }
    }
}
