@typeparam TItem
@inject IDialogService DialogService

<MudPaper Class="w-100 p-2 mb-3">
<MudTextField @bind-Value="SearchText" 
              Placeholder="Search..." 
              Adornment="Adornment.Start" 
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true"
              OnKeyUp="@(e => ApplySearch())" />
</MudPaper>

<div class="responsive-table">
<MudTable Items="FilteredItems" Hover="true" Dense=true Striped=true
          Style="background-color: white;">
    <HeaderContent>
        @foreach (var column in Columns) 
        {
            <!-- TODO: change styling -->
            <MudTh Class="text-center py-3" Style="background-color: #FFA896;">@column.Header</MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        @foreach (var column in Columns)
        {
            <MudTd Class="text-center" DataLabel="@column.Header" s>
                @if (column.IsStatusColumn)
                {
                    <MudChip T="string" Color="@(GetStatusColor(context))" 
                             Variant="Variant.Filled" 
                             Size="Size.Small">
                        @column.CellTemplate(context)
                    </MudChip>
                }
                else if (column.IsActionColumn)
                {
                    @if (column.ShowDetails)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       OnClick="@(() => OnDetailsClick(context))"
                                       Title="Details" />
                    }

                    @if (column.ShowEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       OnClick="@(() => OnEditClick(context))"
                                       Title="Edit" />
                    }
                }
                else if (column.IsImageColumn)
                {
                    var imageUrl = column.CellTemplate(context)?.ToString();
                    @if (!string.IsNullOrEmpty(imageUrl))
                    {
                        
                            <MudImage Src="@imageUrl" Height="30" Class="p-1" />
                        
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Inherit" />
                    }
                }
                else
                {
                    @column.CellTemplate(context)
                }
            </MudTd>
        }
    </RowTemplate>
    <PagerContent>
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudTablePager HidePageNumber=true HideRowsPerPage />
        </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudTablePager />
            </MudHidden>
    </PagerContent>
</MudTable>
</div>

@code {
    [Parameter] public required IEnumerable<TItem> Items { get; set; }
    [Parameter] public required List<ColumnDefinition<TItem>> Columns { get; set; }
    [Parameter] public EventCallback<TItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TItem> OnDetails { get; set; }


    private string SearchText { get; set; } = "";
    private IEnumerable<TItem> FilteredItems { get; set; } = new List<TItem>();

    protected override void OnParametersSet()
    {
        // Reset when Items change
        ApplySearch();
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            FilteredItems = Items;
            return;
        }

        FilteredItems = Items.Where(item =>
            Columns.Where(c => c.IsSearchable)
                   .Any(c => (c.CellTemplate(item)?.ToString() ?? "")
                        .Contains(SearchText, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private Color GetStatusColor(TItem item)
    {
        var status = item switch
        {
            UserViewModel u => u.Status,
            CourseViewModel c => c.Status,
            CategoryViewModel ca => ca.Status,
            _ => default
        };

        return status switch
        {
            Status.Active => Color.Success,
            Status.Inactive => Color.Error,
            _ => Color.Default
        };
    }

    private async Task OnEditClick(TItem item)
    {
        DialogParameters parameters = new() { ["Item"] = item };
        
        IDialogReference? dialog = item switch
        {
            UserViewModel u => await DialogService.ShowAsync<EditUserDialog>("Edit User", parameters),
            CategoryViewModel ca => await DialogService.ShowAsync<EditCategoryDialog>("Edit Category", parameters),
            CourseViewModel co => await DialogService.ShowAsync<EditCourseDialog>("Edit Course", parameters),
            PaymentMethodViewModel p => await DialogService.ShowAsync<EditPaymentDialog>("Edit Payment Method", parameters),
            _ => null
        };

        if (dialog is null)
            return;

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var castedResult = (TItem)result.Data!;
            await OnEdit.InvokeAsync(castedResult);
        }
    }

    private async Task OnDetailsClick(TItem item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var dialog = await DialogService.ShowAsync<DetailsDashboardDialog<TItem>>("Item Details", parameters);
        await dialog.Result; // just wait for close
    }
}